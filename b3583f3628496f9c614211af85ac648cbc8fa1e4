      "message": "Let\u0027s add more tests and coverage. The more complex state tests should be in the `updater_test.cc` file. Here is code generated by Gemini. Review for correctness and coverage:\n\n\n---\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n\n#include \"cli.h\"\n\n#include \u003cgmock/gmock.h\u003e\n#include \u003cgtest/gtest.h\u003e\n\n#include \u003carray\u003e\n#include \u003ccstring\u003e\n#include \u003cfilesystem\u003e\n#include \u003cfstream\u003e\n#include \u003cspan\u003e\n#include \u003cstring_view\u003e\n#include \u003cvector\u003e\n\n#include \"mock_usb_transport.h\"\n#include \"updater.h\"\n#include \"usb_device.h\"\n\nusing namespace std::chrono_literals;\nusing ::testing::_;\nusing ::testing::Invoke;\nusing ::testing::Return;\n\nconstexpr size_t kUsbCbwSize \u003d 31;\nconstexpr size_t kUsbCswSize \u003d 13;\n\n// FocalTech EC \u0026 Bootloader Command Constants\nconstexpr size_t kEcCmdSize \u003d 8;\nconstexpr size_t kEcResponseHeaderSize \u003d 8;\nconstexpr size_t kFlashWpBufferSize \u003d 512;\n\n// Helper: Create a UsbDevice with a given mock transport\nstatic UsbDevice MakeDevice(std::unique_ptr\u003cMockUsbTransport\u003e transport) {\n  return UsbDevice(std::move(transport));\n}\n\n// RAII: Automatically deletes the test firmware file when the test finishes\nclass ScopedTempFile {\n public:\n  explicit ScopedTempFile(std::span\u003cconst uint8_t\u003e data) {\n    path_ \u003d std::filesystem::temp_directory_path() / \"test_fw.bin\";\n    std::ofstream ofs(path_, std::ios::binary);\n    ofs.write(reinterpret_cast\u003cconst char*\u003e(data.data()), data.size());\n  }\n  ~ScopedTempFile() { std::filesystem::remove(path_); }\n  std::string path() const { return path_.string(); }\n\n private:\n  std::filesystem::path path_;\n};\n\n// Helper: Generate dummy firmware with valid magic numbers\nstatic std::vector\u003cuint8_t\u003e MakeFirmware() {\n  FtConfigPage config{.code_valid_control_word \u003d 0x3AEC3721,\n                      .code_start_address \u003d 0x10081000};\n  std::vector\u003cuint8_t\u003e fw_data(sizeof(FtConfigPage) + 128, 0x00);\n  std::memcpy(fw_data.data(), \u0026config, sizeof(config));\n  return fw_data;\n}\n\n// -----------------------------------------------------------------------------\n// ParseArguments Tests\n// -----------------------------------------------------------------------------\nTEST(CliTest, ParseArguments_UpdateCommand) {\n  std::vector\u003cstd::string_view\u003e args \u003d {\"firmware.bin\"};\n  auto config \u003d ParseArguments(args);\n  ASSERT_TRUE(config.has_value());\n  EXPECT_EQ(config-\u003ecmd, Command::kUpdate);\n  EXPECT_EQ(config-\u003eec_bin, \"firmware.bin\");\n}\n\nTEST(CliTest, ParseArguments_EnterBootloader) {\n  std::vector\u003cstd::string_view\u003e args \u003d {\"enter_bootloader\"};\n  auto config \u003d ParseArguments(args);\n  ASSERT_TRUE(config.has_value());\n  EXPECT_EQ(config-\u003ecmd, Command::kEnterBoot);\n}\n\nTEST(CliTest, ParseArguments_SetFlashWp_Valid) {\n  std::vector\u003cstd::string_view\u003e args \u003d {\"flash_set_protect\", \"3\"};\n  auto config \u003d ParseArguments(args);\n  ASSERT_TRUE(config.has_value());\n  EXPECT_EQ(config-\u003ecmd, Command::kSetFlashWp);\n  EXPECT_EQ(config-\u003eaction_param, 3);\n}\n\nTEST(CliTest, ParseArguments_UnknownCommand) {\n  std::vector\u003cstd::string_view\u003e args \u003d {\"unknown\"};\n  EXPECT_FALSE(ParseArguments(args).has_value());\n}\n\n// -----------------------------------------------------------------------------\n// DeviceInit Tests\n// -----------------------------------------------------------------------------\nTEST(CliTest, DeviceInit_BootMode) {\n  UsbDeviceId id{.vid \u003d 0x2808, .pid \u003d 0x0001};\n  FtDeviceInfo info;\n  ASSERT_TRUE(DeviceInit(id, info).has_value());\n  EXPECT_EQ(info.current_mode, FtDeviceMode::kBoot);\n}\n\nTEST(CliTest, DeviceInit_Unknown) {\n  UsbDeviceId id{.vid \u003d 0x1234, .pid \u003d 0x5678};\n  FtDeviceInfo info;\n  EXPECT_FALSE(DeviceInit(id, info).has_value());\n}\n\n// -----------------------------------------------------------------------------\n// ExecuteCommand \u0026 Routing Tests (Happy Paths)\n// -----------------------------------------------------------------------------\nTEST(CliTest, ExecuteCommand_GetEcVersion_Success) {\n  auto mock \u003d std::make_unique\u003cMockUsbTransport\u003e();\n  EXPECT_CALL(*mock, Send(_, _)).WillOnce(Return(kEcCmdSize));\n  EXPECT_CALL(*mock, Recv(_, _))\n      .WillOnce(Invoke([](std::span\u003cuint8_t\u003e data, auto) -\u003e std::expected\u003cint, FtError\u003e {\n        constexpr std::string_view kVersion \u003d \"ft9001_v2.0\";\n        std::ranges::copy(kVersion, data.begin() + kEcResponseHeaderSize);\n        return kEcResponseHeaderSize + kVersion.size();\n      }));\n\n  UsbDevice device \u003d MakeDevice(std::move(mock));\n  AppConfig config{.cmd \u003d Command::kGetEcVersion};\n  FtDeviceInfo info{.current_mode \u003d FtDeviceMode::kEc};\n\n  EXPECT_TRUE(ExecuteCommand(config, device, info).has_value());\n}\n\nTEST(CliTest, ExecuteCommand_GetFlashWp_Success) {\n  auto mock \u003d std::make_unique\u003cMockUsbTransport\u003e();\n  // Send CBW -\u003e Recv Data -\u003e Recv CSW\n  EXPECT_CALL(*mock, Send(_, _)).WillOnce(Return(kUsbCbwSize));\n  EXPECT_CALL(*mock, Recv(_, _))\n      .WillOnce(Invoke([](std::span\u003cuint8_t\u003e data, auto) -\u003e std::expected\u003cint, FtError\u003e {\n        data[0] \u003d static_cast\u003cuint8_t\u003e(FtFlashWpArea::kBoot);\n        return kFlashWpBufferSize;\n      }))\n      .WillOnce(Return(kUsbCswSize));\n\n  UsbDevice device \u003d MakeDevice(std::move(mock));\n  AppConfig config{.cmd \u003d Command::kGetFlashWp};\n  FtDeviceInfo info{.current_mode \u003d FtDeviceMode::kBoot};\n\n  EXPECT_TRUE(ExecuteCommand(config, device, info).has_value());\n}\n\nTEST(CliTest, ExecuteCommand_UnknownCommand) {\n  auto mock \u003d std::make_unique\u003cMockUsbTransport\u003e();\n  EXPECT_CALL(*mock, Send(_, _)).Times(0); // No hardware interaction expected\n\n  UsbDevice device \u003d MakeDevice(std::move(mock));\n  AppConfig config{.cmd \u003d Command::kUnknown};\n  FtDeviceInfo info{.current_mode \u003d FtDeviceMode::kBoot};\n\n  EXPECT_FALSE(ExecuteCommand(config, device, info).has_value());\n}\n\n// -----------------------------------------------------------------------------\n// I/O Retry Logic \u0026 Recovery Tests\n// -----------------------------------------------------------------------------\nTEST(CliTest, CheckEcBuildVersion_RetriesAndSucceeds) {\n  auto mock \u003d std::make_unique\u003cMockUsbTransport\u003e();\n  int send_attempts \u003d 0;\n\n  // Use a stateful lambda to fail the first 2 attempts, then succeed\n  EXPECT_CALL(*mock, Send(_, _))\n      .WillRepeatedly(Invoke([\u0026](auto, auto) -\u003e std::expected\u003cint, FtError\u003e {\n        if (++send_attempts \u003c 3) return std::unexpected(FtError::kResultFail);\n        return kEcCmdSize; \n      }));\n\n  // Only called after Send finally succeeds\n  EXPECT_CALL(*mock, Recv(_, _))\n      .WillOnce(Invoke([](std::span\u003cuint8_t\u003e data, auto) -\u003e std::expected\u003cint, FtError\u003e {\n        constexpr std::string_view kVersion \u003d \"chojnik_v1.0\";\n        std::ranges::copy(kVersion, data.begin() + kEcResponseHeaderSize);\n        return kEcResponseHeaderSize + kVersion.size();\n      }));\n\n  UsbDevice device \u003d MakeDevice(std::move(mock));\n  \n  EXPECT_TRUE(CheckEcBuildVersion(device, FtDeviceMode::kEc).has_value());\n  EXPECT_EQ(send_attempts, 3);\n}\n\nTEST(CliTest, SwitchMcuMode_ExhaustsRetriesOnTotalFailure) {\n  auto mock \u003d std::make_unique\u003cMockUsbTransport\u003e();\n  int send_attempts \u003d 0;\n\n  // Simulate a severed USB connection that never recovers\n  EXPECT_CALL(*mock, Send(_, _))\n      .WillRepeatedly(Invoke([\u0026](auto, auto) -\u003e std::expected\u003cint, FtError\u003e {\n        send_attempts++;\n        return std::unexpected(FtError::kNoSuchDevice);\n      }));\n\n  UsbDevice device \u003d MakeDevice(std::move(mock));\n  std::array\u003cuint8_t, 8\u003e dummy_cmd \u003d {0};\n\n  auto result \u003d SwitchMcuMode(device, FtDeviceMode::kEc, dummy_cmd, \"ROM\");\n  \n  EXPECT_FALSE(result.has_value());\n  EXPECT_EQ(send_attempts, 5); // kMaxRetry from cli.h\n}\n\nTEST(CliTest, ExecuteCommand_Update_RetriesAndSucceeds) {\n  ScopedTempFile fw_file(MakeFirmware());\n  auto mock \u003d std::make_unique\u003cMockUsbTransport\u003e();\n  int update_attempts \u003d 0;\n\n  // Simulate a flaky connection that aborts the update sequence twice before working\n  EXPECT_CALL(*mock, Send(_, _))\n      .WillRepeatedly(Invoke([\u0026](std::span\u003cconst uint8_t\u003e data, auto) -\u003e std::expected\u003cint, FtError\u003e {\n        if (data.size() \u003d\u003d kUsbCbwSize) {\n          if (++update_attempts \u003c 3) return std::unexpected(FtError::kResultFail);\n        }\n        return data.size();\n      }));\n\n  EXPECT_CALL(*mock, Recv(_, _))\n      .WillRepeatedly(Invoke([](std::span\u003cuint8_t\u003e data, auto) -\u003e std::expected\u003cint, FtError\u003e {\n        if (data.size() \u003d\u003d kUsbCswSize) return kUsbCswSize;\n        if (data.size() \u003d\u003d 36) return 36; // Boot version response\n        if (data.size() \u003d\u003d 32) return 32; // Hash response\n        return data.size();\n      }));\n\n  EXPECT_CALL(*mock, WaitForReset(_)).WillRepeatedly(Return(std::expected\u003cvoid, FtError\u003e()));\n\n  UsbDevice device \u003d MakeDevice(std::move(mock));\n  AppConfig app_config{.cmd \u003d Command::kUpdate, .ec_bin \u003d fw_file.path()};\n  FtDeviceInfo info{.current_mode \u003d FtDeviceMode::kBoot, .ec_bin \u003d fw_file.path()};\n\n  EXPECT_TRUE(ExecuteCommand(app_config, device, info).has_value());\n  EXPECT_EQ(update_attempts, 3);\n}\n\n```"