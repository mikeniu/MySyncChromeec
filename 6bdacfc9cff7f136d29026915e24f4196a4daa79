      "message": "Here\u0027s a Gemini generated refactor to address this:\n\n----\n\n### 1. The Protocol Layer (`bootrom_protocol.h`)\n\nThis is the core of the refactor. We are shifting the responsibility of understanding the wire format (endianness and packet sizing) out of the application logic and directly into the structs that define the protocol.\n\n**The Changes:**\n\n* Include `\"egis_util.h\"` at the top of the file.\n* Add `FromLittleEndian()` to all incoming response and header structs.\n* Add a universal `RawResponseHeader` to handle the baseline USB response.\n* Add `constexpr` helper functions to map crypto algorithms to their exact byte sizes.\n\n```cpp\n#include \"crypto_util.h\"\n#include \"egis_util.h\"\n\n// 1. Encapsulate Endianness inside the Response Structs\nstruct BootromInfoResponse {\n  uint32_t version;\n  uint32_t max_cmd_size;\n  uint32_t max_fw_upgrade_size;\n\n  void FromLittleEndian() {\n    version \u003d egis::FromLittleEndian(version);\n    max_cmd_size \u003d egis::FromLittleEndian(max_cmd_size);\n    max_fw_upgrade_size \u003d egis::FromLittleEndian(max_fw_upgrade_size);\n  }\n} __attribute__((packed));\nstatic_assert(sizeof(BootromInfoResponse) \u003d\u003d 12, \"Must be exactly 12 bytes\");\n\nstruct FlashInfoResponse {\n  uint32_t flash_size;\n  uint32_t reserved;\n  char prod_name[8];\n  uint8_t remaining[24];\n\n  void FromLittleEndian() {\n    flash_size \u003d egis::FromLittleEndian(flash_size);\n    reserved \u003d egis::FromLittleEndian(reserved);\n  }\n} __attribute__((packed));\nstatic_assert(sizeof(FlashInfoResponse) \u003d\u003d 40, \"Must be exactly 40 bytes\");\n\n// 2. Define the Universal Baseline Response\nstruct RawResponseHeader {\n  uint16_t status;\n\n  void FromLittleEndian() {\n    status \u003d egis::FromLittleEndian(status);\n  }\n} __attribute__((packed));\nstatic_assert(sizeof(RawResponseHeader) \u003d\u003d 2, \"Must be exactly 2 bytes\");\n\n// 3. Encapsulate Secure Headers\nstruct SecureCommandBaseHeader {\n  CommandId command_id \u003d CommandId::kSecureWrapped;\n  egis::EgisCryptoType algo;\n  uint32_t payload_len;\n\n  void FromLittleEndian() {\n    payload_len \u003d egis::FromLittleEndian(payload_len);\n  }\n} __attribute__((packed));\nstatic_assert(sizeof(SecureCommandBaseHeader) \u003d\u003d 6, \"Must be exactly 6 bytes\");\n\nstruct SecureResponseHeader {\n  uint16_t status;\n  uint32_t payload_len;\n\n  void FromLittleEndian() {\n    status \u003d egis::FromLittleEndian(status);\n    payload_len \u003d egis::FromLittleEndian(payload_len);\n  }\n} __attribute__((packed));\nstatic_assert(sizeof(SecureResponseHeader) \u003d\u003d 6, \"Must be exactly 6 bytes\");\n\n// 4. Centralize Sizing Logic\nconstexpr std::expected\u003csize_t, std::errc\u003e GetSecureHeaderSize(EgisCryptoType algo) {\n  switch (algo) {\n    case EgisCryptoType::kSha256:\n      return sizeof(SecureCommandShaHeader);\n    case EgisCryptoType::kAesGcm:\n      return sizeof(SecureCommandAesHeader);\n    default:\n      return std::unexpected(std::errc::invalid_argument);\n  }\n}\n\nconstexpr std::expected\u003csize_t, std::errc\u003e GetSecureResponseEnvelopeSize(\n    EgisCryptoType algo) {\n  switch (algo) {\n    case EgisCryptoType::kSha256:\n      return sizeof(SecureResponseHeader); \n    case EgisCryptoType::kAesGcm:\n      return sizeof(SecureResponseHeader) + crypto::kAesGcmIvSize + \n             crypto::kAesGcmTagSize;\n    default:\n      return std::unexpected(std::errc::invalid_argument);\n  }\n}\n\n```\n\n**The Rationale:**\n\n* **Domain-Driven Design:** The protocol definitions act as the single source of truth for all byte-level layouts.\n* **Safety via Explicitness:** The name `FromLittleEndian()` leaves no ambiguity about the wire format or what the function does to the struct\u0027s internal state.\n* **Future-Proofing:** If HMAC support is added, the developer only updates the `switch` statements here. The application logic automatically inherits the new sizes.\n\n---\n\n### 2. The Communication Layer (`bootrom.cc`)\n\nWith the protocol layer enriched, the communication layer drops all manual byte-math and static size constants, transitioning to a pure orchestration role.\n\n**The Changes:**\n\n* Delete `kScHeaderSizeSha` and `kScHeaderSizeAes` from `bootrom.h`.\n* Remove the `min_expected_rx_size` parameter from `SendPrewrappedPacket` and `ExtractSecureData`.\n* Replace manual endian-swapping with `.FromLittleEndian()`.\n\n```cpp\n// 1. Simplified Packet Transmission\nstd::expected\u003cstd::vector\u003cuint8_t\u003e, BootromError\u003e\nBootromComm::SendPrewrappedPacket(std::span\u003cconst uint8_t\u003e tx_cmd,\n                                  std::chrono::milliseconds timeout) {\n  DumpRawCmd(tx_cmd);\n\n  if (auto res \u003d usb_.Send(tx_cmd, timeout); !res)\n    return std::unexpected(BootromError::kUsbWriteFailed);\n\n  std::vector\u003cuint8_t\u003e ret(kMaxPayloadSize, 0);\n  auto read_res \u003d usb_.Receive(ret, timeout);\n  if (!read_res || *read_res \u003c\u003d 0)\n    return std::unexpected(BootromError::kUsbReadFailed);\n\n  ret.resize(*read_res);\n\n  // Unpack the universal baseline header\n  auto hdr_res \u003d ReadStruct\u003cbootrom_protocol::RawResponseHeader\u003e(ret);\n  if (!hdr_res) return std::unexpected(BootromError::kResponseTruncated);\n\n  hdr_res-\u003eFromLittleEndian();\n\n  if (hdr_res-\u003estatus !\u003d 0) return std::unexpected(BootromError::kInvalidStatusHeader);\n\n  return ret;\n}\n\n// 2. Abstracted Secure Data Extraction\nstd::expected\u003cstd::span\u003cconst uint8_t\u003e, BootromError\u003e\nBootromComm::ExtractSecureData(std::span\u003cconst uint8_t\u003e raw_response) {\n  auto rsp_hdr_res \u003d\n      ReadStruct\u003cbootrom_protocol::SecureResponseHeader\u003e(raw_response);\n  if (!rsp_hdr_res) return std::unexpected(BootromError::kResponseTruncated);\n\n  rsp_hdr_res-\u003eFromLittleEndian(); \n\n  // Dynamically fetch the correct size from the protocol layer\n  auto env_size_res \u003d bootrom_protocol::GetSecureResponseEnvelopeSize(wrapped_algo_);\n  if (!env_size_res) return std::unexpected(BootromError::kUnsupportedCrypto);\n  \n  const size_t min_resp_size \u003d *env_size_res;\n\n  if (raw_response.size() \u003c min_resp_size) {\n    return std::unexpected(BootromError::kResponseTruncated);\n  }\n\n  uint32_t rsp_wrapped_len \u003d rsp_hdr_res-\u003epayload_len;\n\n  if (rsp_wrapped_len \u003e raw_response.size() - min_resp_size) {\n    rsp_wrapped_len \u003d raw_response.size() - min_resp_size;\n  }\n\n  size_t extra_data_size \u003d\n      min_resp_size - sizeof(bootrom_protocol::SecureResponseHeader);\n\n  return raw_response.subspan(sizeof(bootrom_protocol::SecureResponseHeader),\n                              extra_data_size + rsp_wrapped_len);\n}\n\n```\n\n**The Rationale:**\n\n* **DRY (Don\u0027t Repeat Yourself):** Caller functions (like `SendBootromCommandAes`) no longer need to calculate and pass size variables down the stack.\n* **High Cohesion:** `BootromComm` only concerns itself with reading USB bytes and applying cryptographic transformations based on its internal state (`wrapped_algo_`), delegating protocol structure questions to the domain model.\n\n---\n\n### 3. The Flasher Logic (`flasher_logic.cc`)\n\nThe offline raw-command flasher is highly susceptible to parser errors. By leveraging the new struct methods, the parser drops its manual `if/else` byte-math chains.\n\n**The Changes:**\n\n* Use `.FromLittleEndian()` to safely read the embedded payload length.\n* Use `GetSecureHeaderSize()` to determine the packet boundary dynamically.\n\n```cpp\nstd::expected\u003csize_t, ParseError\u003e GetNextPacketSize(\n    std::span\u003cconst uint8_t\u003e fw) {\n  constexpr size_t kResetCmdSize \u003d sizeof(bootrom_protocol::SystemResetCommand);\n  if (fw.size() \u003c kResetCmdSize)\n    return std::unexpected(ParseError::kDataTooSmall);\n\n  if (fw[0] \u003d\u003d std::to_underlying(bootrom_protocol::CommandId::kSystemReset))\n    return kResetCmdSize;\n  else if (fw[0] !\u003d\n           std::to_underlying(bootrom_protocol::CommandId::kSecureWrapped))\n    return std::unexpected(ParseError::kInvalidHeader);\n\n  auto base_hdr_res \u003d ReadStruct\u003cbootrom_protocol::SecureCommandBaseHeader\u003e(fw);\n  if (!base_hdr_res) return std::unexpected(ParseError::kTruncatedHeader);\n\n  base_hdr_res-\u003eFromLittleEndian(); \n\n  constexpr size_t kMaxWrappedSize \u003d\n      BootromComm::kMaxFlashWriteSize +\n      sizeof(bootrom_protocol::BlockWriteCommand);\n      \n  if (base_hdr_res-\u003epayload_len \u003e kMaxWrappedSize)\n    return std::unexpected(ParseError::kInvalidPayloadSize);\n\n  // Fetch the correct header size cleanly\n  auto header_size_res \u003d bootrom_protocol::GetSecureHeaderSize(base_hdr_res-\u003ealgo);\n  if (!header_size_res) return std::unexpected(ParseError::kUnsupportedCrypto);\n\n  return *header_size_res + base_hdr_res-\u003epayload_len;\n}\n\n```\n\n**The Rationale:**\n\n* **Reduced Complexity:** The parser logic is strictly focused on stream validation (checking bounds, validating command IDs) rather than recalculating header geometries.\n* **Reliability:** The risk of forgetting an endian-swap inside a complex `if/else` block is entirely eliminated.",
