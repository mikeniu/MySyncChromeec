      "message": "Here are the Gemini generated changes to implement. Verify for correctness:\n\n----\n\nHere are the complete, consolidated diffs to replace the POSIX `\u003cendian.h\u003e` macros (`htole32` and `le32toh`) with the native C++23 `\u003cbit\u003e` implementation across the entire patch.\n\nThis update touches the core utility header, the SCSI implementation (including the previously unswapped `BuildFtCmd` fields), and all three test files that manually construct or parse USB wrappers.\n\n### 1. `util/focaltech/ft_util.h`\n\nFirst, we add the necessary headers and the `ToLittleEndian` template to your core utility file.\n\n```diff\n--- a/util/focaltech/ft_util.h\n+++ b/util/focaltech/ft_util.h\n@@ -5,7 +5,9 @@\n #ifndef UTIL_FOCALTECH_FT_UTIL_H_\n #define UTIL_FOCALTECH_FT_UTIL_H_\n \n+#include \u003cbit\u003e\n #include \u003ccassert\u003e\n+#include \u003cconcepts\u003e\n #include \u003cstring_view\u003e\n \n template \u003ctypename T\u003e\n@@ -14,6 +16,14 @@\n   return (n + d - 1) / d;\n }\n \n+// C++23 native endianness swapping\n+template \u003cstd::integral T\u003e\n+constexpr T ToLittleEndian(T value) {\n+  if constexpr (std::endian::native \u003d\u003d std::endian::big) {\n+    return std::byteswap(value);\n+  }\n+  return value;\n+}\n+\n enum class FtError {\n   kSuccess \u003d 0,\n\n```\n\n### 2. `util/focaltech/ft_scsi.cc`\n\nNext, we remove the `\u003cendian.h\u003e` include, apply the new template to the CBW/CSW parsing, and most importantly, fix the architectural vulnerability by applying endianness to the command fields in `BuildFtCmd`.\n\n```diff\n--- a/util/focaltech/ft_scsi.cc\n+++ b/util/focaltech/ft_scsi.cc\n@@ -5,8 +5,6 @@\n  */\n \n #include \"ft_scsi.h\"\n \n-#include \u003cendian.h\u003e\n-\n #include \u003cbit\u003e\n \n #include \"ft_log.h\"\n@@ -55,9 +53,9 @@\n     std::chrono::milliseconds timeout_ms) {\n   BulkCbWrap cbw{\n-      .signature \u003d htole32(kUsbMsCbwSignature),\n-      .tag \u003d htole32(device.GetNextCdbTag()),  // Using atomic thread-safe tag\n-      .data_transfer_length \u003d htole32(data_length),\n+      .signature \u003d ToLittleEndian(kUsbMsCbwSignature),\n+      .tag \u003d ToLittleEndian(device.GetNextCdbTag()),  // Using atomic thread-safe tag\n+      .data_transfer_length \u003d ToLittleEndian(static_cast\u003cuint32_t\u003e(data_length)),\n       .flags \u003d\n           (dir \u003d\u003d TransferDirection::kIn) ? kBotDirectionIn : kBotDirectionOut,\n       .lun \u003d 0,\n@@ -91,8 +89,8 @@\n   }\n \n-  if (le32toh(csw.signature) !\u003d kUsbMsCswSignature ||\n-      le32toh(csw.tag) !\u003d le32toh(cbw.tag)) {\n+  if (ToLittleEndian(csw.signature) !\u003d kUsbMsCswSignature ||\n+      ToLittleEndian(csw.tag) !\u003d ToLittleEndian(cbw.tag)) {\n     FT_LOGE(\"CSW signature/tag mismatch.\");\n     return std::unexpected(FtError::kResultFail);\n   }\n@@ -109,9 +107,9 @@\n                                            uint32_t aux_address, uint8_t flags) {\n   FtCmdFormat cmd{\n       .opcode \u003d opcode,\n-      .address \u003d address,\n-      .length \u003d length,\n-      .aux_address \u003d aux_address,\n+      .address \u003d ToLittleEndian(address),\n+      .length \u003d ToLittleEndian(length),\n+      .aux_address \u003d ToLittleEndian(aux_address),\n       .subcmd \u003d subcmd,\n       .flags \u003d flags,\n       .reserved \u003d 0,\n\n```\n\n### 3. `util/focaltech/updater_test.cc`\n\nRemove `\u003cendian.h\u003e` and replace the macros used in CSW construction and the test transport interceptor.\n\n```diff\n--- a/util/focaltech/updater_test.cc\n+++ b/util/focaltech/updater_test.cc\n@@ -5,8 +5,6 @@\n  */\n \n #include \"updater.h\"\n \n-#include \u003cendian.h\u003e\n #include \u003cgmock/gmock.h\u003e\n #include \u003cgtest/gtest.h\u003e\n \n@@ -68,8 +66,8 @@\n // Helper: build a valid CSW with the given tag\n static void BuildValidCsw(std::span\u003cuint8_t\u003e data, uint32_t tag) {\n-  BulkCsWrap csw{.signature \u003d htole32(kUsbMsCswSignature),\n-                 .tag \u003d htole32(tag),\n+  BulkCsWrap csw{.signature \u003d ToLittleEndian\u003cuint32_t\u003e(kUsbMsCswSignature),\n+                 .tag \u003d ToLittleEndian\u003cuint32_t\u003e(tag),\n                  .data_residue \u003d 0,\n                  .status \u003d 0};\n   std::memcpy(data.data(), \u0026csw, sizeof(csw));\n@@ -107,7 +105,7 @@\n     if (data.size() \u003d\u003d kUsbCbwSize \u0026\u0026 data[15] \u003d\u003d 0xDC \u0026\u0026 data[28] \u003d\u003d 0x08) {\n       uint32_t address \u003d *reinterpret_cast\u003cconst uint32_t*\u003e(\u0026data[16]);\n-      erased_addresses_.push_back(le32toh(address));\n+      erased_addresses_.push_back(ToLittleEndian(address));\n     }\n     return static_cast\u003cint\u003e(data.size());\n\n```\n\n### 4. `util/focaltech/ft_scsi_test.cc`\n\nReplace the macros in the test CSW builders.\n\n```diff\n--- a/util/focaltech/ft_scsi_test.cc\n+++ b/util/focaltech/ft_scsi_test.cc\n@@ -42,8 +42,8 @@\n     uint8_t status;\n   };\n   Csw csw;\n-  csw.sig \u003d htole32(0x53425355);\n-  csw.tag \u003d htole32(tag);\n+  csw.sig \u003d ToLittleEndian\u003cuint32_t\u003e(0x53425355);\n+  csw.tag \u003d ToLittleEndian\u003cuint32_t\u003e(tag);\n   csw.residue \u003d 0;\n   csw.status \u003d 0;\n   std::memcpy(data.data(), \u0026csw, sizeof(csw));\n@@ -165,8 +165,8 @@\n             uint8_t status;\n           };\n           Csw csw;\n-          csw.sig \u003d htole32(0xDEADBEEF);\n-          csw.tag \u003d htole32(1);\n+          csw.sig \u003d ToLittleEndian\u003cuint32_t\u003e(0xDEADBEEF);\n+          csw.tag \u003d ToLittleEndian\u003cuint32_t\u003e(1);\n           csw.residue \u003d 0;\n           csw.status \u003d 0;\n           std::memcpy(data.data(), \u0026csw, sizeof(csw));\n\n```\n\n### 5. `util/focaltech/cli_test.cc`\n\nReplace the final macro usage in the CLI test file.\n\n```diff\n--- a/util/focaltech/cli_test.cc\n+++ b/util/focaltech/cli_test.cc\n@@ -467,8 +467,8 @@\n     uint8_t status;\n   };\n-  BulkCsWrap csw{.signature \u003d htole32(0x53425355),\n-                 .tag \u003d htole32(tag),\n+  BulkCsWrap csw{.signature \u003d ToLittleEndian\u003cuint32_t\u003e(0x53425355),\n+                 .tag \u003d ToLittleEndian\u003cuint32_t\u003e(tag),\n                  .data_residue \u003d 0,\n                  .status \u003d status};\n   std::memcpy(data.data(), \u0026csw, sizeof(csw));\n\n```",
