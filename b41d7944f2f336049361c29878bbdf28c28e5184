0};\n-  std::memcpy(data.data(), \u0026csw, sizeof(csw));\n-}\n\n```\n\n#### 5. Update `util/focaltech/usb_device_test.cc`\n\nRemove the local mock and replace it with the centralized one.\n\n```diff\n--- a/util/focaltech/usb_device_test.cc\n+++ b/util/focaltech/usb_device_test.cc\n@@ -11,20 +11,11 @@\n #include \u003cmemory\u003e\n #include \u003cthread\u003e\n \n+#include \"mock_usb_transport.h\"\n #include \"usb_transport.h\"\n \n using namespace std::chrono_literals;\n using ::testing::_;\n using ::testing::ByMove;\n using ::testing::Invoke;\n using ::testing::Return;\n+using ::focaltech::testing::MockUsbTransport;\n \n-// Mock USB transport\n-class MockUsbTransport : public UsbTransport {\n- public:\n-  MOCK_METHOD(UsbDeviceId, device_id, (), (const, override));\n-  MOCK_METHOD((std::expected\u003cint, FtError\u003e), Send,\n-              (std::span\u003cconst uint8_t\u003e, std::chrono::milliseconds),\n-              (override));\n-  MOCK_METHOD((std::expected\u003cint, FtError\u003e), Recv,\n-              (std::span\u003cuint8_t\u003e, std::chrono::milliseconds), (override));\n-  MOCK_METHOD((std::expected\u003cvoid, FtError\u003e), WaitForReset,\n-              (std::chrono::milliseconds), (override));\n-};\n\n```\n\n#### 6. Update `util/focaltech/cli_test.cc`\n\nRemove the local `BuildCsw` and update the test cases to use `BuildValidCsw`.\n\n```diff\n--- a/util/focaltech/cli_test.cc\n+++ b/util/focaltech/cli_test.cc\n@@ -14,14 +14,13 @@\n #include \u003cspan\u003e\n #include \u003cstring_view\u003e\n #include \u003cvector\u003e\n \n+#include \"test_utils.h\"\n #include \"updater.h\"\n #include \"usb_device.h\"\n \n using namespace std::chrono_literals;\n using ::testing::_;\n using ::testing::DoAll;\n using ::testing::Invoke;\n using ::testing::Return;\n using ::testing::SetArgPointee;\n+using ::focaltech::testing::BuildValidCsw;\n \n-constexpr size_t kUsbCbwSize \u003d 31;\n-constexpr size_t kUsbCswSize \u003d 13;\n-\n@@ -461,19 +460,6 @@\n // SCSI-based