      "message": "There is a lot of helper code duplicated across the test files. Let\u0027s consolidate it. Here is code generated by Gemini. Verify that it\u0027s correct:\n\n\n----\n\n### The Rationale\n\n* **DRYing the Test Suite:** The original patch duplicated `BuildValidCsw`, `BulkCsWrap`, and `ComputeSha256` across `cli_test.cc`, `ft_scsi_test.cc`, and `updater_test.cc`. Centralizing these in `test_utils.h` eliminates boilerplate and centralizes the logic.\n* **Mock Consolidation:** The original patch had a standalone `mock_usb_transport.h`, but `ft_scsi_test.cc` and `usb_device_test.cc` ignored it and redefined `MockUsbTransport` locally. Using the centralized mock ensures consistency.\n* **Separation of Concerns:** Keeping `mock_usb_transport.h` separate from `test_utils.h` ensures that tests only needing data helpers (like `cli_test.cc`) do not unnecessarily pull in `\u003cgmock/gmock.h\u003e`.\n* **Strict Style Compliance:** Wrapping the test utilities in `namespace focaltech::testing` and using explicit `using` declarations (e.g., `using ::focaltech::testing::BuildValidCsw;`) strictly adheres to the Google C++ Style Guide\u0027s ban on `using namespace` directives.\n\n---\n\n### The Code Changes\n\nHere are the complete diffs to implement the `test_utils.h` framework, incorporating the updated endianness approach, the separated mock file, and the strict Google C++ style `using` declarations.\n\n#### 1. Create `util/focaltech/test_utils.h`\n\nCreate this new file to house the shared data structures and functional helpers.\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n\n#ifndef UTIL_FOCALTECH_TEST_UTILS_H_\n#define UTIL_FOCALTECH_TEST_UTILS_H_\n\n#include \u003carray\u003e\n#include \u003ccstdint\u003e\n#include \u003ccstring\u003e\n#include \u003cspan\u003e\n\n#include \u003copenssl/sha.h\u003e\n\n#include \"ft_util.h\"\n\nnamespace focaltech::testing {\n\ninline constexpr size_t kUsbCbwSize \u003d 31;\ninline constexpr size_t kUsbCswSize \u003d 13;\ninline constexpr uint32_t kUsbMsCswSignature \u003d 0x53425355;\n\n// Safely builds a valid USB Mass Storage Command Status Wrapper (CSW)\ninline void BuildValidCsw(std::span\u003cuint8_t\u003e data, uint32_t tag, uint8_t status \u003d 0) {\n  struct __attribute__((packed)) Csw {\n    uint32_t sig;\n    uint32_t tag;\n    uint32_t residue;\n    uint8_t status;\n  };\n  \n  Csw csw{\n      .sig \u003d ToLittleEndian\u003cuint32_t\u003e(kUsbMsCswSignature),\n      .tag \u003d ToLittleEndian\u003cuint32_t\u003e(tag),\n      .residue \u003d 0,\n      .status \u003d status,\n  };\n  std::memcpy(data.data(), \u0026csw, sizeof(csw));\n}\n\n// Standardized SHA256 computation for test payloads\ninline std::array\u003cuint8_t, SHA256_DIGEST_LENGTH\u003e ComputeSha256(\n    std::span\u003cconst uint8_t\u003e data) {\n  std::array\u003cuint8_t, SHA256_DIGEST_LENGTH\u003e hash{};\n  SHA256(data.data(), data.size(), hash.data());\n  return hash;\n}\n\n}  // namespace focaltech::testing\n\n#endif  // UTIL_FOCALTECH_TEST_UTILS_H_\n\n```\n\n#### 2. Update `util/focaltech/mock_usb_transport.h`\n\nAdd the namespace to the existing mock file.\n\n```diff\n--- a/util/focaltech/mock_usb_transport.h\n+++ b/util/focaltech/mock_usb_transport.h\n@@ -5,15 +5,19 @@\n #include \u003cgmock/gmock.h\u003e\n \n #include \"usb_transport.h\"\n \n+namespace focaltech::testing {\n+\n class MockUsbTransport : public UsbTransport {\n  public:\n   MOCK_METHOD(UsbDeviceId, device_id, (), (const, override));\n   MOCK_METHOD((std::expected\u003cint, FtError\u003e), Send,\n               (std::span\u003cconst uint8_t\u003e, std::chrono::milliseconds),\n               (override));\n   MOCK_METHOD((std::expected\u003cint, FtError\u003e), Recv,\n               (std::span\u003cuint8_t\u003e, std::chrono::milliseconds), (override));\n   MOCK_METHOD((std::expected\u003cvoid, FtError\u003e), WaitForReset,\n               (std::chrono::milliseconds), (override));\n };\n+\n+}  // namespace focaltech::testing\n\n```\n\n#### 3. Update `util/focaltech/ft_scsi_test.cc`\n\nRemove the local mock definition, the CSW builder, and add explicit `using` declarations.\n\n```diff\n--- a/util/focaltech/ft_scsi_test.cc\n+++ b/util/focaltech/ft_scsi_test.cc\n@@ -10,41 +10,16 @@\n \n #include \u003carray\u003e\n #include \u003ccstring\u003e\n \n+#include \"mock_usb_transport.h\"\n+#include \"test_utils.h\"\n #include \"usb_device.h\"\n \n using namespace std::chrono_literals;\n using ::testing::_;\n using ::testing::Invoke;\n+using ::focaltech::testing::BuildValidCsw;\n+using ::focaltech::testing::MockUsbTransport;\n \n-// Mock USB transport\n-class MockUsbTransport : public UsbTransport {\n- public:\n-  MOCK_METHOD(UsbDeviceId, device_id, (), (const, override));\n-  MOCK_METHOD((std::expected\u003cint, FtError\u003e), Send,\n-              (std::span\u003cconst uint8_t\u003e, std::chrono::milliseconds),\n-              (override));\n-  MOCK_METHOD((std::expected\u003cint, FtError\u003e), Recv,\n-              (std::span\u003cuint8_t\u003e, std::chrono::milliseconds), (override));\n-  MOCK_METHOD((std::expected\u003cvoid, FtError\u003e), WaitForReset,\n-              (std::chrono::milliseconds), (override));\n-};\n-\n static UsbDevice MakeDevice(std::unique_ptr\u003cUsbTransport\u003e transport) {\n   return UsbDevice(std::move(transport));\n }\n \n-// Helper to build a valid CSW (13 bytes)\n-static void BuildValidCsw(std::span\u003cuint8_t\u003e data, uint32_t tag) {\n-  struct __attribute__((packed)) Csw {\n-    uint32_t sig;\n-    uint32_t tag;\n-    uint32_t residue;\n-    uint8_t status;\n-  };\n-  Csw csw;\n-  csw.sig \u003d htole32(0x53425355);\n-  csw.tag \u003d htole32(tag);\n-  csw.residue \u003d 0;\n-  csw.status \u003d 0;\n-  std::memcpy(data.data(), \u0026csw, sizeof(csw));\n-}\n\n```\n\n#### 4. Update `util/focaltech/updater_test.cc`\n\nRemove the constants, struct, and