ecute_flag \u003d\u003d 1);\n}\n\n\nZTEST(libc_exit, test2_essential_thread_abort)\n{\n\tk_tid_t tid;\n\ttid \u003d k_thread_create(\u0026tdata, tstack, STACK_SIZE, abort_thread_entry,\n\t\t\t      NULL, NULL, NULL, 0, K_ESSENTIAL, K_NO_WAIT);\n\n\tk_sem_take(\u0026sync_sem, K_FOREVER);\n\tztest_set_fault_valid(true);\n\tk_thread_abort(tid);\n}\n```\nThe output logs are:\n```\nDEBUG:fpmcu:~$ ztest run-all\nDEBUG:Running TESTSUITE libc_exit\nDEBUG:\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\nDEBUG:START - test1_non_essential_thread\nDEBUG:[0.997000] \u003cinf\u003e libc_exit: I am in non_essential_thread.\nDEBUG:\nDEBUG:[1.002000] \u003cinf\u003e libc_exit: Calling exit.\nDEBUG:\nDEBUG: exited with rc: 1\nDEBUG:[1.008000] \u003cinf\u003e libc_exit: I am in non_essential_thread before assert.\nDEBUG:\nDEBUG: PASS - test1_non_essential_thread in 0.018 seconds\nDEBUG:\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\nDEBUG:START - test2_essential_thread_abort\nDEBUG:I am in ztest_set_fault_value.\nDEBUG:[1.031000] \u003cerr\u003e os: \u003e\u003e\u003e ZEPHYR FATAL ERROR 4: Kernel panic on CPU 0\nDEBUG:[1.037000] \u003cerr\u003e os: Current thread: 0x20002420 (test2_essential)\nDEBUG:I am in ztest_error_hook.cCaught system error -- reason 4 1\nDEBUG:Fatal error expected a