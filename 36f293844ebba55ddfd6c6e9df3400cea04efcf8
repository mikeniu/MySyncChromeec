      "message": "Here are Gemini generated instructions to break it up. Verify for correctness:\n\n----\n\nHere is the step-by-step guide to executing this architectural split. This will involve creating three new sets of header/source files, trimming down your `main` file, and updating your build script.\n\n---\n\n### **Step 1: Extract CLI Parsing (`cli_options`)**\n\nCreate `util/egis/cli_options.h` and `util/egis/cli_options.cc` to handle all user input.\n\n**1. Create `cli_options.h`:**\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#ifndef UTIL_EGIS_CLI_OPTIONS_H_\n#define UTIL_EGIS_CLI_OPTIONS_H_\n\n#include \u003ccstdint\u003e\n#include \u003coptional\u003e\n#include \u003cstring\u003e\n\n#include \"bootrom.h\" // For EgisCryptoType\n\nnamespace egis {\n\nenum class AppError {\n  kInvalidArgs,\n  kFileIoError,\n  kCryptoError,\n  kBootromError,\n  kUsbError,\n  kParseError,\n};\n\nenum class AppMode {\n  kNone,\n  kFlashFw,\n  kFlashCmd,\n};\n\nstruct AppConfig {\n  AppMode mode \u003d AppMode::kNone;\n  std::string fw_path;\n  std::string key_path;\n  EgisCryptoType algo_type \u003d EgisCryptoType::kSha256;\n  uint32_t flash_offset \u003d 0x00001000;\n  uint32_t fw_size_override \u003d 0;\n  bool dump_cmd_fw \u003d false;\n};\n\nvoid PrintHelp(const char *prog_name);\nstd::optional\u003cAppConfig\u003e ParseArgs(int argc, char *argv[]);\n\n}  // namespace egis\n\n#endif  // UTIL_EGIS_CLI_OPTIONS_H_\n\n```\n\n**2. Create `cli_options.cc`:**\nMove `ParseHex`, `PrintHelp`, and `ParseArgs` from `et171_flash.cc` into this file. Make sure to `#include \u003cgetopt.h\u003e`, `\u003ccharconv\u003e`, and `\u003cprint\u003e`.\n\n---\n\n### **Step 2: Extract File Utilities (`file_util`)**\n\nCreate `util/egis/file_util.h` and `util/egis/file_util.cc` for isolated disk I/O.\n\n**1. Create `file_util.h`:**\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#ifndef UTIL_EGIS_FILE_UTIL_H_\n#define UTIL_EGIS_FILE_UTIL_H_\n\n#include \u003ccstdint\u003e\n#include \u003cexpected\u003e\n#include \u003cspan\u003e\n#include \u003cstring_view\u003e\n#include \u003csystem_error\u003e\n#include \u003cvector\u003e\n\nnamespace egis {\n\nstd::expected\u003cstd::vector\u003cuint8_t\u003e, std::errc\u003e ReadBinaryFile(std::string_view path);\n\nstd::expected\u003cvoid, std::errc\u003e LoadAesKey(std::string_view key_file_path,\n                                          std::span\u003cuint8_t, 32\u003e key_buffer);\n\n}  // namespace egis\n\n#endif  // UTIL_EGIS_FILE_UTIL_H_\n\n```\n\n**2. Create `file_util.cc`:**\nMove the implementations of `ReadBinaryFile` and `LoadAesKey` here. Include `\u003cfstream\u003e`, `\"crypto_util.h\"`, and `\u003ccerrno\u003e`.\n\n---\n\n### **Step 3: Extract the Flashing Engine (`flasher_logic`)**\n\nCreate `util/egis/flasher_logic.h` and `util/egis/flasher_logic.cc` to hold the heavy lifting.\n\n**1. Create `flasher_logic.h`:**\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#ifndef UTIL_EGIS_FLASHER_LOGIC_H_\n#define UTIL_EGIS_FLASHER_LOGIC_H_\n\n#include \u003cexpected\u003e\n\n#include \"bootrom.h\"\n#include \"cli_options.h\"\n#include \"usb_comm.h\"\n\nnamespace egis {\n\nstd::expected\u003cvoid, AppError\u003e RunFlashFw(const AppConfig \u0026config,\n                                         BootromComm \u0026brom);\n\nstd::expected\u003cvoid, AppError\u003e RunFlashCmd(const AppConfig \u0026config,\n                                          UsbComm \u0026boot_comm);\n\n}  // namespace egis\n\n#endif  // UTIL_EGIS_FLASHER_LOGIC_H_\n\n```\n\n**2. Create `flasher_logic.cc`:**\nMove `RunFlashFw`, `RunFlashCmd`, `ProgramFlashPayload`, `ProgramRawCommandPayload`, and `GetNextPacketSize` here. *Note: Keep `GetNextPacketSize`, `ProgramFlashPayload`, and `ProgramRawCommandPayload` inside an anonymous `namespace { ... }` so they remain private to this translation unit.*\n\n---\n\n### **Step 4: Trim `et171_flash.cc**`\n\nNow, strip `et171_flash.cc` down to its core orchestrator role.\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n\n// C/C++ system files\n#include \u003cchrono\u003e\n#include \u003ccstdio\u003e\n#include \u003ccstdlib\u003e\n#include \u003cmemory\u003e\n#include \u003cprint\u003e\n#include \u003cthread\u003e\n\n// Project headers\n#include \"bootrom.h\"\n#include \"cli_options.h\"\n#include \"ec_comm.h\"\n#include \"ec_protocol_defs.h\"\n#include \"flasher_logic.h\"\n#include \"usb_comm.h\"\n\nnamespace egis {\n\nusing namespace std::chrono_literals;\n\n// ... [Keep ExecuteGetVersion here] ...\n// ... [Keep ExecuteBootLoader here] ...\n// ... [Keep ConnectToBootloader here] ...\n\n} // namespace egis\n\nint main(int argc, char *argv[]) {\n  // 1. Parse Arguments\n  auto config_opt \u003d egis::ParseArgs(argc, argv);\n  if (!config_opt) {\n    return EXIT_FAILURE;\n  }\n  const egis::AppConfig \u0026config \u003d config_opt.value();\n\n  // 2. Initialize USB Context\n  libusb_context *raw_ctx \u003d nullptr;\n  if (libusb_init(\u0026raw_ctx) !\u003d 0) {\n    std::println(stderr, \"[ERROR] Failed to initialize libusb\");\n    return EXIT_FAILURE;\n  }\n  std::unique_ptr\u003clibusb_context, decltype(\u0026libusb_exit)\u003e usb_ctx(raw_ctx, \u0026libusb_exit);\n\n  // 3. Connect to Device\n  egis::UsbComm boot_comm(usb_ctx.get(), egis::kVidEgis,\n                          egis::kPidEgisBootloader, egis::kBootloaderEpOut,\n                          egis::kBootloaderEpIn);\n  if (auto res \u003d egis::ConnectToBootloader(usb_ctx.get(), boot_comm); !res) {\n    std::println(stderr, \"[ERROR] Failed to connect: {}\", egis::ToString(res.error()));\n    return EXIT_FAILURE;\n  }\n  egis::BootromComm brom(boot_comm);\n  brom.SetWrappedAlgo(config.algo_type);\n\n  // 4. Dispatch to Flasher\n  std::expected\u003cvoid, egis::AppError\u003e status;\n  if (config.mode \u003d\u003d egis::AppMode::kFlashFw) {\n    status \u003d egis::RunFlashFw(config, brom);\n  } else if (config.mode \u003d\u003d egis::AppMode::kFlashCmd) {\n    status \u003d egis::RunFlashCmd(config, boot_comm);\n  }\n\n  if (status.has_value()) {\n    return EXIT_SUCCESS;\n  }\n  return EXIT_FAILURE;\n}\n\n```\n\n---\n\n### **Step 5: Update the Build System (`build.mk`)**\n\nFinally, you must tell `make` to compile the three new source files. Update `util/egis/build.mk` to include them in the object list.\n\n```makefile\n# In util/egis/build.mk\n\nhost-util-bin-cxx-y +\u003d et171_flash\net171_flash-objs :\u003d $(addprefix $(_cur_dir)/, \\\n    et171_flash.o \\\n    bootrom.o \\\n    usb_comm.o \\\n    ec_comm.o \\\n    crypto_util.o \\\n    cli_options.o \\     # \u003c-- Add this\n    file_util.o \\       # \u003c-- Add this\n    flasher_logic.o \\   # \u003c-- Add this\n)\n\n```",
