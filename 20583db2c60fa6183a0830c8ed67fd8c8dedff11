    response_data.insert(response_data.end(), additional.begin(),\n                         additional.end());\n  }\n\n  // USB bulk reads may return padded packets. Ensure we only return the exact\n  // payload length the EC specified in its header.\n  if (response_data.size() \u003e resp.data_len) {\n    response_data.resize(resp.data_len);\n  }\n\n  return response_data;\n}\n\n}  // namespace internal\n\n```\n\n**B. Update the callers:**\nPrefix the three calls to this function with `internal::`:\n\n```cpp\n// 1. Get build version string\nstd::expected\u003cstd::string, FtError\u003e GetBuildInfo(UsbDevice\u0026 device) {\n  auto data \u003d\n      internal::SendEcCommandAndReadResponse(device, EC_CMD_GET_BUILD_INFO, 0, {});\n// ...\n\n// 2. Switch to bootloader mode\nstd::expected\u003cvoid, FtError\u003e SwitchToBootloader(UsbDevice\u0026 device,\n                                                uint8_t mode) {\n// ...\n  auto data \u003d internal::SendEcCommandAndReadResponse(device, EC_CMD_ENTER_BOOTLOADER, 0,\n                                           params_span);\n// ...\n\n// 3. Switch to ROM mode using custom Focal command (only for test firmware)\nstd::expected\u003cvoid, FtError\u003e SwitchToRom(UsbDevice\u0026 device) {\n  auto data \u003d internal::SendEcCommandAndReadResponse(device, kTestEcSwitchToRomCmd, 0,\n                                           kSwitchToRomPayload);\n// ...\n\n```\n\n### 3. Update `util/focaltech/cli_test.cc`\n\nAdd the new test suite for internal logic right after the `DeviceInit` tests (or anywhere logically grouped with EC protocol tests):\n\n```cpp\n// -----------------------------------------------------------------------------\n// Internal EC protocol command tests\n// -----------------------------------------------------------------------------\nTEST(CliTest, SendEcCommandAndReadResponse_TruncatesPaddedUsbData) {\n  auto transport \u003d std::make_unique\u003cFakeEcTransport\u003e();\n  auto* fake \u003d transport.get();\n  UsbDevice device \u003d MakeDevice(std::move(transport));\n\n  // 1. Build a valid response with exactly 3 bytes of payload.\n  std::vector\u003cuint8_t\u003e packet \u003d\n      BuildEcResponse(EC_RES_SUCCESS, {0x01, 0x02, 0x03});\n\n  // 2. Simulate USB bulk endpoint behavior by padding it out to 64 bytes.\n  packet.resize(64, 0xAA);\n  fake-\u003eAddResponse(packet);\n\n  auto result \u003d internal::SendEcCommandAndReadResponse(device, 0x1234, 0);\n\n  ASSERT_TRUE(result.has_value());\n  // Expect exactly 3 bytes, proving the 53 bytes of padding were cleanly truncated.\n  EXPECT_THAT(*result, ElementsAre(0x01, 0x02, 0x03));\n}\n\n```",
