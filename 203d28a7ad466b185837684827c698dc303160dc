      "message": "[Gerrit AI Review] **Specify Exact Control Transfer Arguments Instead of Wildcard `_` Matchers:**\n\nIn `EnableDownloadSendsSetStatusWhenInactive` (lines 145–153), `control_transfer` expectations assert the exact protocol arguments (`kBmReqD2hStdDev, kRtsStdGetStatus, 0, 0, _, sizeof(uint8_t), kUsbCtrlTimeoutMs` and `kBmReqH2dStdDev, kRtsStdSetStatus, kRtsEnableDownloadMode, 0, nullptr, 0, kUsbCtrlTimeoutMs`). In the remaining `EnableDownload*` tests below, wildcard `_` matchers are used for the request type, request code, `wValue`, `wIndex`, length, and timeout. Please specify the exact expected control-transfer parameters (using `_` only for the local `\u0026status` output pointer):\n\n```cpp\nTEST_F(RtsUsbDeviceTest, EnableDownloadSkipsSetStatusWhenAlreadyActive)\n{\n\tEXPECT_CALL(*backend_, is_open()).WillOnce(Return(true));\n\tEXPECT_CALL(*backend_,\n\t\t    control_transfer(kBmReqD2hStdDev, kRtsStdGetStatus, 0, 0, _,\n\t\t\t\t    sizeof(uint8_t), kUsbCtrlTimeoutMs))\n\t\t.WillOnce(DoAll(SetArgPointee\u003c4\u003e(1), Return(1)));\n\n\tEXPECT_TRUE(device_-\u003eenable_download());\n}\n\nTEST_F(RtsUsbDeviceTest, EnableDownloadFailsOnGetStatusError)\n{\n\tEXPECT_CALL(*backend_, is_open()).WillOnce(Return(true));\n\tEXPECT_CALL(*backend_,\n\t\t    control_transfer(kBmReqD2hStdDev, kRtsStdGetStatus, 0, 0, _,\n\t\t\t\t    sizeof(uint8_t), kUsbCtrlTimeoutMs))\n\t\t.WillOnce(Return(-1));\n\n\tEXPECT_FALSE(device_-\u003eenable_download());\n}\n\nTEST_F(RtsUsbDeviceTest, EnableDownloadFailsOnGetStatusShortRead)\n{\n\tEXPECT_CALL(*backend_, is_open()).WillOnce(Return(true));\n\tEXPECT_CALL(*backend_,\n\t\t    control_transfer(kBmReqD2hStdDev, kRtsStdGetStatus, 0, 0, _,\n\t\t\t\t    sizeof(uint8_t), kUsbCtrlTimeoutMs))\n\t\t.WillOnce(Return(0));\n\n\tEXPECT_FALSE(device_-\u003eenable_download());\n}\n\nTEST_F(RtsUsbDeviceTest, EnableDownloadFailsOnSetStatusError)\n{\n\tInSequence seq;\n\n\tEXPECT_CALL(*backend_, is_open()).WillOnce(Return(true));\n\tEXPECT_CALL(*backend_,\n\t\t    control_transfer(kBmReqD2hStdDev, kRtsStdGetStatus, 0, 0, _,\n\t\t\t\t    sizeof(uint8_t), kUsbCtrlTimeoutMs))\n\t\t.WillOnce(DoAll(SetArgPointee\u003c4\u003e(0), Return(1)));\n\tEXPECT_CALL(*backend_,\n\t\t    control_transfer(kBmReqH2dStdDev, kRtsStdSetStatus,\n\t\t\t\t    kRtsEnableDownloadMode, 0, nullptr, 0,\n\t\t\t\t    kUsbCtrlTimeoutMs))\n\t\t.WillOnce(Return(-1));\n\n\tEXPECT_FALSE(device_-\u003eenable_download());\n}\n```\n\n[🔗](http://go/tj/594e9a3e-3b69-40fd-bca9-90bbce87b9e8)",
