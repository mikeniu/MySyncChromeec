      "writtenOn": "2026-09-24T02:59:15Z",
      "side": 1,
      "message": "Inserting a field in the middle of struct fuel_gauge_info alters the offsets of the subsequent fields (sleep_mode and fet). This struct is exposed via host commands, this will break backward compatibility with the host. Please append the new field to the end of the struct instead. Add support to the host command for this change.",
      "range": {
        "startLine": 8327,
        "startChar": 0,
        "endLine": 8327,
        "endChar": 0
      },
      "revId": "d77f9d166d41d0b6d5c20c97d0bd44efd1004ca6",
