      "writtenOn": "2026-09-17T03:11:58Z",
      "side": 1,
      "message": "this may be a legacy semantics thing, but shouldn\u0027t we\n`battery_cutoff_state \u003d BATTERY_CUTOFF_STATE_SCHEDULED`\nbased on the Kconfig description?",
      "range": {
        "startLine": 581,
        "startChar": 9,
        "endLine": 581,
        "endChar": 26
      },
      "revId": "33a7dbbca6885b28fa2f4204194ef6acc59d4687",
