    {
      "unresolved": true,
      "key": {
        "uuid": "94698058_5afab822",
        "filename": "common/battery.c",
        "patchSetId": 25
      },
      "lineNbr": 581,
      "author": {
        "id": 1530058
      },
      "writtenOn": "2026-09-17T17:59:16Z",
      "side": 1,
      "message": "This is existing legacy semantics from commit c4ec9ee779 (\"battery: Prevent CUTOFF_AT_SHUTDOWN when FORCE_CUTOFF_AT_SHUTDOWN is enabled\"). When `CONFIG_BATTERY_FORCE_CUTOFF_AT_SHUTDOWN` is enabled, the EC unconditionally cuts off battery during shutdown, so host requests attempting to schedule cutoff at shutdown are rejected with error. Leaving unchanged here to maintain behavioral parity in this migration CL.",
      "parentUuid": "77dfe2f7_cc4815f1",
      "range": {
        "startLine": 581,
        "startChar": 9,
        "endLine": 581,
        "endChar": 26
