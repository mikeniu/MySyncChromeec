      "side": 1,
      "message": "By applying the Fake pattern here, we can completely eliminate `\u003cgmock/gmock.h\u003e` from the file. The \"Sticky Response\" is perfect for orchestration tests: we just tell the Fake, \"always respond with a generic success packet,\" and the orchestrator can happily run through its entire state machine (disabling watchdogs, erasing, chunking, etc.) without us needing to mock every single transaction.\n\nHere is the fully simplified, mock-free `flasher_logic_test.cc`:\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#include \"flasher_logic.h\"\n\n#include \u003cgtest/gtest.h\u003e\n\n#include \u003carray\u003e\n#include \u003cfilesystem\u003e\n#include \u003cfstream\u003e\n#include \u003cstring\u003e\n#include \u003cutility\u003e\n#include \u003cvector\u003e\n\n#include \"bootrom.h\"\n#include \"fake_usb_comm.h\"\n\nnamespace egis {\nnamespace {\n\nclass FlasherLogicTest : public ::testing::Test {\n protected:\n  void SetUp() override {\n    fw_path_ \u003d std::filesystem::temp_directory_path() / \"test_fw.bin\";\n    \n    // Use the sticky response to simulate a completely compliant, happy device.\n    // It will constantly return a generic success packet for all operations,\n    // allowing the high-level logic to run uninterrupted.\n    BootromComm::SecureResponseHeader mock_hdr{\n        .status \u003d 0,\n        .payload_len \u003d ToLittleEndian(static_cast\u003cuint32_t\u003e(4))};\n    const auto mock_payload \u003d std::to_array\u003cuint8_t\u003e({0, 0, 0, 0});\n    \n    fake_usb_.SetStickyDeviceResponse(PackMessage(mock_hdr, mock_payload));\n  }\n\n  void TearDown() override { \n    if (std::filesystem::exists(fw_path_)) {\n      std::filesystem::remove(fw_path_); \n    }\n  }\n\n  void WriteTestFile(std::span\u003cconst uint8_t\u003e data) {\n    std::ofstream(fw_path_, std::ios::binary)\n        .write(reinterpret_cast\u003cconst char*\u003e(data.data()), data.size());\n  }\n\n  std::filesystem::path fw_path_;\n  FakeUsbComm fake_usb_;\n  BootromComm brom_{fake_usb_};\n};\n\n// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n// RunFlashFw (High-Level Firmware Flashing) Tests\n// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\nTEST_F(FlasherLogicTest, RunFlashFwInvalidArgs) {\n  AppConfig config;\n\n  // Missing FW Path\n  EXPECT_EQ(RunFlashFw(config, brom_).error(), AppError::kInvalidArgs);\n\n  // Missing Key Path when AES is requested\n  WriteTestFile(std::to_array\u003cuint8_t\u003e({0x01, 0x02}));\n  config.fw_path \u003d fw_path_.string();\n  config.algo_type \u003d EgisCryptoType::kAesGcm;\n  EXPECT_EQ(RunFlashFw(config, brom_).error(), AppError::kInvalidArgs);\n}\n\nTEST_F(FlasherLogicTest, RunFlashFwOversizedChunking) {\n  // Create an 80KB firmware file to force chunking \n  // (Max chunk is BootromComm::kMaxFlashWriteSize \u003d 32KB)\n  std::vector\u003cuint8_t\u003e large_fw(80 * 1024, 0xFF);\n  WriteTestFile(large_fw);\n\n  AppConfig config{\n      .fw_path \u003d fw_path_.string(),\n      .algo_type \u003d EgisCryptoType::kSha256,\n      .flash_offset \u003d 0x0000,\n  };\n\n  EXPECT_TRUE(RunFlashFw(config, brom_).has_value());\n  \n  // We expect exactly 10 transactions to occur during a full flash:\n  // Disable Watchdog (4) + Disable WP (2) + Erase (1) + Flash chunks (3)\n  EXPECT_EQ(fake_usb_.GetHostTransmissions().size(), 10);\n}\n\n// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n// RunFlashCmd (Raw Parser \u0026 Stream Flasher) Tests\n// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\nTEST_F(FlasherLogicTest, RunFlashCmdParserDataTooSmall) {\n  // A file with only 1 byte cannot possibly contain a valid header\n  WriteTestFile(std::to_array\u003cuint8_t\u003e({EgisBootrom::kCmdSecureWrapped}));\n\n  AppConfig config{.mode \u003d AppMode::kFlashCmd, .fw_path \u003d fw_path_.string()};\n  EXPECT_EQ(RunFlashCmd(config, fake_usb_).error(), AppError::kParseError);\n}\n\nTEST_F(FlasherLogicTest, RunFlashCmdParserInvalidHeader) {\n  // Not a System Reset (0x12) or Secure Wrapped (0xF4) command\n  WriteTestFile(std::to_array\u003cuint8_t\u003e({0xFF, 0x00, 0x00, 0x00}));\n\n  AppConfig config{.mode \u003d AppMode::kFlashCmd, .fw_path \u003d fw_path_.string()};\n  EXPECT_EQ(RunFlashCmd(config, fake_usb_).error(), AppError::kParseError);\n}\n\nTEST_F(FlasherLogicTest, RunFlashCmdParserTruncatedPayload) {\n  // Valid AES header, claims payload length is 100 bytes, but file ends early\n  BootromComm::SecureCommandAesHeader hdr{\n      .algo \u003d std::to_underlying(EgisCryptoType::kAesGcm),\n      .payload_len \u003d ToLittleEndian(static_cast\u003cuint32_t\u003e(100))};\n  \n  WriteTestFile(AsBytes(hdr));\n\n  AppConfig config{.mode \u003d AppMode::kFlashCmd, .fw_path \u003d fw_path_.string()};\n  EXPECT_EQ(RunFlashCmd(config, fake_usb_).error(), AppError::kParseError);\n}\n\nTEST_F(FlasherLogicTest, RunFlashCmdSuccessReset) {\n  // System Reset is a special case: 2 bytes, no response expected\n  WriteTestFile(std::to_array\u003cuint8_t\u003e({EgisBootrom::kCmdSystemReset, \n                                        EgisBootrom::kSystemResetTypeNormal}));\n\n  AppConfig config{.mode \u003d AppMode::kFlashCmd, .fw_path \u003d fw_path_.string()};\n  \n  EXPECT_TRUE(RunFlashCmd(config, fake_usb_).has_value());\n  EXPECT_EQ(fake_usb_.GetHostTransmissions().size(), 1);\n}\n\nTEST_F(FlasherLogicTest, RunFlashCmdDeviceErrorHalt) {\n  // Construct a valid SHA header claiming a 4-byte payload\n  BootromComm::SecureCommandShaHeader hdr{\n      .algo \u003d std::to_underlying(EgisCryptoType::kSha256),\n      .payload_len \u003d ToLittleEndian(static_cast\u003cuint32_t\u003e(4))};\n  \n  auto valid_packet \u003d PackMessage(hdr, std::to_array\u003cuint8_t\u003e({1, 2, 3, 4}));\n  WriteTestFile(valid_packet);\n\n  AppConfig config{.mode \u003d AppMode::kFlashCmd, .fw_path \u003d fw_path_.string()};\n\n  // Clear the sticky success response, and push an explicit error response (0x0001)\n  fake_usb_.Reset();\n  uint16_t error_status \u003d ToLittleEndian(static_cast\u003cuint16_t\u003e(1));\n  fake_usb_.PushDeviceResponse(AsBytes(error_status));\n\n  // The logic must detect the non-zero status and abort with kBootromError\n  EXPECT_EQ(RunFlashCmd(config, fake_usb_).error(), AppError::kBootromError);\n}\n\n}  // namespace\n}  // namespace egis\n\n```\n\n### Why This is Better\n\n1. **Zero Mocks:** We have completely removed Google Mock and its verbose `EXPECT_CALL` syntax.\n2. **Deterministic Validation:** Instead of setting up expectations beforehand, we run the code and simply assert against `fake_usb_.GetHostTransmissions().size()` afterward.\n3. **Readability:** The `RunFlashCmdDeviceErrorHalt` test is much easier to understand. We `Reset()` the fake to clear the default success state, push an error byte, and assert that it failed.",
