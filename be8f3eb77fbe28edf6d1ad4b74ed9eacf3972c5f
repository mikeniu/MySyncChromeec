      "message": "Let\u0027s add additional tests to get coverage for all of the functions in the source file. Here\u0027s Gemini-generated code. Review it for correctness and completeness:\n\n---\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#include \"crypto_util.h\"\n\n#include \u003cgtest/gtest.h\u003e\n#include \u003copenssl/sha.h\u003e\n\n#include \u003calgorithm\u003e\n#include \u003carray\u003e\n#include \u003cranges\u003e\n#include \u003cvector\u003e\n\nnamespace egis {\nnamespace {\n\nconstexpr auto kTestKey \u003d std::to_array\u003cuint8_t\u003e({\n    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, \n    0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, \n    0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f\n});\n\nconstexpr auto kTestPlaintext \u003d std::to_array\u003cuint8_t\u003e({\n    \u0027C\u0027, \u0027h\u0027, \u0027r\u0027, \u0027o\u0027, \u0027m\u0027, \u0027i\u0027, \u0027u\u0027, \u0027m\u0027, \u0027O\u0027, \u0027S\u0027\n});\n\nconstexpr auto kTestAad \u003d std::to_array\u003cuint8_t\u003e({\n    0xAA, 0xBB, 0xCC, 0xDD\n});\n\nTEST(CryptoUtilTest, Sha256KnownValue) {\n  const auto data \u003d std::to_array\u003cuint8_t\u003e({\u0027a\u0027, \u0027b\u0027, \u0027c\u0027});\n  \n  // SHA256(\"abc\") -\u003e ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n  const auto kExpectedHash \u003d std::to_array\u003cuint8_t\u003e({\n      0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,\n      0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,\n      0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,\n      0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad\n  });\n\n  std::array\u003cuint8_t, SHA256_DIGEST_LENGTH\u003e hash{};\n  crypto::Sha256(data, hash);\n\n  EXPECT_EQ(kExpectedHash, hash);\n}\n\nTEST(CryptoUtilTest, GenerateGcmIvSanityCheck) {\n  std::array\u003cuint8_t, crypto::kAesGcmIvSize\u003e iv1{};\n  std::array\u003cuint8_t, crypto::kAesGcmIvSize\u003e iv2{};\n\n  ASSERT_TRUE(crypto::GenerateGcmIv(iv1).has_value());\n  ASSERT_TRUE(crypto::GenerateGcmIv(iv2).has_value());\n\n  // It is cryptographically improbable (1 in 2^96) for two generated IVs to match,\n  // or for an IV to be entirely zeroes if the RNG is working correctly.\n  auto all_zeros \u003d std::to_array\u003cuint8_t, crypto::kAesGcmIvSize\u003e({});\n  EXPECT_NE(iv1, all_zeros);\n  EXPECT_NE(iv1, iv2);\n}\n\nTEST(CryptoUtilTest, AesGcmRoundTripWithAad) {\n  std::array\u003cuint8_t, crypto::kAesGcmIvSize\u003e iv{};\n  ASSERT_TRUE(crypto::GenerateGcmIv(iv).has_value());\n\n  std::vector\u003cuint8_t\u003e ciphertext(kTestPlaintext.size());\n  std::array\u003cuint8_t, crypto::kAesGcmTagSize\u003e tag{};\n\n  // 1. Encrypt\n  auto enc_res \u003d crypto::AesGcmEncrypt(kTestKey, iv, kTestAad, kTestPlaintext, \n                                       ciphertext, tag);\n  ASSERT_TRUE(enc_res.has_value());\n\n  // 2. Decrypt\n  std::array\u003cuint8_t, kTestPlaintext.size()\u003e decrypted{};\n  auto dec_res \u003d crypto::AesGcmDecrypt(kTestKey, iv, kTestAad, ciphertext, \n                                       tag, decrypted);\n  ASSERT_TRUE(dec_res.has_value());\n\n  // 3. Verify\n  EXPECT_EQ(kTestPlaintext, decrypted);\n}\n\nTEST(CryptoUtilTest, AesGcmRoundTripWithoutAad) {\n  std::array\u003cuint8_t, crypto::kAesGcmIvSize\u003e iv{};\n  ASSERT_TRUE(crypto::GenerateGcmIv(iv).has_value());\n\n  std::vector\u003cuint8_t\u003e ciphertext(kTestPlaintext.size());\n  std::array\u003cuint8_t, crypto::kAesGcmTagSize\u003e tag{};\n\n  // Encrypt with empty AAD\n  ASSERT_TRUE(crypto::AesGcmEncrypt(kTestKey, iv, {}, kTestPlaintext, \n                                    ciphertext, tag).has_value());\n\n  // Decrypt with empty AAD\n  std::array\u003cuint8_t, kTestPlaintext.size()\u003e decrypted{};\n  ASSERT_TRUE(crypto::AesGcmDecrypt(kTestKey, iv, {}, ciphertext, \n                                    tag, decrypted).has_value());\n\n  EXPECT_EQ(kTestPlaintext, decrypted);\n}\n\nTEST(CryptoUtilTest, AesGcmFailsOnTagTampering) {\n  std::array\u003cuint8_t, crypto::kAesGcmIvSize\u003e iv{};\n  ASSERT_TRUE(crypto::GenerateGcmIv(iv).has_value());\n\n  std::vector\u003cuint8_t\u003e ciphertext(kTestPlaintext.size());\n  std::array\u003cuint8_t, crypto::kAesGcmTagSize\u003e tag{};\n\n  ASSERT_TRUE(crypto::AesGcmEncrypt(kTestKey, iv, kTestAad, kTestPlaintext, \n                                    ciphertext, tag).has_value());\n\n  // Corrupt the tag\n  tag[0] ^\u003d 0xFF;\n\n  std::array\u003cuint8_t, kTestPlaintext.size()\u003e decrypted{};\n  auto dec_res \u003d crypto::AesGcmDecrypt(kTestKey, iv, kTestAad, ciphertext, \n                                       tag, decrypted);\n  \n  ASSERT_FALSE(dec_res.has_value());\n  EXPECT_EQ(dec_res.error(), crypto::CryptoError::kTagMismatch);\n}\n\nTEST(CryptoUtilTest, AesGcmFailsOnCiphertextTampering) {\n  std::array\u003cuint8_t, crypto::kAesGcmIvSize\u003e iv{};\n  ASSERT_TRUE(crypto::GenerateGcmIv(iv).has_value());\n\n  std::vector\u003cuint8_t\u003e ciphertext(kTestPlaintext.size());\n  std::array\u003cuint8_t, crypto::kAesGcmTagSize\u003e tag{};\n\n  ASSERT_TRUE(crypto::AesGcmEncrypt(kTestKey, iv, kTestAad, kTestPlaintext, \n                                    ciphertext, tag).has_value());\n\n  // Corrupt the ciphertext\n  ciphertext[0] ^\u003d 0xFF;\n\n  std::array\u003cuint8_t, kTestPlaintext.size()\u003e decrypted{};\n  auto dec_res \u003d crypto::AesGcmDecrypt(kTestKey, iv, kTestAad, ciphertext, \n                                       tag, decrypted);\n  \n  ASSERT_FALSE(dec_res.has_value());\n  EXPECT_EQ(dec_res.error(), crypto::CryptoError::kTagMismatch);\n}\n\nTEST(CryptoUtilTest, AesGcmFailsOnAadTampering) {\n  std::array\u003cuint8_t, crypto::kAesGcmIvSize\u003e iv{};\n  ASSERT_TRUE(crypto::GenerateGcmIv(iv).has_value());\n\n  std::vector\u003cuint8_t\u003e ciphertext(kTestPlaintext.size());\n  std::array\u003cuint8_t, crypto::kAesGcmTagSize\u003e tag{};\n\n  ASSERT_TRUE(crypto::AesGcmEncrypt(kTestKey, iv, kTestAad, kTestPlaintext, \n                                    ciphertext, tag).has_value());\n\n  // Use incorrect AAD during decryption\n  auto bad_aad \u003d std::to_array\u003cuint8_t\u003e({0xDE, 0xAD, 0xBE, 0xEF});\n\n  std::array\u003cuint8_t, kTestPlaintext.size()\u003e decrypted{};\n  auto dec_res \u003d crypto::AesGcmDecrypt(kTestKey, iv, bad_aad, ciphertext, \n                                       tag, decrypted);\n  \n  ASSERT_FALSE(dec_res.has_value());\n  EXPECT_EQ(dec_res.error(), crypto::CryptoError::kTagMismatch);\n}\n\nTEST(CryptoUtilTest, CleanseZeroesBuffer) {\n  auto sensitive_data \u003d std::to_array\u003cuint8_t\u003e({0xDE, 0xAD, 0xBE, 0xEF});\n  const auto expected_zeros \u003d std::to_array\u003cuint8_t\u003e({0x00, 0x00, 0x00, 0x00});\n\n  crypto::Cleanse(sensitive_data);\n\n  EXPECT_EQ(expected_zeros, sensitive_data);\n}\n\n}  // namespace\n}  // namespace egis\n\n```",
