      "message": "Here\u0027s an updated version that may be a bit simpler:\n\n-----\nThe only reason we kept the Mock was for the `FlashReadyTimeout` test, which requires simulating a stuck hardware device that responds with the same \"Work In Progress\" (WIP) bytes indefinitely (for 500 polling iterations).\n\nWe can completely eliminate `gmock` from `bootrom_test.cc` by adding a tiny, single-purpose feature to our Fake: a **Sticky Response**.\n\nIf we tell the Fake to be \"sticky,\" it will return the exact same packet forever when its queue is empty. This perfectly simulates a hung SPI flash chip and lets us drop the Mock dependency entirely.\n\nHere is the final, ultra-simplified architecture.\n\n### 1. The Ultimate `fake_usb_comm.h`\n\nWe add a `SetStickyDeviceResponse` method.\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#ifndef UTIL_EGIS_FAKE_USB_COMM_H_\n#define UTIL_EGIS_FAKE_USB_COMM_H_\n\n#include \u003calgorithm\u003e\n#include \u003cqueue\u003e\n#include \u003cspan\u003e\n#include \u003cvector\u003e\n\n#include \"usb_interface.h\"\n\nnamespace egis {\n\nclass FakeUsbComm : public UsbInterface {\n public:\n  // Push a one-time packet into the device-to-host FIFO queue\n  void PushDeviceResponse(std::span\u003cconst uint8_t\u003e data) {\n    device_to_host_.push(std::vector\u003cuint8_t\u003e(data.begin(), data.end()));\n  }\n\n  // Set a packet that will be returned indefinitely if the queue is empty\n  void SetStickyDeviceResponse(std::span\u003cconst uint8_t\u003e data) {\n    sticky_response_ \u003d std::vector\u003cuint8_t\u003e(data.begin(), data.end());\n  }\n\n  const std::vector\u003cstd::vector\u003cuint8_t\u003e\u003e\u0026 GetHostTransmissions() const {\n    return host_to_device_;\n  }\n\n  void Reset() {\n    device_to_host_ \u003d {};\n    host_to_device_.clear();\n    sticky_response_.clear();\n  }\n\n  // --- UsbInterface Implementation ---\n  \n  std::expected\u003cvoid, UsbError\u003e Connect() override { return {}; }\n\n  std::expected\u003cvoid, UsbError\u003e Send(\n      std::span\u003cconst uint8_t\u003e data,\n      std::chrono::milliseconds /*timeout*/) override {\n    host_to_device_.push_back(std::vector\u003cuint8_t\u003e(data.begin(), data.end()));\n    return {};\n  }\n\n  std::expected\u003cint, UsbError\u003e Receive(\n      std::span\u003cuint8_t\u003e data,\n      std::chrono::milliseconds /*timeout*/) override {\n    \n    // 1. Drain the normal queue first\n    if (!device_to_host_.empty()) {\n      auto\u0026 next_packet \u003d device_to_host_.front();\n      size_t copy_size \u003d std::min(data.size(), next_packet.size());\n      std::ranges::copy(std::span(next_packet).first(copy_size), data.begin());\n      \n      next_packet.erase(next_packet.begin(), next_packet.begin() + copy_size);\n      if (next_packet.empty()) device_to_host_.pop();\n      return static_cast\u003cint\u003e(copy_size);\n    }\n    \n    // 2. If empty but sticky is set, return the sticky packet indefinitely\n    if (!sticky_response_.empty()) {\n      size_t copy_size \u003d std::min(data.size(), sticky_response_.size());\n      std::ranges::copy(std::span(sticky_response_).first(copy_size), data.begin());\n      return static_cast\u003cint\u003e(copy_size);\n    }\n\n    // 3. Otherwise, device is silent\n    return std::unexpected(UsbError::kTimeout);\n  }\n\n private:\n  std::queue\u003cstd::vector\u003cuint8_t\u003e\u003e device_to_host_;\n  std::vector\u003cstd::vector\u003cuint8_t\u003e\u003e host_to_device_;\n  std::vector\u003cuint8_t\u003e sticky_response_;\n};\n\n}  // namespace egis\n\n#endif  // UTIL_EGIS_FAKE_USB_COMM_H_\n\n```\n\n### 2. The 100% Mock-Free `bootrom_test.cc`\n\nNotice that `\u003cgmock/gmock.h\u003e` is completely gone. The `FlashReadyTimeout` test at the bottom is now just 6 lines of code.\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#include \"bootrom.h\"\n\n#include \u003cgtest/gtest.h\u003e\n\n#include \u003calgorithm\u003e\n#include \u003carray\u003e\n#include \u003cvector\u003e\n\n#include \"fake_usb_comm.h\"\n\nnamespace egis {\nnamespace {\n\nconstexpr uint32_t kTestVersion \u003d 0x01020304;\nconstexpr uint32_t kTestMaxCmdSize \u003d 1024;\nconstexpr uint32_t kTestMaxFwUpgradeSize \u003d 2048;\nconstexpr uint8_t kTestKeyFillValue \u003d 0x77;\n\nconstexpr auto kTestPlaintext \u003d std::to_array\u003cuint8_t\u003e({0x11, 0x22, 0x33, 0x44});\n\nclass BootromCommTest : public ::testing::Test {\n protected:\n  void SetUp() override {\n    test_key_.fill(kTestKeyFillValue);\n    brom_.SetWrappedAlgo(EgisCryptoType::kAesGcm);\n    brom_.SetAesKey(test_key_);\n  }\n\n  std::vector\u003cuint8_t\u003e MakeMockAesResponse(std::span\u003cconst uint8_t\u003e plaintext, \n                                           bool corrupt_tag \u003d false) {\n    std::array\u003cuint8_t, crypto::kAesGcmIvSize\u003e iv{};\n    std::array\u003cuint8_t, crypto::kAesGcmTagSize\u003e tag{};\n    std::vector\u003cuint8_t\u003e ciphertext(plaintext.size());\n    uint32_t aad \u003d ToLittleEndian(EgisBootrom::kChipIdAad);\n\n    EXPECT_TRUE(crypto::GenerateGcmIv(iv).has_value());\n    EXPECT_TRUE(crypto::AesGcmEncrypt(test_key_, iv, AsBytes(aad), \n                                      plaintext, ciphertext, tag).has_value());\n\n    if (corrupt_tag) tag[0] ^\u003d 0xFF;\n\n    BootromComm::SecureResponseHeader hdr{\n        .status \u003d 0,\n        .payload_len \u003d ToLittleEndian(static_cast\u003cuint32_t\u003e(ciphertext.size()))};\n\n    auto resp_packet \u003d PackMessage(hdr, iv);\n    resp_packet.insert(resp_packet.end(), tag.begin(), tag.end());\n    resp_packet.insert(resp_packet.end(), ciphertext.begin(), ciphertext.end());\n    return resp_packet;\n  }\n\n  std::vector\u003cuint8_t\u003e MakeMockShaResponse(std::span\u003cconst uint8_t\u003e payload) {\n    BootromComm::SecureResponseHeader hdr{\n        .status \u003d 0,\n        .payload_len \u003d ToLittleEndian(static_cast\u003cuint32_t\u003e(payload.size()))};\n    return PackMessage(hdr, payload);\n  }\n\n  FakeUsbComm fake_usb_;\n  BootromComm brom_{fake_usb_};\n  std::array\u003cuint8_t, crypto::kAes256KeySize\u003e test_key_{};\n};\n\nTEST_F(BootromCommTest, GetBootromInfoSuccess) {\n  brom_.SetWrappedAlgo(EgisCryptoType::kSha256);\n\n  EgisBootrom::BootromInfoResponse info{\n      .version \u003d ToLittleEndian(kTestVersion),\n      .max_cmd_size \u003d ToLittleEndian(kTestMaxCmdSize),\n      .max_fw_upgrade_size \u003d ToLittleEndian(kTestMaxFwUpgradeSize)};\n  \n  uint16_t status \u003d 0;\n  fake_usb_.PushDeviceResponse(PackMessage(status, AsBytes(info)));\n\n  auto res \u003d brom_.GetBootromInfo();\n  ASSERT_TRUE(res.has_value());\n  EXPECT_EQ(res-\u003eversion, kTestVersion);\n}\n\nTEST_F(BootromCommTest, SecureCommandAesSuccess) {\n  EgisBootrom::MemReadCommand read_cmd{\n      .address \u003d ToLittleEndian(EgisBootrom::kFlashBaseAddr),\n      .access_size \u003d EgisBootrom::kAccessSizeUint8,\n      .count \u003d ToLittleEndian(static_cast\u003cuint32_t\u003e(kTestPlaintext.size()))};\n\n  fake_usb_.PushDeviceResponse(MakeMockAesResponse(kTestPlaintext));\n\n  auto res \u003d brom_.SendStruct(read_cmd);\n\n  ASSERT_TRUE(res.has_value());\n  EXPECT_TRUE(std::ranges::equal(kTestPlaintext, res.value()));\n  EXPECT_EQ(fake_usb_.GetHostTransmissions().size(), 1);\n}\n\nTEST_F(BootromCommTest, SecureCommandAesAuthenticationFailure) {\n  EgisBootrom::MemReadCommand read_cmd{\n      .address \u003d ToLittleEndian(EgisBootrom::kFlashBaseAddr),\n      .access_size \u003d EgisBootrom::kAccessSizeUint8,\n      .count \u003d ToLittleEndian(static_cast\u003cuint32_t\u003e(kTestPlaintext.size()))};\n\n  fake_usb_.PushDeviceResponse(MakeMockAesResponse(kTestPlaintext, /*corrupt_tag\u003d*/true));\n\n  auto res \u003d brom_.SendStruct(read_cmd);\n\n  ASSERT_FALSE(res.has_value());\n  EXPECT_EQ(res.error(), BootromError::kGcmAuthenticationFailed);\n}\n\nTEST_F(BootromCommTest, SendBootromCommandEmptyBuffer) {\n  auto res \u003d brom_.SendStruct(std::span\u003cconst uint8_t\u003e{});\n  ASSERT_FALSE(res.has_value());\n  EXPECT_EQ(res.error(), BootromError::kBufferTooSmall);\n}\n\nTEST_F(BootromCommTest, WriteFlashExceedsLimit) {\n  std::vector\u003cuint8_t\u003e massive_payload(BootromComm::kMaxFlashWriteSize + 1, 0xFF);\n  auto res \u003d brom_.WriteFlash(0x0000, massive_payload);\n  \n  ASSERT_FALSE(res.has_value());\n  EXPECT_EQ(res.error(), BootromError::kPayloadSizeExceedsLimit);\n}\n\nTEST_F(BootromCommTest, ReadFlashChunking) {\n  brom_.SetWrappedAlgo(EgisCryptoType::kSha256);\n  const uint32_t total_size \u003d BootromComm::kMaxFlashReadSize + 1024; // 5KB total\n\n  std::vector\u003cuint8_t\u003e chunk1(BootromComm::kMaxFlashReadSize, 0xAA);\n  std::vector\u003cuint8_t\u003e chunk2(1024, 0xBB);\n  \n  fake_usb_.PushDeviceResponse(MakeMockShaResponse(chunk1));\n  fake_usb_.PushDeviceResponse(MakeMockShaResponse(chunk2));\n\n  auto res \u003d brom_.ReadFlash(0x0000, total_size);\n  \n  ASSERT_TRUE(res.has_value());\n  EXPECT_EQ(res.value().size(), total_size);\n  EXPECT_EQ(res.value()[0], 0xAA);\n  EXPECT_EQ(res.value()[BootromComm::kMaxFlashReadSize], 0xBB);\n  EXPECT_EQ(fake_usb_.GetHostTransmissions().size(), 2);\n}\n\nTEST_F(BootromCommTest, FlashReadyTimeout) {\n  brom_.SetWrappedAlgo(EgisCryptoType::kSha256);\n\n  // Set the fake to infinitely return a \"Work In Progress\" bit\n  uint32_t stuck_sr1 \u003d EgisBootrom::kFlashSr1Wip;\n  fake_usb_.SetStickyDeviceResponse(\n      MakeMockShaResponse(AsBytes(ToLittleEndian(stuck_sr1))));\n\n  // Attempt to clear Write Protect; it will hang polling the Fake until timeout\n  auto res \u003d brom_.DisableWp();\n  \n  ASSERT_FALSE(res.has_value());\n  EXPECT_EQ(res.error(), BootromError::kFlashReadyTimeout);\n}\n\n}  // namespace\n}  // namespace egis\n\n```",
