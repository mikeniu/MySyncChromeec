      "message": "### 1\\. ff\\_log.h\n\n* **Replaces:** focaltech/include/ff\\_log.h, focaltech/src/ff\\_util.c  \n* **What Changed:** Replaced vsnprintf and variable arguments (va\\_list) with C++23 std::print. Replaced the **FILE** and **LINE** preprocessor macros with std::source\\_location.  \n* **Rationale:** Standard C varargs are type-unsafe and can crash if format specifiers mismatch. std::print checks formats at compile time and eliminates buffer overflow risks by removing the hardcoded LOG\\_BUF\\_SIZE.\n\n```c\n#ifndef UTIL_FOCALTECH_FF_LOG_H_\n#define UTIL_FOCALTECH_FF_LOG_H_\n\n#include \u003cchrono\u003e\n#include \u003cprint\u003e\n#include \u003csource_location\u003e\n#include \u003cstring_view\u003e\n\nenum class LogLevel {\n  kVerbose,\n  kDebug,\n  kInfo,\n  kWarning,\n  kError,\n};\n\nconstexpr LogLevel kCurrentLogLevel \u003d LogLevel::kDebug;\n\ntemplate \u003ctypename... Args\u003e\nvoid FfLog(LogLevel level, std::format_string\u003cArgs...\u003e fmt, Args\u0026\u0026... args,\n           const std::source_location loc \u003d std::source_location::current()) {\n  if (level \u003c kCurrentLogLevel) {\n    return;\n  }\n\n  auto now \u003d std::chrono::system_clock::now();\n  std::string_view level_str;\n  std::string_view color;\n  std::string_view reset \u003d \"\\033[0m\";\n\n  switch (level) {\n    case LogLevel::kVerbose:\n      level_str \u003d \"V\";\n      color \u003d \"\";\n      break;\n    case LogLevel::kDebug:\n      level_str \u003d \"D\";\n      color \u003d \"\";\n      break;\n    case LogLevel::kInfo:\n      level_str \u003d \"I\";\n      color \u003d \"\\033[36m\";\n      break;\n    case LogLevel::kWarning:\n      level_str \u003d \"W\";\n      color \u003d \"\\033[33m\";\n      break;\n    case LogLevel::kError:\n      level_str \u003d \"E\";\n      color \u003d \"\\033[31m\";\n      break;\n  }\n\n  // Extract filename from the path.\n  std::string_view file \u003d loc.file_name();\n  if (auto pos \u003d file.find_last_of(\u0027/\u0027); pos !\u003d std::string_view::npos) {\n    file \u003d file.substr(pos + 1);\n  }\n\n  std::print(\"{}[{:%m-%d %H:%M:%S}] {} [{}:{}] \", color, now, level_str, file,\n             loc.line());\n  std::println(fmt, std::forward\u003cArgs\u003e(args)...);\n\n  if (!color.empty()) {\n    std::print(\"{}\", reset);\n  }\n}\n\n// Convenience macros for standardizing call sites.\n#define LOGE(...) FfLog(LogLevel::kError, __VA_ARGS__)\n#define LOGW(...) FfLog(LogLevel::kWarning, __VA_ARGS__)\n#define LOGI(...) FfLog(LogLevel::kInfo, __VA_ARGS__)\n#define LOGD(...) FfLog(LogLevel::kDebug, __VA_ARGS__)\n#define LOGV(...) FfLog(LogLevel::kVerbose, __VA_ARGS__)\n\n#endif  // UTIL_FOCALTECH_FF_LOG_H_\n\n```\n\n---\n\n### 2\\. ff\\_util.h\n\n* **Replaces:** focaltech/include/ff\\_util.h  \n* **What Changed:** Converted ft\\_div\\_round\\_up from a standard C inline function taking uint32\\_t to a constexpr C++ template.  \n* **Rationale:** Templates enforce type safety across varying integer sizes natively. The constexpr keyword allows the compiler to evaluate static divisions at compile time, eliminating runtime overhead.\n\n```c\n#ifndef UTIL_FOCALTECH_FF_UTIL_H_\n#define UTIL_FOCALTECH_FF_UTIL_H_\n\n#include \u003ccassert\u003e\n\ntemplate \u003ctypename T\u003e\nconstexpr T FtDivRoundUp(T n, T d) {\n  assert(d !\u003d 0);\n  return (n + d - 1) / d;\n}\n\n#endif  // UTIL_FOCALTECH_FF_UTIL_H_\n\n```\n\n---\n\n### 3\\. usb\\_context.h\n\n* **Replaces:** Distributed struct definitions in net\\_usb.h and ff\\_sg\\_io.h.  \n* **What Changed:** Wraps libusb handles in std::unique\\_ptr with custom deleters. Replaces \\-1 integer returns with std::expected\\\u003cT, FtError\\\u003e.  \n* **Rationale:** The original code required calling ft\\_usb\\_free() at every exit point, leading to bugs when developers forgot. RAII (Resource Acquisition Is Initialization) guarantees deterministic cleanup when objects go out of scope.\n\n```c\n#ifndef UTIL_FOCALTECH_USB_CONTEXT_H_\n#define UTIL_FOCALTECH_USB_CONTEXT_H_\n\n#include \u003clibusb-1.0/libusb.h\u003e\n\n#include \u003ccstdint\u003e\n#include \u003cexpected\u003e\n#include \u003cmemory\u003e\n\nenum class FtError {\n  kSuccess,\n  kNoSuchDevice,\n  kParameterError,\n  kNoSuchFile,\n  kResultFail,\n};\n\nstruct LibusbContextDeleter {\n  void operator()(libusb_context* ctx) const {\n    if (ctx !\u003d nullptr) {\n      libusb_exit(ctx);\n    }\n  }\n};\n\nstruct LibusbDeviceHandleDeleter {\n  void operator()(libusb_device_handle* handle) const {\n    if (handle !\u003d nullptr) {\n      libusb_close(handle);\n    }\n  }\n};\n\nclass UsbContext {\n public:\n  UsbContext() {\n    libusb_context* ctx \u003d nullptr;\n    if (libusb_init(\u0026ctx) \u003d\u003d LIBUSB_SUCCESS) {\n      ctx_.reset(ctx);\n    }\n  }\n\n  [[nodiscard]] bool IsValid() const { return ctx_ !\u003d nullptr; }\n  libusb_context* get() const { return ctx_.get(); }\n\n private:\n  std::unique_ptr\u003clibusb_context, LibusbContextDeleter\u003e ctx_;\n};\n\nstruct UsbConnectionDetails {\n  uint16_t vid \u003d 0;\n  uint16_t pid \u003d 0;\n  uint8_t interface_num \u003d 0;\n  uint8_t ep_bulk_in \u003d 0;\n  uint8_t ep_bulk_out \u003d 0;\n};\n\nclass UsbDevice {\n public:\n  static std::expected\u003cUsbDevice, FtError\u003e Create(\n      const UsbContext\u0026 ctx, UsbConnectionDetails\u0026 out_details);\n\n  libusb_device_handle* get() const { return handle_.get(); }\n\n  void ReleaseInterface(int interface_num) {\n    if (handle_) {\n      libusb_release_interface(handle_.get(), interface_num);\n    }\n  }\n\n private:\n  explicit UsbDevice(libusb_device_handle* handle) : handle_(handle) {}\n\n  std::unique_ptr\u003clibusb_device_handle, LibusbDeviceHandleDeleter\u003e handle_;\n};\n\n#endif  // UTIL_FOCALTECH_USB_CONTEXT_H_\n\n```\n\n---\n\n### 4\\. usb\\_device.cc\n\n* **Replaces:** focaltech/src/net\\_usb.c  \n* **What Changed:** Consolidated ft\\_usb\\_exist and ft\\_usb\\_connect into the UsbDevice::Create() factory. Replaced global state (g\\_no\\_device\\_flag) and async hotplug callbacks with a synchronous connection flow.  \n* **Rationale:** The original file suffered from global state mutations and a broken hotplug callback that passed NULL as user data. The new approach is stateless, predictable, and cleans up the device list cleanly via ScopedDeviceList.\n\n```c\n#include \"usb_context.h\"\n\n#include \u003cvector\u003e\n\n#include \"ff_log.h\"\n\nnamespace {\n\nconstexpr uint16_t kFocalRomVid \u003d 0x2FD0;\nconstexpr uint16_t kFocalBootVid \u003d 0x2808;\nconstexpr uint16_t kFocalEcVid \u003d 0x18D1;\n\nconstexpr uint16_t kFocalEcPidTest \u003d 0xFACE;\nconstexpr uint16_t kFocalEcPid9865 \u003d 0x5403;\nconstexpr uint16_t kFocalEcPid9869 \u003d 0x5404;\n\nstruct LibusbDeviceListDeleter {\n  void operator()(libusb_device** list) const {\n    if (list !\u003d nullptr) {\n      libusb_free_device_list(list, /*unref_devices\u003d*/1);\n    }\n  }\n};\n\nusing ScopedDeviceList \u003d\n    std::unique_ptr\u003clibusb_device*, LibusbDeviceListDeleter\u003e;\n\n}  // namespace\n\nstd::expected\u003cUsbDevice, FtError\u003e UsbDevice::Create(\n    const UsbContext\u0026 ctx, UsbConnectionDetails\u0026 out_details) {\n  libusb_device** list_raw \u003d nullptr;\n  ssize_t count \u003d libusb_get_device_list(ctx.get(), \u0026list_raw);\n  if (count \u003c 0) {\n    LOGE(\"Failed to get USB device list: {}\", libusb_error_name(count));\n    return std::unexpected(FtError::kNoSuchDevice);\n  }\n\n  ScopedDeviceList dev_list(list_raw);\n  libusb_device* target_dev \u003d nullptr;\n  libusb_device_descriptor target_desc{};\n\n  for (ssize_t i \u003d 0; i \u003c count; ++i) {\n    libusb_device* dev \u003d dev_list.get()[i];\n    libusb_device_descriptor desc{};\n    if (libusb_get_device_descriptor(dev, \u0026desc) \u003c 0) {\n      continue;\n    }\n\n    if (desc.idVendor \u003d\u003d kFocalBootVid || desc.idVendor \u003d\u003d kFocalRomVid ||\n        desc.idVendor \u003d\u003d kFocalEcVid) {\n      if (desc.idVendor \u003d\u003d kFocalEcVid \u0026\u0026\n          (desc.idProduct !\u003d kFocalEcPidTest \u0026\u0026\n           desc.idProduct !\u003d kFocalEcPid9865 \u0026\u0026\n           desc.idProduct !\u003d kFocalEcPid9869)) {\n        LOGI(\n            \"Found Google device {:04x}:{:04x}, but not Focal fingerprint. \"\n            \"Skipping.\",\n            desc.idVendor, desc.idProduct);\n        continue;\n      }\n\n      LOGI(\"Found device VID {:04x}: PID {:04x}\", desc.idVendor,\n           desc.idProduct);\n      target_dev \u003d dev;\n      target_desc \u003d desc;\n      break;\n    }\n  }\n\n  if (target_dev \u003d\u003d nullptr) {\n    return std::unexpected(FtError::kNoSuchDevice);\n  }\n\n  libusb_device_handle* handle \u003d nullptr;\n  int r \u003d libusb_open(target_dev, \u0026handle);\n  if (r !\u003d LIBUSB_SUCCESS || handle \u003d\u003d nullptr) {\n    LOGE(\"Failed to open device: {}\", libusb_error_name(r));\n    return std::unexpected(FtError::kNoSuchDevice);\n  }\n\n  UsbDevice device(handle);\n  libusb_config_descriptor* config \u003d nullptr;\n  r \u003d libusb_get_config_descriptor(target_dev, 0, \u0026config);\n  if (r !\u003d LIBUSB_SUCCESS) {\n    LOGE(\"Couldn\u0027t retrieve configuration descriptors.\");\n    return std::unexpected(FtError::kNoSuchDevice);\n  }\n\n  bool found_endpoints \u003d false;\n  for (int j \u003d 0; j \u003c config-\u003ebNumInterfaces \u0026\u0026 !found_endpoints; ++j) {\n    const libusb_interface\u0026 interface \u003d config-\u003einterface[j];\n\n    for (int k \u003d 0; k \u003c interface.num_altsetting \u0026\u0026 !found_endpoints; ++k) {\n      const libusb_interface_descriptor\u0026 alt \u003d interface.altsetting[k];\n      out_details.interface_num \u003d alt.bInterfaceNumber;\n\n      for (int l \u003d 0; l \u003c alt.bNumEndpoints; ++l) {\n        const libusb_endpoint_descriptor\u0026 ep \u003d alt.endpoint[l];\n        if ((ep.bmAttributes \u0026 LIBUSB_TRANSFER_TYPE_MASK) \u003d\u003d\n            LIBUSB_TRANSFER_TYPE_BULK) {\n          if ((ep.bEndpointAddress \u0026 LIBUSB_ENDPOINT_DIR_MASK) \u003d\u003d\n              LIBUSB_ENDPOINT_IN) {\n            out_details.ep_bulk_in \u003d ep.bEndpointAddress;\n          } else {\n            out_details.ep_bulk_out \u003d ep.bEndpointAddress;\n          }\n        }\n      }\n\n      if (out_details.ep_bulk_in !\u003d 0 \u0026\u0026 out_details.ep_bulk_out !\u003d 0) {\n        found_endpoints \u003d true;\n      }\n    }\n  }\n  libusb_free_config_descriptor(config);\n\n  if (!found_endpoints) {\n    LOGE(\"Could not find required bulk IN/OUT endpoints.\");\n    return std::unexpected(FtError::kNoSuchDevice);\n  }\n\n  if (libusb_kernel_driver_active(device.get(), out_details.interface_num) \u003d\u003d\n      1) {\n    LOGD(\"Kernel driver active, detaching...\");\n    if (libusb_detach_kernel_driver(device.get(), out_details.interface_num) !\u003d\n        LIBUSB_SUCCESS) {\n      LOGE(\"Failed to detach kernel driver.\");\n      return std::unexpected(FtError::kResultFail);\n    }\n  }\n\n  r \u003d libusb_claim_interface(device.get(), out_details.interface_num);\n  if (r \u003c 0) {\n    LOGE(\"Failed to claim interface: {}\", libusb_error_name(r));\n    return std::unexpected(FtError::kResultFail);\n  }\n\n  out_details.vid \u003d target_desc.idVendor;\n  out_details.pid \u003d target_desc.idProduct;\n\n  LOGD(\"Device connected and interface claimed successfully.\");\n  return device;\n}\n\n```\n\n---\n\n### 5\\. ft\\_usb\\_port.cc\n\n* **Replaces:** focaltech/src/ft\\_usb\\_port.c  \n* **What Changed:** Used std::format for path strings and introduced ScopedFd.  \n* **Rationale:** std::format prevents the buffer overflows seen with snprintf(..., 64). ScopedFd prevents dangling open file descriptors if the IOCTL operations fail and exit early.\n\n```c\n#include \u003cfcntl.h\u003e\n#include \u003clinux/usb/ch9.h\u003e\n#include \u003clinux/usbdevice_fs.h\u003e\n#include \u003csys/ioctl.h\u003e\n#include \u003cunistd.h\u003e\n\n#include \u003cexpected\u003e\n#include \u003cformat\u003e\n#include \u003cstring\u003e\n\n#include \"ff_log.h\"\n#include \"usb_context.h\"\n\nnamespace {\n\nconstexpr int kUsbHubTimeoutMs \u003d 5000;\nconstexpr int kUsbPortFeatEnable \u003d 1;\nconstexpr int kUsbPortFeatReset \u003d 4;\n\nclass ScopedFd {\n public:\n  explicit ScopedFd(int fd) : fd_(fd) {}\n  ~ScopedFd() {\n    if (fd_ \u003e\u003d 0) {\n      close(fd_);\n    }\n  }\n\n  ScopedFd(const ScopedFd\u0026) \u003d delete;\n  ScopedFd\u0026 operator\u003d(const ScopedFd\u0026) \u003d delete;\n\n  [[nodiscard]] bool IsValid() const { return fd_ \u003e\u003d 0; }\n  int get() const { return fd_; }\n\n private:\n  int fd_;\n};\n\n}  // namespace\n\nstd::expected\u003cvoid, FtError\u003e SetHubPortFeature(int bus_num, int dev_num,\n                                               int port_num, int feature,\n                                               bool enable) {\n  std::string dev_path \u003d\n      std::format(\"/dev/bus/usb/{:03}/{:03}\", bus_num, dev_num);\n\n  ScopedFd fd(open(dev_path.c_str(), O_RDWR));\n  if (!fd.IsValid()) {\n    LOGE(\"Failed to open {}: {}\", dev_path, strerror(errno));\n    return std::unexpected(FtError::kNoSuchDevice);\n  }\n\n  usbdevfs_ctrltransfer ctrl{};\n  ctrl.bRequestType \u003d USB_DIR_OUT | USB_TYPE_CLASS | USB_RECIP_OTHER;\n  ctrl.bRequest \u003d enable ? USB_REQ_SET_FEATURE : USB_REQ_CLEAR_FEATURE;\n  ctrl.wValue \u003d feature;\n  ctrl.wIndex \u003d port_num;\n  ctrl.wLength \u003d 0;\n  ctrl.timeout \u003d kUsbHubTimeoutMs;\n  ctrl.data \u003d nullptr;\n\n  if (ioctl(fd.get(), USBDEVFS_CONTROL, \u0026ctrl) \u003c 0) {\n    LOGE(\"ioctl failed for port {} feature {}: {}\", port_num, feature,\n         strerror(errno));\n    return std::unexpected(FtError::kNoSuchDevice);\n  }\n\n  return {};\n}\n\nstd::expected\u003cvoid, FtError\u003e ResetFocalDevicePort(int bus_num, int dev_num,\n                                                  int port_num) {\n  LOGD(\"Resetting FocalTech device on bus {}, hub {}, port {}\", bus_num,\n       dev_num, port_num);\n  return SetHubPortFeature(bus_num, dev_num, port_num, kUsbPortFeatReset, true);\n}\n\nstd::expected\u003cvoid, FtError\u003e DisableFocalDevicePort(int bus_num, int dev_num,\n                                                    int port_num) {\n  LOGI(\"Disabling FocalTech device on bus {}, hub {}, port {}\", bus_num,\n       dev_num, port_num);\n  return SetHubPortFeature(bus_num, dev_num, port_num, kUsbPortFeatEnable,\n                           false);\n}\n\n```\n\n---",
