      "message": "### 6\\. ft\\_sg\\_io.cc\n\n* **Replaces:** focaltech/src/ft\\_sg\\_io.c  \n* **What Changed:** Switched unsigned char\\* and manual lengths to std::span. Localized structs BulkCbWrap, BulkCsWrap, and FtCmdFormat to an anonymous namespace.  \n* **Rationale:** std::span is bound-checked. It directly ties a data pointer to its size, making it impossible to pass mismatched buffer sizes to libusb\\_bulk\\_transfer.\n\n```c\n#include \u003cendian.h\u003e\n\n#include \u003carray\u003e\n#include \u003ccstdint\u003e\n#include \u003ccstring\u003e\n#include \u003cspan\u003e\n\n#include \"ff_log.h\"\n#include \"usb_context.h\"\n\nnamespace {\n\nconstexpr uint32_t kUsbMsCbwSignature \u003d 0x43425355;\nconstexpr uint32_t kUsbMsCswSignature \u003d 0x53425355;\nconstexpr size_t kFtCmdLength \u003d 16;\n\nstruct BulkCbWrap {\n  uint32_t signature;\n  uint32_t tag;\n  uint32_t data_transfer_length;\n  uint8_t flags;\n  uint8_t lun;\n  uint8_t cmd_len;\n  uint8_t cmd[16];\n} __attribute__((packed));\n\nstruct BulkCsWrap {\n  uint32_t signature;\n  uint32_t tag;\n  uint32_t data_residue;\n  uint8_t status;\n} __attribute__((packed));\n\nstruct FtCmdFormat {\n  uint8_t opcode;\n  uint32_t para2;\n  uint32_t para3;\n  uint32_t para4;\n  uint8_t subcmd;\n  uint8_t sub_para;\n  uint8_t reserved;\n} __attribute__((packed));\n\nuint32_t g_cdb_tag \u003d 1;\n\n}  // namespace\n\nstruct ScsiEndpoints {\n  uint8_t bulk_in;\n  uint8_t bulk_out;\n};\n\nstd::array\u003cuint8_t, kFtCmdLength\u003e BuildFtCmd(uint8_t opcode, uint8_t subcmd,\n                                             uint32_t para2, uint32_t para3,\n                                             uint32_t para4, uint8_t sub_para) {\n  std::array\u003cuint8_t, kFtCmdLength\u003e cmd_buf{};\n  auto* cmd \u003d reinterpret_cast\u003cFtCmdFormat*\u003e(cmd_buf.data());\n\n  cmd-\u003eopcode \u003d opcode;\n  cmd-\u003esubcmd \u003d subcmd;\n  cmd-\u003esub_para \u003d sub_para;\n  cmd-\u003epara2 \u003d para2;\n  cmd-\u003epara3 \u003d para3;\n  cmd-\u003epara4 \u003d para4;\n\n  return cmd_buf;\n}\n\nstd::expected\u003cvoid, FtError\u003e SendBulkCommand(\n    const UsbDevice\u0026 device, const ScsiEndpoints\u0026 eps,\n    std::span\u003cconst uint8_t\u003e scsi_cmd, std::span\u003cuint8_t\u003e data_buffer,\n    bool is_data_in, uint32_t timeout_ms) {\n  if (scsi_cmd.size() \u003e 16 || scsi_cmd.empty()) {\n    LOGE(\"Invalid SCSI command length.\");\n    return std::unexpected(FtError::kParameterError);\n  }\n\n  BulkCbWrap cbw{};\n  cbw.signature \u003d htole32(kUsbMsCbwSignature);\n  cbw.tag \u003d htole32(g_cdb_tag++);\n  cbw.flags \u003d is_data_in ? 0x80 : 0x00;\n  cbw.lun \u003d 0;\n  cbw.cmd_len \u003d static_cast\u003cuint8_t\u003e(scsi_cmd.size());\n  cbw.data_transfer_length \u003d htole32(data_buffer.size());\n  std::memcpy(cbw.cmd, scsi_cmd.data(), scsi_cmd.size());\n\n  int transferred \u003d 0;\n  int r \u003d libusb_bulk_transfer(device.get(), eps.bulk_out,\n                               reinterpret_cast\u003cuint8_t*\u003e(\u0026cbw), sizeof(cbw),\n                               \u0026transferred, timeout_ms);\n  if (r \u003c 0 || transferred !\u003d sizeof(cbw)) {\n    LOGE(\"CBW transfer failed: {}\", libusb_error_name(r));\n    return std::unexpected(FtError::kNoSuchDevice);\n  }\n\n  if (!data_buffer.empty()) {\n    uint8_t ep \u003d is_data_in ? eps.bulk_in : eps.bulk_out;\n    r \u003d libusb_bulk_transfer(device.get(), ep, data_buffer.data(),\n                             data_buffer.size(), \u0026transferred, timeout_ms);\n    if (r \u003c 0) {\n      LOGE(\"Data transfer failed: {}\", libusb_error_name(r));\n      return std::unexpected(FtError::kNoSuchDevice);\n    }\n  }\n\n  BulkCsWrap csw{};\n  r \u003d libusb_bulk_transfer(device.get(), eps.bulk_in,\n                           reinterpret_cast\u003cuint8_t*\u003e(\u0026csw), sizeof(csw),\n                           \u0026transferred, timeout_ms);\n  if (r \u003c 0 || transferred !\u003d sizeof(csw)) {\n    LOGE(\"CSW transfer failed.\");\n    return std::unexpected(FtError::kNoSuchDevice);\n  }\n\n  if (le32toh(csw.signature) !\u003d kUsbMsCswSignature ||\n      le32toh(csw.tag) !\u003d le32toh(cbw.tag)) {\n    LOGE(\"CSW signature/tag mismatch.\");\n    return std::unexpected(FtError::kResultFail);\n  }\n\n  if (csw.status !\u003d 0x00) {\n    LOGW(\"Command failed with CSW status: {:02x}\", csw.status);\n    return std::unexpected(FtError::kResultFail);\n  }\n\n  return {};\n}\n\n```\n\n---\n\n### 7\\. firmware\\_updater.cc\n\n* **Replaces:** focaltech/src/fun.c  \n* **What Changed:** Shifted fopen, fread, and malloc entirely into a std::ifstream mapped into a std::vector. Hashing and comparison logic relies on std::ranges.  \n* **Rationale:** The C code created a vulnerability: if verification failed early, it bypassed free(buffer) and leaked the entire firmware buffer. std::vector deterministically clears up memory when it goes out of scope.\n\n```c\n#include \u003copenssl/sha.h\u003e\n\n#include \u003calgorithm\u003e\n#include \u003ccstdint\u003e\n#include \u003cfstream\u003e\n#include \u003cstring_view\u003e\n#include \u003cvector\u003e\n\n#include \"ff_log.h\"\n#include \"ff_util.h\"\n#include \"usb_context.h\"\n\nstruct ScsiEndpoints {\n  uint8_t bulk_in;\n  uint8_t bulk_out;\n};\n\nstd::array\u003cuint8_t, 16\u003e BuildFtCmd(uint8_t opcode, uint8_t subcmd,\n                                   uint32_t para2, uint32_t para3,\n                                   uint32_t para4, uint8_t sub_para);\nstd::expected\u003cvoid, FtError\u003e SendBulkCommand(\n    const UsbDevice\u0026 device, const ScsiEndpoints\u0026 eps,\n    std::span\u003cconst uint8_t\u003e scsi_cmd, std::span\u003cuint8_t\u003e data_buffer,\n    bool is_data_in, uint32_t timeout_ms);\n\nnamespace {\n\nconstexpr size_t kMaxBinSize \u003d 2 * 1024 * 1024;\n\nstd::expected\u003cstd::vector\u003cuint8_t\u003e, FtError\u003e ReadFileToVector(\n    std::string_view path) {\n  std::ifstream file(std::string{path}, std::ios::binary | std::ios::ate);\n  if (!file) {\n    LOGE(\"Cannot open file: {}\", path);\n    return std::unexpected(FtError::kNoSuchFile);\n  }\n\n  auto size \u003d file.tellg();\n  if (size \u003c\u003d 0 || size \u003e kMaxBinSize) {\n    LOGE(\"Invalid file size: {}\", static_cast\u003cint64_t\u003e(size));\n    return std::unexpected(FtError::kParameterError);\n  }\n\n  std::vector\u003cuint8_t\u003e buffer(size);\n  file.seekg(0, std::ios::beg);\n  if (!file.read(reinterpret_cast\u003cchar*\u003e(buffer.data()), size)) {\n    LOGE(\"Failed to read file payload.\");\n    return std::unexpected(FtError::kResultFail);\n  }\n\n  return buffer;\n}\n\nstd::array\u003cuint8_t, SHA256_DIGEST_LENGTH\u003e CalculateSha256(\n    std::span\u003cconst uint8_t\u003e data) {\n  std::array\u003cuint8_t, SHA256_DIGEST_LENGTH\u003e hash{};\n  SHA256(data.data(), data.size(), hash.data());\n  return hash;\n}\n\n}  // namespace\n\nstd::expected\u003cvoid, FtError\u003e FtVerifyData(const UsbDevice\u0026 device,\n                                          const ScsiEndpoints\u0026 eps,\n                                          std::string_view file_path,\n                                          uint32_t target_addr) {\n  auto file_res \u003d ReadFileToVector(file_path);\n  if (!file_res.has_value()) {\n    return std::unexpected(file_res.error());\n  }\n  const auto\u0026 firmware_data \u003d file_res.value();\n\n  uint8_t hash_mode \u003d 0x04;         // SHA256 mode\n  if (target_addr \u003d\u003d 0x10000000) {  // FOCAL_ROM_CFG_ADDR\n    hash_mode \u003d 0x04 \u003c\u003c 4;\n  }\n\n  auto verify_cmd \u003d BuildFtCmd(0xDC, 0xBB, target_addr, firmware_data.size(), 0,\n                               hash_mode);\n\n  std::array\u003cuint8_t, SHA256_DIGEST_LENGTH\u003e device_hash{};\n  auto io_res \u003d\n      SendBulkCommand(device, eps, verify_cmd, device_hash, true, 1000);\n  if (!io_res.has_value()) {\n    LOGE(\"Verification command failed over USB.\");\n    return std::unexpected(io_res.error());\n  }\n\n  auto local_hash \u003d CalculateSha256(firmware_data);\n  if (!std::ranges::equal(local_hash, device_hash)) {\n    LOGE(\"Hash mismatch. Local: {:02x}{:02x}... Device: {:02x}{:02x}...\",\n         local_hash[0], local_hash[1], device_hash[0], device_hash[1]);\n    return std::unexpected(FtError::kResultFail);\n  }\n\n  LOGD(\"Verification successful.\");\n  return {};\n}\n\n```\n\n---\n\n### 8\\. main.cc\n\n* **Replaces:** focaltech/src/main.c, focaltech/include/ff\\_command.h  \n* **What Changed:** Dropped argc/argv manual index probing. Encapsulated commands into an enum class parsed via std::span[std::string\\_view](std::string_view). Replaced internal negative error numbers with EXIT\\_SUCCESS/EXIT\\_FAILURE.  \n* **Rationale:** The raw array accesses argv\\[1\\] and argv\\[2\\] created critical segmentation faults when invoked without correct arguments. The command enum ensures the logic branch mapping is strong-typed and secure. POSIX systems expect standard 0/1 return codes for proper shell scripting integration.\n\n```c\n#include \u003ccstdlib\u003e\n#include \u003cspan\u003e\n#include \u003cstring_view\u003e\n#include \u003cvector\u003e\n\n#include \"ff_log.h\"\n#include \"usb_context.h\"\n\nenum class Command {\n  kUnknown,\n  kEnterBoot,\n  kEnterRom,\n  kUsbSuspend,\n  kUsbResume,\n  kGetFlashWp,\n  kSetFlashWp,\n  kGetEcVersion,\n  kForceUpdate,\n  kUpdate,\n};\n\nstruct AppConfig {\n  Command cmd \u003d Command::kUnknown;\n  std::string_view ec_bin;\n  int action_param \u003d 0;\n};\n\nconstexpr Command ParseCommand(std::string_view cmd_str) {\n  if (cmd_str \u003d\u003d \"back_to_bootloader\") return Command::kEnterBoot;\n  if (cmd_str \u003d\u003d \"back_to_rom_boot\") return Command::kEnterRom;\n  if (cmd_str \u003d\u003d \"enter_usb_suspend\") return Command::kUsbSuspend;\n  if (cmd_str \u003d\u003d \"enter_usb_resume\") return Command::kUsbResume;\n  if (cmd_str \u003d\u003d \"flash_get_protect\") return Command::kGetFlashWp;\n  if (cmd_str \u003d\u003d \"flash_set_protect\") return Command::kSetFlashWp;\n  if (cmd_str \u003d\u003d \"get_ec_version\") return Command::kGetEcVersion;\n  if (cmd_str \u003d\u003d \"force_update_full_ec_bin\") return Command::kForceUpdate;\n  if (cmd_str.ends_with(\".bin\")) return Command::kUpdate;\n\n  return Command::kUnknown;\n}\n\nstd::expected\u003cAppConfig, FtError\u003e ParseArguments(\n    std::span\u003cconst std::string_view\u003e args) {\n  AppConfig config;\n\n  if (args.empty()) {\n    LOGE(\"No subcommand specified.\");\n    return std::unexpected(FtError::kParameterError);\n  }\n\n  config.cmd \u003d ParseCommand(args[0]);\n\n  if (config.cmd \u003d\u003d Command::kUnknown) {\n    LOGE(\"Unknown subcommand: {}\", args[0]);\n    return std::unexpected(FtError::kParameterError);\n  }\n\n  if (config.cmd \u003d\u003d Command::kUpdate \u0026\u0026 args.size() \u003e\u003d 1) {\n    config.ec_bin \u003d args[0];\n  } else if (config.cmd \u003d\u003d Command::kForceUpdate) {\n    if (args.size() \u003c 2) {\n      LOGE(\"force_update requires a firmware binary argument.\");\n      return std::unexpected(FtError::kParameterError);\n    }\n    config.ec_bin \u003d args[1];\n  } else if (config.cmd \u003d\u003d Command::kSetFlashWp) {\n    if (args.size() \u003c 2) {\n      LOGE(\"flash_set_protect requires an area parameter (1-4).\");\n      return std::unexpected(FtError::kParameterError);\n    }\n    config.action_param \u003d std::atoi(args[1].data());\n  }\n\n  return config;\n}\n\nint main(int argc, char** argv) {\n  std::vector\u003cstd::string_view\u003e args(argv + 1, argv + argc);\n\n  if (!args.empty() \u0026\u0026 (args[0] \u003d\u003d \"-h\" || args[0] \u003d\u003d \"--help\")) {\n    std::println(\"Help text goes here...\");\n    return EXIT_SUCCESS;\n  }\n\n  auto config_res \u003d ParseArguments(args);\n  if (!config_res.has_value()) {\n    return EXIT_FAILURE;\n  }\n  const AppConfig\u0026 config \u003d config_res.value();\n\n  UsbContext usb_ctx;\n  if (!usb_ctx.IsValid()) {\n    LOGE(\"Failed to initialize libusb.\");\n    return EXIT_FAILURE;\n  }\n\n  switch (config.cmd) {\n    case Command::kGetEcVersion:\n      LOGI(\"Tool version is v1.0.2\");\n      break;\n    case Command::kSetFlashWp:\n      LOGI(\"Setting flash write protect to area: {}\", config.action_param);\n      // Process logic...\n      break;\n    default:\n      LOGE(\"Command not fully implemented in this rewrite.\");\n      return EXIT_FAILURE;\n  }\n\n  return EXIT_SUCCESS;\n}\n\n```",
