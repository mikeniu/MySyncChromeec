#include <usbc-policy.dtsi>

 /{
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;
		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			chg = <&charger>;
			pdc = <&pdc_power_p0_rtk &pdc_power_p0_ti>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		usbc_port1: port0@1 {
			compatible = "named-usbc-port";
			reg = <1>;
			pdc = <&pdc_power_p1_rtk &pdc_power_p1_ti>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		ppm-driver {
			compatible = "ucsi-ppm";
			ports = <&usbc_port0 &usbc_port1>;
		};
	};
};

&i2c1 {
	pdc_power_p0_rtk: rts54-pdc@66 {
		compatible = "realtek,rts54-pdc";
		reg = <0x66>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		zephyr,deferred-init;
	};
	pdc_power_p1_rtk: rts54-pdc@67 {
		compatible = "realtek,rts54-pdc";
		reg = <0x67>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		no-fw-update;
		zephyr,deferred-init;
	};

	pdc_power_p0_ti: tps6699-pdc@20 {
		compatible = "ti,tps6699-pdc";
		reg = <0x20>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		zephyr,deferred-init;
	};
	pdc_power_p1_ti: tps6699-pdc@24 {
		compatible = "ti,tps6699-pdc";
		reg = <0x24>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		no-fw-update;
		zephyr,deferred-init;
	};
};

&i2c4 {
	charger: isl9238@9 {
		compatible = "intersil,isl923x";
		status = "okay";
		reg = <0x9>;
	};
};
