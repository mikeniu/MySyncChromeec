# Pre-Kconfig.zephyr default overrides.
#
# Symbols defined with an unconditional `default y` in upstream Zephyr must have
# their default overrides declared before `source "Kconfig.zephyr"` so that the
# override is evaluated before upstream defaults.

config KERNEL_MEM_POOL
	default n if !ZTEST && !POSIX_THREADS && !NET_BUF
