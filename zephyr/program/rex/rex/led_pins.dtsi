/* Copyright 2023 The ChromiumOS Authors
 * Use of this source code is governed by a BSD-style license that can be
 * found in the LICENSE file.
 */

/ {
	led_pins: gpio-led-pins {
		compatible = "cros-ec,gpio-led-pins";

		left_led: left-led {
			led-id = "EC_LED_ID_LEFT_LED";
			led-pins = <&gpio_led_1_l &gpio_led_2_l>;
			left_led_off: color-off-left {
				led-color = "LED_OFF";
				led-values = <1 1>;
			};

			left_led_amber: color-amber-left {
				led-color = "LED_AMBER";
				led-values = <0 1>;
			};

			left_led_white: color-white-left {
				led-color = "LED_WHITE";
				led-values = <1 0>;
			};
		};

		right_led: right-led {
			led-id = "EC_LED_ID_RIGHT_LED";
			led-pins = <&gpio_led_3_l &gpio_led_4_l>;

			right_led_off: color-off-right {
				led-color = "LED_OFF";
				led-values = <1 1>;
			};


			right_led_amber: color-amber-right {
				led-color = "LED_AMBER";
				led-values = <0 1>;
			};


			right_led_white: color-white-right {
				led-color = "LED_WHITE";
				led-values = <1 0>;
			};
		};
	};
};
