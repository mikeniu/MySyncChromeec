/* ocelot program common DTS includes */

#include <cros/integrated_fwid.dtsi>

/* coolum project DTS includes */

#include "binman.dtsi"
#include "fan.dtsi"
#include "generated.dtsi"
#include "interrupt.dtsi"
#include "keyboard.dtsi"
#include "power_signals.dtsi"

/*
 * Map I2C buses to common names
 */

i2c_port_pd1: &i2c1 {};
i2c_port_pd2: &i2c3 {};
i2c_port_charger: &i2c4 {};

/*
 * Map GPIOs used for interrupts to common names
 */

gpio_acok: &gpio_acok_od {};
gpio_lid: &gpio_lid_open {};
gpio_pwrbtn: &gpio_gsc_ec_pwr_btn_odl {};
gpio_all_sys_pwr_good: &gpio_all_sys_pwrgd_r {};
gpio_temp_sensor_power_good: &gpio_en_s5_rails {};

/* Power sequencing */
gpio_ec_pch_wake_odl: &gpio_smc_wake_sci_n_r {};

#include "../ite_hibernate.dtsi"
#include "../rvp_usba.dtsi"
#include "../rvp_battery.dtsi"
#include "../rvp_temp_sensors.dtsi"


#include "i2c.dtsi"
#include "imvp.dtsi"
#include "usbc.dtsi"

/* ocelotrvp-ite overrides follow... */
/ {
	aliases {
		gpio-wp = &gpio_c_ec_wp_odl_r;
	};

	named-gpios {
		/* unimplemented GPIOs */
		entering-rw {
			enum-name = "GPIO_ENTERING_RW";
		};
	};

	cse_early_recovery: cse-early-recovery {
		compatible = "cros-ec,cse-early-rec";
		cse-early-rec-gpios = <&gpioj 3 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_HIGH)>;
	};

	ap-power-events {
		compatible = "cros-ec,ap-power-events";
		/* GPIO H0: Power down signal(C_EC_PDB_CTRL_R) for codec amplifier */
		event-gpios = <&gpioh 0 GPIO_ACTIVE_HIGH>;
	};
};

&espi0 {
	status = "okay";
};

&sha0 {
	status = "okay";
};

/* Update board-specific references  */

&imvp_rt3645 {
	enable-gpios = <&gpioi 7 GPIO_ACTIVE_HIGH>;
};

