#include <usbc-policy.dtsi>

 /{
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;
		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			chg = <&charger>;
			pdc = <&pdc_ti_c0>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		usbc_port1: port1@1 {
			compatible = "named-usbc-port";
			reg = <1>;
			pdc = <&pdc_ti_c1>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		ppm-driver {
			compatible = "ucsi-ppm";
		};
	};
};

&i2c_port_pd1 {
	/* Define PDC IRQ GPIO(s) in board overlay */
	pdc_ti_c0: tps6699-pdc@20 {
		compatible = "ti,tps6699-pdc";
		reg = <0x20>;
		port-index-on-chip = <0x1>;
        irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		frs-supported;
		ccd;
	};
	pdc_ti_c1: tps6699-pdc@24 {
		compatible = "ti,tps6699-pdc";
		reg = <0x24>;
		port-index-on-chip = <0x2>;
        irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		frs-supported;
		no-fw-update;
	};
};
