/* wcl-ish project DTSI includes */
#include "gpio.dtsi"
#include "../i2c.dtsi"
#include "../interrupts.dtsi"
#include "../ish.dtsi"
#include "../../rvp_motionsense.dtsi"

&i2c_ish_sensor {
	i2c-port = <&i2c2>;
};

&i2c2 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	dsp_client: dsp-client@29 {
		compatible = "cros,dsp-client";
		reg = <0x29>;
		int-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
	};
};
