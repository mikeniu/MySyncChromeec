/* KB_LED_PWM */
&pwm3 {
	status = "okay";
	pinctrl-0 = <&pwm3_gp80>;
	pinctrl-names = "default";
};

/* FAN_PWM */
&pwm5 {
	status = "okay";
	pinctrl-0 = <&pwm5_gpb7>;
	pinctrl-names = "default";
};

/* EC_LED1_ODL */
&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_gpc3>;
	pinctrl-names = "default";
};

/* EC_LED2_ODL */
&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_gpc2>;
	pinctrl-names = "default";
};

/* EC_PWRBTN_LED_CTRL */
&pwm2 {
	status = "okay";
	pinctrl-0 = <&pwm2_gpc4>;
	pinctrl-names = "default";
};
