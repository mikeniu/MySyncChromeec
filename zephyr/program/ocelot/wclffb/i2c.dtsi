/ {
	named-i2c-ports {
		compatible = "named-i2c-ports";

		i2c_named_i2c_port_pd1: named_i2c_port_pd_aic1 {
			i2c-port = <&i2c_port_pd1>;
			enum-names = "I2C_PORT_PD";
		};
		i2c_named_i2c_port_charger: named_i2c_port_charger {
			i2c-port = <&i2c_port_charger>;
			enum-names = "I2C_PORT_BATTERY",
				"I2C_PORT_CHARGER";
		};
	};
};

&i2c_port_pd1 {
	label = "I2C_PORT_PD";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2c_port_charger {
	label = "I2C_PORT_CHARGER";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	charger: sgm41538@9 {
		compatible = "sgm,41580";
		status = "okay";
		reg = <0x9>;
	};
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_clk_gpc1_default
		&i2c1_data_gpc2_default>;
	pinctrl-names = "default";
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_clk_gpf6_default
		&i2c2_data_gpf7_default>;
	pinctrl-names = "default";
};

/* reserved for sensor */
&i2c3 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c3_clk_gpb2_default
		&i2c3_data_gpb5_default>;
	scl-gpios = <&gpiob 2 0>;
	sda-gpios = <&gpiob 5 0>;
	pinctrl-names = "default";
};
/* r
eserved for acc sensor */
&i2c5 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c5_clk_gpe1_default
		&i2c5_data_gpe2_default>;
	scl-gpios = <&gpioe 1 0>;
	sda-gpios = <&gpioe 2 0>;
	pinctrl-names = "default";
};