/ {
	chosen {
		cros-ec,keyboard = &kbd;
	};

};

&vivaldi_kbd {
	/* status = "disabled"; */

	/* wclffb physical matrix map -- verified on-board by getevent scancode
	 * sweep (2026-07-10). STRAUSS_T14 did NOT match this board: it placed
	 * action keys on the '1' (0,2) and 'a' (2,2) cells, so those keys emitted
	 * Back/Fullscreen. Each entry below is the (row,col) of the physical key
	 * that carries the matching vivaldi-code. Refresh MUST be (3,2) (KSO2) for
	 * the GSC recovery combo -- KEYBOARD_REFRESH_ROW3=y enforces this via a
	 * BUILD_ASSERT. The other 12 actions live on the physical F1..F12 keys. */
	vivaldi-keys = <
		KBD_RC(6, 2)   /* Back          <- F1  */
		KBD_RC(3, 2)   /* Refresh       <- Caps (KSO2, recovery) */
		KBD_RC(6, 6)   /* Fullscreen    <- F2  */
		KBD_RC(7, 6)   /* Overview      <- F3  */
		KBD_RC(6, 14)  /* Snapshot      <- F4  */
		KBD_RC(7, 14)  /* Brightness -  <- F5  */
		KBD_RC(7, 13)  /* Brightness +  <- F6  */
		KBD_RC(7, 12)  /* Dictate       <- F7  */
		KBD_RC(6, 15)  /* Accessibility <- F8  */
		KBD_RC(7, 15)  /* Mic mute      <- F9  */
		KBD_RC(7, 0)   /* Vol mute      <- F10 */
		KBD_RC(7, 9)   /* Vol down      <- F11 */
		KBD_RC(6, 9)   /* Vol up        <- F12 */
	>;

	kbd_config_0: kbd-config-0 {
		/* 13 action keys = 12 physical F-keys + Refresh (on Caps/KSO2).
		 * Order must line up index-for-index with vivaldi-keys above.
		 * Dropped VIVALDI_TK_KBD_BKLIGHT_TOGGLE from the old 14-key list --
		 * this keyboard only has 12 top-row keys (F1..F12) plus the Caps
		 * Refresh key; 'del' (right of F12) stays a normal Delete key. */
		vivaldi-codes = <
			VIVALDI_TK_BACK               /* F1  */
			VIVALDI_TK_REFRESH            /* Caps */
			VIVALDI_TK_FULLSCREEN         /* F2  */
			VIVALDI_TK_OVERVIEW           /* F3  */
			VIVALDI_TK_SNAPSHOT           /* F4  */
			VIVALDI_TK_BRIGHTNESS_DOWN    /* F5  */
			VIVALDI_TK_BRIGHTNESS_UP      /* F6  */
			VIVALDI_TK_DICTATE            /* F7  */
			VIVALDI_TK_ACCESSIBILITY      /* F8  */
			VIVALDI_TK_MICMUTE            /* F9  */
			VIVALDI_TK_VOL_MUTE           /* F10 */
			VIVALDI_TK_VOL_DOWN           /* F11 */
			VIVALDI_TK_VOL_UP             /* F12 */
		>;
		capabilities = <(VIVALDI_KEYBD_CAP_FUNCTION_KEYS |
				VIVALDI_KEYBD_CAP_SCRNLOCK_KEY |
				VIVALDI_KEYBD_CAP_ASSISTANT_KEY)
		>;
	};
};

&kbd {
	status = "okay";

	pinctrl-0 = <
		&ksi0_default
		&ksi1_default
		&ksi2_default
		&ksi3_default
		&ksi4_default
		&ksi5_default
		&ksi6_default
		&ksi7_default
		&kso0_default
		&kso1_default
		&kso3_default
		&kso4_default
		&kso5_default
		&kso6_default
		&kso7_default
		&kso8_default
		&kso9_default
		&kso10_default
		&kso11_default
		&kso12_default
		&kso13_default
		&kso14_default
		&kso15_default
	>;
        pinctrl-1 = <
		&ksi0_sleep
		&ksi1_sleep
		&ksi2_sleep
		&ksi4_sleep
		&ksi5_sleep
		&ksi6_sleep
		&ksi7_sleep
		&kso0_sleep
		&kso10_sleep
		&kso11_sleep
		&kso12_sleep
		&kso13_sleep
		&kso14_sleep
		&kso15_sleep
		&kso1_sleep
		&kso2_sleep
		&kso3_sleep
		&kso4_sleep
		&kso5_sleep
		&kso6_sleep
		&kso7_sleep
		&kso8_sleep
		&kso9_sleep
	>;
	pinctrl-names = "default", "sleep";
	row-size = <8>;
	col-size = <16>;
	kso-ignore-mask = <04>;
	debounce-down-ms = <15>;
	debounce-up-ms = <15>;
	/* General matrix settle time applied to every column (matches sibling
	 * boards: nissa/*, trulo/*, fatcat/*, ocelot/kodkod, ocelot/ojal). */
	settle-time-us = <80>;
	actual-key-mask = <
		0xff  /* C0 */
		0xff  /* C1 */
		0xff  /* C2 */
		0xff  /* C3 */
		0xff  /* C4 */
		0xff  /* C5 */
		0xff  /* C6 */
		0xff  /* C7 */
		0xff  /* C8 */
		0xff  /* C9 */
		0xff  /* C10 */
		0xff  /* C11 */
		0xff  /* C12 */
		0xff  /* C13 */
		0xff  /* C14 */
		0xff  /* C15 */
	>;

	kso-gpio {
		compatible = "cros-ec,col-gpio";
		col-num = <2>;
		col-gpios = <&gpioksol 2 GPIO_ACTIVE_LOW>;
	};

	boot-keys {
		compatible = "cros-ec,boot-keys";
		down-arrow-rc = <KBD_RC(6, 11)>;
		esc-rc = <KBD_RC(1, 1)>;
		left-shift-rc = <KBD_RC(5, 7)>;
		refresh-rc = <KBD_RC(3, 2)>;
	};

	runtime-keys {
		compatible = "cros-ec,runtime-keys";
		left-alt-rc = <KBD_RC(2, 7)>;
		right-alt-rc = <KBD_RC(1, 7)>;
		h-rc = <KBD_RC(3, 12)>;
		r-rc = <KBD_RC(4, 13)>;
	};

	scancode-set2 {
		compatible = "cros-ec,scancode-set2";

		default {
			col0-codes  = <0x004d 0x0052 0x0049 0x0000 0x004b 0x0044 0x0046 0x0009>;
			col1-codes  = <0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0000 0x0037>;
			col2-codes  = <0x0016 0x0000 0x001c 0x0058 0x000d 0x000e 0x0005 0x0076>;
			col3-codes  = <0x0000 0x0000 0x0000 0x0059 0x0000 0x0000 0x0012 0x0000>;
			col4-codes  = <0xe014 0x0000 0x0000 0x0000 0x0000 0x0014 0x0000 0x0000>;
			col5-codes  = <0x0000 0x0000 0x0000 0x0000 0xe01f 0x0000 0x0000 0x0000>;
			col6-codes  = <0x0015 0x001a 0x0022 0x001b 0x001d 0x001e 0x0006 0x0004>;
			col7-codes  = <0x0000 0xe011 0x0011 0x0000 0x0000 0x0000 0x0000 0x0000>;
			col8-codes  = <0x005b 0xe06b 0x0000 0xe075 0x0000 0x0055 0x0000 0xe071>;
			col9-codes  = <0x004e 0x0000 0x004a 0x0000 0x0054 0x0045 0x0007 0x0078>;
			col10-codes = <0xe074 0xe072 0x004c 0x005d 0x005a 0x0066 0x0000 0x0000>;
			col11-codes = <0x0000 0x0000 0x0000 0x0000 0x0000 0x004a 0x0000 0x0000>;
			col12-codes = <0x003c 0x0032 0x0031 0x0033 0x0035 0x003d 0x003e 0x0083>;
			col13-codes = <0x002c 0x002a 0x002b 0x0034 0x002d 0x002e 0x0036 0x000b>;
			col14-codes = <0x0026 0x0000 0x0021 0x0023 0x0024 0x0025 0x000c 0x0003>;
			col15-codes = <0x003b 0x0029 0x0041 0x003a 0x0042 0x0043 0x000a 0x0001>;
		};
	};
};

/* Drop the gpio properties from the kbd node to avoid confusing the named_gpios
 * script.
 */
&kbd {
	/delete-property/ kso16-gpios;
	/delete-property/ kso17-gpios;
};
