#include <usbc-policy.dtsi>
#include <dt-bindings/usb_pd_tcpm.h>

 /{
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;

		port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			/* bc12 = <&bc12_port0>; */
			tcpc = <&tcpc_port0>;
			chg = <&charger>;
			usb-mux-chain-0 {
				compatible = "cros-ec,usb-mux-chain";
				usb-muxes = <&virtual_mux_0>;
			};
		};
		port0-muxes {
			virtual_mux_0: virtual-mux-0 {
				compatible = "cros-ec,usbc-mux-virtual";
			};
		};
	};
};

&i2c_port_pd1 {
	tcpc_port0: anx7447-tcpc@2c {
		compatible = "analogix,anx7447-tcpc"; /* anx7406 => Invalid TCPC compatible on node */
		status = "okay";
		reg = <0x2c>;
		tcpc-flags = <(
			TCPC_FLAGS_VBUS_MONITOR |
			TCPC_FLAGS_ALERT_OD |
			TCPC_FLAGS_CONTROL_VCONN |
			TCPC_FLAGS_CONTROL_FRS)>; /* same as kingler ? */
		/* a duplicate of the <&gpio_usb_c0_tcpc_int_odl> node in
		 * "named-gpios". This is the Zephyr preferred style,
		 * the "named-gpios" node will be dealt with at a later date.
		 */
		irq-gpios = <&gpioj 7 GPIO_ACTIVE_LOW>;
		/* a duplicate of the <&gpio_usb_c0_tcpc_rst> node in
		 * "named-gpios". This is the Zephyr preferred style,
		 * the "named-gpios" node will be dealt with at a later date.
		 */
		rst-gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
	};
};
