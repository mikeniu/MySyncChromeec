#include <usbc-policy.dtsi>

 /{
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;
		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			chg = <&charger>;
			pdc = <&pdc_power_p0>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		usbc_port1: port1@1 {
			compatible = "named-usbc-port";
			reg = <1>;
			pdc = <&pdc_power_p1>;
			pd-retimer;
			policy = <&cros_policy>;
		};
		ppm-driver {
			compatible = "ucsi-ppm";
		};
	};
};

&i2c_port_pd1 {
	/* Define PDC IRQ GPIO(s) in board overlay */
	pdc_power_p0: anx74-pdc@b {
		compatible = "analogix,anx74-pdc";
		reg = <0xb>;
		irq-gpios = <&gpioj 7 GPIO_ACTIVE_LOW>;
		ccd;
	};
	pdc_power_p1: anx74-pdc@2b {
		compatible = "analogix,anx74-pdc";
		reg = <0x2b>;
		irq-gpios = <&gpioj 7 GPIO_ACTIVE_LOW>;
		no-fw-update;
	};
};
