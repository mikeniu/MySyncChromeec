#include <cros/touchpad_hashes.dtsi>

#include "../gpio.dtsi"
#include "../uart.dtsi"
#include "../i2c.dtsi"
#include "../interrupts.dtsi"
#include "../keyboard.dtsi"
#include "../pwm.dtsi"
#include "../rwsig.dtsi"

&i2c0 {
	touchpad@15 {
		logical-max-x = <2721>;
		logical-max-y = <1291>;
		physical-max-x = <864>;
		physical-max-y = <410>;
	};
};

&i2c5 {
	status = "okay";
	label = "I2C_TOUCH_SCREEN";

	pinctrl-0 = < &i2c5_clk_gpe1_default &i2c5_data_gpe2_default>;
	pinctrl-names = "default";

	clock-frequency = <I2C_BITRATE_FAST>;
	data-hold-time = <10>;

	touch-screen@a {
		compatible = "acer,kl1400h";
		status = "okay";
		reg = <0xa>;
		irq = <&int_touch_screen>;
	};
};

&touchpad_fw_hashes {
	size = <((65536 / 1024) * 32)>;
};


/ {
	aliases {
		usb-hid-tp = &usb_hid_tp;
		usb-hid-touch-screen = &usb_hid_touch_screen;
	};
};

&uart2 {
	status = "disabled";

	one_wire_uart: one-wire-uart {
		status = "disabled";
	};
};

&ite_uart2_wrapper {
	status = "disabled";
};

zephyr_udc0: &usb0 {
	status = "okay";
	pinctrl-0 = <&usb0_dm_gph5_default
		     &usb0_dp_gph6_default>;
	pinctrl-names = "default";

	usb_hid_tp: usb-hid-tp {
		compatible = "cros-ec,usb-hid-touchpad";

		logical-max-x = <2721>;
		logical-max-y = <1291>;
		physical-max-x = <864>;
		physical-max-y = <410>;
		max-pressure = <255>;
	};

	usb_hid_touch_screen: usb-hid-touch-screen {
		compatible = "cros-ec,usb-hid-touch-screen";
		reportid-max-count = <0x1c>; /* TODO: CHECKME */
	};

	hid_kb_dev: hid-kb-dev {
		compatible = "zephyr,hid-device";
		label = "spikyrock keyboard";
		protocol-code = "keyboard";
		out-report-size = <64>;
		out-polling-period-us = <1000>;
		in-report-size = <64>;
		in-polling-period-us = <1000>;
	};

	hid_tp_dev: hid-tp-dev {
		compatible = "zephyr,hid-device";
		label = "spikyrock touchpad";
		protocol-code = "mouse";
		/* device cert (256 bytes) + some overhead */
		out-report-size = <280>;
		out-polling-period-us = <1000>;
		in-report-size = <64>;
		in-polling-period-us = <1000>;
	};

	hid_touch_screen_dev: hid-touch-screen-dev {
		compatible = "zephyr,hid-device";
		label = "spikyrock touch screen";
		protocol-code = "none";
		out-report-size = <64>; /* TODO: CHECK-ME */
		out-polling-period-us = <1000>;
		in-report-size = <64>;
		in-polling-period-us = <1000>;
	};
};
