/*
 * Copyright 2025 The ChromiumOS Authors
 *
 * SPDX-License-Identifier: Apache-2.0
 */
#include <usbc-policy.dtsi>

 /{
	usbc {
		#address-cells = <1>;
		#size-cells = <0>;
		usbc_port0: port0@0 {
			compatible = "named-usbc-port";
			reg = <0>;
			chg = <&charger>;
			pdc = <&pdc_power_p0>;
			pd-retimer;
			policy = <&cros_policy>;
			zephyr,deferred-init;
		};
		usbc_port1: port1@1 {
			compatible = "named-usbc-port";
			reg = <1>;
			pdc = <&pdc_power_p1>;
			pd-retimer;
			policy = <&cros_policy>;
			zephyr,deferred-init;
		};
		ppm-driver {
			compatible = "ucsi-ppm";
		};
	};
};

&i2c1 {
	pdc_power_p0: rts54-pdc@66 {
		compatible = "realtek,rts54-pdc";
		reg = <0x66>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		zephyr,deferred-init;
		ccd;
	};
	pdc_power_p1: rts54-pdc@67 {
		compatible = "realtek,rts54-pdc";
		reg = <0x67>;
		irq-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
		zephyr,deferred-init;
		no-fw-update;
	};
};

&i2c2 {
	charger: isl95522@9 {
		compatible = "intersil,isl95522";
		status = "okay";
		reg = <0x9>;
		minimum-charging-mv = <15000>;
	};
};
