/ {
	pic-fw-config {
		compatible = "cros-ec,cbi-fw-config";

		/*
		 * FW_CONFIG field to select keyboard layout.
		 * US and UK share the same physical matrix; JP has 5 extra
		 * keys and misses one US-only key.
		 */
		kb-layout {
			enum-name = "FW_KB_LAYOUT";
			start = <0>;
			size = <2>;

			kb-layout-us {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_KB_LAYOUT_US";
				value = <0>;
				default;
			};
			kb-layout-jp {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_KB_LAYOUT_JP";
				value = <1>;
			};
			kb-layout-uk {
				compatible = "cros-ec,cbi-fw-config-value";
				enum-name = "FW_KB_LAYOUT_UK";
				value = <2>;
			};
		};
	};
};
