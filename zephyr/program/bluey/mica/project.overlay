/* bluey program common DTS includes */

#include <cros/integrated_fwid.dtsi>

#include "../interrupts.dtsi"
#include "../adc.dtsi"
#include "../i2c.dtsi"
#include "../common.dtsi"
#include "../battery.dtsi"
#include "../psl.dtsi"

/* mica project DTS includes */

#include "gpios.dtsi"
#include "fan.dtsi"
#include "keyboard.dtsi"
#include "temp_sensors.dtsi"

/ {
	gpio-interrupts {
		int_prochot: prochot {
			irq-pin = <&gpio_ec_sys_throttle_mira>;
			flags = <GPIO_INT_EDGE_BOTH>;
			handler = "throttle_ap_prochot_input_interrupt";
		};
	};
};

/* mica overrides follow... */
&cbi_flash {
	/*
	 * CBI section size is 0x1000 bytes, the CBI portion lies at the end of
	 * EC_RO section.
	 */
	offset = <0x3e000>;
	size = <0x1000>;
};
