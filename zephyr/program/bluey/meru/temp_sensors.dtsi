#include <cros/thermistor/thermistor.dtsi>

/ {
	named-adc-channels {

		adc_temp_cpu: cpu {
			enum-name = "ADC_TEMP_SENSOR_1";
			io-channels = <&adc0 0>;
		};
		adc_temp_core: core {
			enum-name = "ADC_TEMP_SENSOR_2";
			io-channels = <&adc0 1>;
		};
		adc_temp_charger: charger {
			enum-name = "ADC_TEMP_SENSOR_3";
			io-channels = <&adc0 2>;
		};
		adc_temp_ambient: ambient {
			enum-name = "ADC_TEMP_SENSOR_4";
			io-channels = <&adc0 3>;
		};
		adc_temp_hw_shutdown: hw_shutdown {
			enum-name = "ADC_TEMP_SENSOR_5";
			io-channels = <&adc0 4>;
		};
		adc_temp_typec: typec {
			enum-name = "ADC_TEMP_SENSOR_6";
			io-channels = <&adc0 7>;
		};
		adc_usb_keybaord_det: usb_keybaord_det {
			enum-name = "ADC_BASE_DET";
			io-channels = <&adc0 6>;
		};
	};

	temp_sensor_cpu: cpu {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_cpu>;
	};
	temp_sensor_core: core {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_core>;
	};
	temp_sensor_charger: charger {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_charger>;
	};
	temp_sensor_ambient: ambient {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_ambient>;
	};
	temp_sensor_hw_shutdown: hw_shutdown {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_hw_shutdown>;
	};
	temp_sensor_typec: typec {
		compatible = "cros-ec,temp-sensor-thermistor";
		thermistor = <&thermistor_3V3_100K_100K_4250B>;
		adc = <&adc_temp_typec>;
	};

	named-temp-sensors {
		compatible = "cros-ec,temp-sensors";
		temp_cpu: cpu {
			sensor = <&temp_sensor_cpu>;
		};
		temp_core: core {
			sensor = <&temp_sensor_core>;
		};
		temp_charger: charger {
			sensor = <&temp_sensor_charger>;
		};
		temp_ambient: ambient {
			sensor = <&temp_sensor_ambient>;
		};
		temp_hw_shutdown: hw_shutdown {
			sensor = <&temp_sensor_hw_shutdown>;
		};
		temp_typec: typec {
			sensor = <&temp_sensor_typec>;
		};
	};
};

&thermistor_3V3_100K_100K_4250B {
	status = "okay";
};

&adc0 {
	pinctrl-0 = <&adc0_chan0_gp45
		&adc0_chan1_gp44
		&adc0_chan2_gp43
		&adc0_chan3_gp42
		&adc0_chan4_gp41
		&adc0_chan6_gp34
		&adc0_chan7_gpe1
		&adc0_chan11_gpc7>;
	pinctrl-names = "default";
};
