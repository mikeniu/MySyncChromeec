config PLATFORM_EC_BTN_IGN_OUT
	bool "Enable power button ignore output"
	help
	  Enables setting power button ignore state by GPIO.
	  Enabled if the btn_ign node is defined in DT.
	default y
	depends on DT_HAS_CROS_EC_BTN_IGN_ENABLED
	select PLATFORM_EC_BTN_IGN_OUT_FINGERPRINT

config PLATFORM_EC_BTN_IGN_OUT_FINGERPRINT
	bool "Integrate power button ignore output with fingerprint"
	help
	  Fingerprint application controls btn_ign
