#include <cros/cbi_ufsc_std_schema.dtsi>
#include <dt-bindings/vivaldi_kbd.h>

/ {
	vivaldi_kbd: vivaldi-kbd {
		compatible = "cros-ec,vivaldi-kbd";
		status = "okay";
		vivaldi-keys = <
			KBD_RC(0, 2)
			KBD_RC(3, 2)
			KBD_RC(2, 2)
			KBD_RC(1, 2)
			KBD_RC(3, 4)
			KBD_RC(2, 4)
			KBD_RC(1, 4)
			KBD_RC(2, 9)
			KBD_RC(1, 9)
			KBD_RC(0, 4)
		>;

		kbd_config_0: kbd-config-0 {
			vivaldi-codes = <
				VIVALDI_TK_BACK
				VIVALDI_TK_FORWARD
				VIVALDI_TK_REFRESH
				VIVALDI_TK_FULLSCREEN
				VIVALDI_TK_OVERVIEW
				VIVALDI_TK_BRIGHTNESS_DOWN
				VIVALDI_TK_BRIGHTNESS_UP
				VIVALDI_TK_VOL_MUTE
				VIVALDI_TK_VOL_DOWN
				VIVALDI_TK_VOL_UP
			>;
			capabilities = <VIVALDI_KEYBD_CAP_SCRNLOCK_KEY>;
		};

		kbd_config_1: kbd-config-1 {
			vivaldi-codes = <
				VIVALDI_TK_PLAY_PAUSE
				VIVALDI_TK_NEXT_TRACK
				VIVALDI_TK_PREV_TRACK
				VIVALDI_TK_ABSENT
				VIVALDI_TK_ABSENT
				VIVALDI_TK_ABSENT
				VIVALDI_TK_ABSENT
				VIVALDI_TK_VOL_UP
				VIVALDI_TK_KBD_BKLIGHT_TOGGLE
				VIVALDI_TK_MICMUTE
			>;
			capabilities = <(VIVALDI_KEYBD_CAP_SCRNLOCK_KEY |
					 VIVALDI_KEYBD_CAP_NUMERIC_KEYPAD)>;
		};
	};

	patch_us2: patch-us2 {
		compatible = "cros-ec,keyboard-layout-patch";
		status = "okay";
		copies = <3 14>, <2 7>;
	};

	/*
	 * Chained copies, mirroring the JP layout on ocicat: (0, 13) is used
	 * to stage the original value of (5, 11) so the last entry can pick it
	 * up again.
	 *
	 * ocicat stages from (5, 15), but this test matrix only has 15 columns
	 * (ocicat widens it to 16 via KEYBOARD_CUSTOMIZATION), so the staged
	 * cell is moved to (5, 11). Only the ordering matters here.
	 */
	patch_rotate: patch-rotate {
		compatible = "cros-ec,keyboard-layout-patch";
		status = "okay";
		copies = <0 13>, <5 11>,
			 <5 11>, <1 12>,
			 <1 12>, <0 10>,
			 <0 10>, <0 13>;
	};

	patch_custom: patch-custom {
		compatible = "cros-ec,keyboard-layout-patch";
		status = "okay";
		vivaldi-config = <&kbd_config_1>;
	};

	patch_default: patch-default {
		compatible = "cros-ec,keyboard-layout-patch";
		status = "okay";
		vivaldi-config = <&kbd_config_0>;
	};

	cbi-ufsc-keyboard-selector {
		compatible = "cros-ec,cbi-ufsc-keyboard-selector";
		status = "okay";

		region {
			selections =
				<&ufsc_fw_kb_layout_us2 &patch_us2>,
				<&ufsc_fw_kb_layout_rotate &patch_rotate>,
				<&ufsc_fw_kb_layout_custom &patch_custom>;
		};

		vivaldi {
			selections =
				<&ufsc_kb_backlight_absent &patch_default>,
				<&ufsc_kb_backlight_present &patch_custom>;
		};
	};
};

&ufsc_keyboard_layout {
	status = "okay";
	ufsc_fw_kb_layout_default: fw-kb-layout-default {
		compatible = "cros-ec,cbi-ufsc-value";
		status = "okay";
		enum-name = "UFSC_FW_KB_LAYOUT_DEFAULT";
		value = <0>;
		default;
	};
	ufsc_fw_kb_layout_us2: fw-kb-layout-us2 {
		compatible = "cros-ec,cbi-ufsc-value";
		status = "okay";
		enum-name = "UFSC_FW_KB_LAYOUT_US2";
		value = <1>;
	};
	ufsc_fw_kb_layout_custom: fw-kb-layout-custom {
		compatible = "cros-ec,cbi-ufsc-value";
		status = "okay";
		enum-name = "UFSC_FW_KB_LAYOUT_CUSTOM";
		value = <2>;
	};
	ufsc_fw_kb_layout_rotate: fw-kb-layout-rotate {
		compatible = "cros-ec,cbi-ufsc-value";
		status = "okay";
		enum-name = "UFSC_FW_KB_LAYOUT_ROTATE";
		value = <3>;
	};
};

&ufsc_kb_backlight {
	status = "okay";
	ufsc_kb_backlight_absent: kb-backlight-absent {
		compatible = "cros-ec,cbi-ufsc-value";
		status = "okay";
		enum-name = "UFSC_KB_BACKLIGHT_ABSENT";
		value = <0>;
		default;
	};
	ufsc_kb_backlight_present: kb-backlight-present {
		compatible = "cros-ec,cbi-ufsc-value";
		status = "okay";
		enum-name = "UFSC_KB_BACKLIGHT_PRESENT";
		value = <1>;
	};
};
