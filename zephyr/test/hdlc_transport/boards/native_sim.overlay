#include <board-overlays/native_sim.dts>

/ {
	chosen {
		zephyr,shell-uart = &euart0;
	};

	euart0: uart_emul0 {
		compatible = "zephyr,uart-emul";
		status = "okay";
		current-speed = <0>;
		rx-fifo-size = <1024>;
		tx-fifo-size = <1024>;
	};
};
