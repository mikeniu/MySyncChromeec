#include <board-overlays/native_sim.dts>
#include <dt-bindings/gpio_defines.h>
#include "../../../program/atria/power_signals.dtsi"
#include "mtl_emul.dtsi"

/ {
	common-pwrseq {
		s5-inactivity-timeout = <1>;
		sys-pwrok-delay = <10>;
		all-sys-pwrgd-timeout = <20>;
	};
};

/* Assign GPIO pins to all power signals that need them.
 * Clear GPIO_OPEN_DRAIN on outputs since open drain is not
 * supported by the GPIO emulator.
 */
&pwr_en_pp3300_a {
	gpios = <&gpio0 6 0>;
};
&pwr_rsmrst_pwrgd {
	gpios = <&gpio0 7 0>;
};
&pwr_ec_pch_rsmrst {
	gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
};
&pwr_slp_s0 {
	gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
};
&pwr_slp_s3 {
	gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
};
&pwr_slp_s4 {
	gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
};
&pwr_all_sys_pwrgd {
	gpios = <&gpio0 12 0>;
};
&pwr_pch_pwrok {
	gpios = <&gpio0 13 0>;
};
&pwr_sys_rst {
	gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
};
