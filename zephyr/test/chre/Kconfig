config ISH_CHRE
	bool "Enable CHRE for ISH"
	default y

config ISH_CHRE_STACK_SIZE
	int "CHRE thread stack size"
	default 2048

config ISH_CHRE_PRIORITY
	int "CHRE thread priority"
	default 5

config CHRE_TIMER_WORLD
	bool "Enable CHRE TimerWorld static nanoapp"
	default y

config CHRE_HELLO_WORLD
	bool "Enable CHRE HelloWorld static nanoapp"
	default n

source "Kconfig.zephyr"
