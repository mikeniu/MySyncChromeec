config CROS_SWITCHCAP
	bool "ChromiumOS GPIO Switchcap driver"
	default y
	depends on DT_HAS_CROS_EC_SWITCHCAP_ENABLED
	help
	  Enables the GPIO-based switchcap driver for ChromiumOS.

config CROS_SWITCHCAP_ADC
	bool "ChromiumOS ADC Switchcap driver"
	default y
	depends on DT_HAS_CROS_EC_SWITCHCAP_ADC_ENABLED
	help
	  Enables the ADC-based switchcap driver for ChromiumOS.
