config CROS_EC_WOT
        bool "Wake-On-Touch (WOT) Driver"
        default y
        depends on DT_HAS_CROS_EC_WOT_ENABLED
        help
          Enable Wake-On-Touch (WOT) driver for ChromeOS EC.