config QCOM_SWITCHCAP
	bool "Qualcomm AP Switchcap driver"
	default y
	depends on DT_HAS_CROS_EC_QCOM_SWITCHCAP_ENABLED
	help
	  Enables the switchcap driver for Qualcomm chipsets.
