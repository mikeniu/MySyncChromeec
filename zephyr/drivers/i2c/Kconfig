config I2C_DTS_PASSTHRU
	bool "I2C Passthru DTS Restrictions Driver"
	depends on !PLATFORM_EC_I2C_PASSTHRU_RESTRICTED
	help
	  Enable the I2C Passthru DTS restrictions driver.

if I2C_DTS_PASSTHRU

module = I2C_DTS_PASSTHRU
module-str = i2c_dts_passthru
source "subsys/logging/Kconfig.template.log_config"

config I2C_PASSTHRU_MAX_MSGS
	int "The maximum number of messages in a passthru command"
	default 16
	help
	  We use a buffer to store the intermediates for i2c_transfer.
	  This config defines the buffer size.

config CMD_I2C_DTS_PROTECT
	bool "The EC console command to controll i2c protection"
	default y
	help
	  Enable EC console command to controll i2c protection.

endif # I2C_DTS_PASSTHRU
