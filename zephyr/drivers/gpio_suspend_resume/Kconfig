config GPIO_SUSPEND_RESUME
	bool "GPIO suspend/resume driver"
	default y
	depends on DT_HAS_CROS_EC_GPIO_SUSPEND_RESUME_ENABLED
	depends on AP_EVENTS
	help
	  Driver to control GPIOs based on AP power state. GPIOs defined
	  in devicetree are asserted on AP_POWER_STARTUP and de-asserted
	  on AP_POWER_HARD_OFF.
