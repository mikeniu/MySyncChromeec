config CROS_EC_IRQ_GPIO
	bool
	default y
	depends on DT_HAS_CROS_EC_IRQ_GPIO_ENABLED
	help
	  This option enables Serial Host Interface driver for the NPCX family
	  of processors. This is used for host-command communication on the
	  platform which AP is ARM-based SoC.

if CROS_EC_IRQ_GPIO
config IRQ_GPIO_INIT_PRIORITY
	int "Cros EC IRQ GPIO driver priority"
	default 100
	help
	  This is the driver priority
endif
