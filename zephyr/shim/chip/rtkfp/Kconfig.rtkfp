if PLATFORM_EC

config RTKFP_OTP_KEY
	bool "Enable Realtek FP OTP Key functionality"
	depends on BORINGSSL_CRYPTO
	depends on OTP
	select OTP_PROGRAM
	help
	  Enable support for reading and provisioning the OTP KEY for
	  Realtek rtkfp SOCs.

endif # PLATFORM_EC
