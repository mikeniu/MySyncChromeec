config PLATFORM_EC_CHARGE_VIRTUAL
	bool "Virtual charge module"
	help
	  Enables the virtual charge module, allowing
	  the LED driver to use it for LED detection without the full charge manager.

if PLATFORM_EC_CHARGE_VIRTUAL

config PLATFORM_EC_CHARGE_VIRTUAL_CONSOLE_COMMAND
	bool "Console command for charge virtual module"
	default n
	help
	  Enables the 'virtual_charge' console command for manual control
	  of the charge virtual module.

module = PLATFORM_EC_CHARGE_VIRTUAL
module-str = charge_virtual
source "subsys/logging/Kconfig.template.log_config"

endif # PLATFORM_EC_CHARGE_VIRTUAL
