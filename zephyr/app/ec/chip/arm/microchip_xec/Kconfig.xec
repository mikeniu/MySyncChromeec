#
# This file defines the default config values shared by all MEC chipsets
#

if SOC_FAMILY_MICROCHIP_MEC

# Enable MPU for ARM targets
configdefault ARM_MPU
	default y

# ADC
configdefault PLATFORM_EC_ADC_RESOLUTION
	default 10

configdefault PLATFORM_EC_ADC_OVERSAMPLING
	default 0

# Set the system clock
configdefault SYS_CLOCK_HW_CYCLES_PER_SEC
	default 32768

# Initialize the onboard SPI flash earlier than the upstream Zephyr default
# of 80. This makes the SPI flash available early enough for the CrOS flash
# and CBI drivers. (b/423808174)
configdefault SPI_NOR_INIT_PRIORITY
	default 54

endif # SOC_FAMILY_MICROCHIP_MEC
