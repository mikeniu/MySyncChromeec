if SOC_EGIS_ET171

DT_CHOSEN_Z_SRAM := zephyr,sram

configdefault FLASH_BASE_ADDRESS
	# The spi0 node is used for XIP execution
	default $(dt_nodelabel_reg_addr_hex,spi0,1)

configdefault CROS_EC_PROGRAM_MEMORY_BASE
	default FLASH_BASE_ADDRESS

configdefault PLATFORM_EC_MAPPED_STORAGE_BASE
	default FLASH_BASE_ADDRESS

configdefault CROS_EC_RAM_BASE
	default SRAM_BASE_ADDRESS

configdefault CROS_EC_DATA_RAM_SIZE
	default $(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_SRAM))

configdefault CROS_EC_RAM_SIZE
	default $(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_SRAM))

configdefault CROS_EC_RO_MEM_OFF
	default $(dt_node_int_prop_hex,/binman/wp-ro/ec-ro,offset)

configdefault CROS_EC_RO_SIZE
	default $(dt_node_int_prop_hex,/binman/wp-ro/ec-ro,size)

configdefault SOC_EGIS_ET171_VENDOR_FIRMWARE_SIZE
	# Use the RO size minus the signature size for secure boot
	default $(sub_hex,$(dt_node_int_prop_hex,/binman/wp-ro/ec-ro,size),0x40)

configdefault CROS_EC_RW_MEM_OFF
	default $(dt_node_int_prop_hex,/binman/ec-rw,offset)

# Tell the linker where the RO/RW part starts.
configdefault FLASH_LOAD_OFFSET
	default CROS_EC_RO_MEM_OFF if CROS_EC_RO
	default CROS_EC_RW_MEM_OFF if CROS_EC_RW

# Tell the linker is it can use flash till the end.
configdefault FLASH_LOAD_SIZE
	default CROS_EC_RO_SIZE if CROS_EC_RO
	default CROS_EC_RW_SIZE if CROS_EC_RW

endif # SOC_EGIS_ET171
