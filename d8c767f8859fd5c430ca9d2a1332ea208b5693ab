      "unresolved": true
    },
    {
      "key": {
        "uuid": "4f6921d9_bd5f9f95",
        "filename": "chip/ish/host_command_heci.c",
        "patchSetId": 3
      },
      "lineNbr": 85,
      "author": {
        "id": 1259838
      },
      "writtenOn": "2019-02-13T23:47:10Z",
      "side": 1,
      "message": "I agree that we should send an error back.\n\nAs I was adding that code. I really started to look at this ISHTP layer, and I don\u0027t think that it gives us that much (especially for host commands).\n\nI ended up removing the cros_ec_ishtp_msg_hdr layer (and command interface) and we can plan on making a new HECI client with a different guid that and publish information from ISH to AP.\n\nRemoving the layer made the code simpler and there are less error conditions :)",
      "parentUuid": "b35a2ba6_b4cc37c8",
      "range": {
        "startLine": 85,
        "startChar": 6,
        "endLine": 85,
        "endChar": 65
      },
      "revId": "d8c767f8859fd5c430ca9d2a1332ea208b5693ab",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba",
      "unresolved": false
    },
