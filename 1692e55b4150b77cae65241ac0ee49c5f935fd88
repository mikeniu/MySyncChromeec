      "message": "In order to add more comprehensive unit tests, we need to abstract out the `libusb` code into a mockable interface. Here is Gemini code to do this. Verify for correctness and make sure everything compiles and tests pass:\n\n----\n\n### Step 1: Define the Hardware Interface\n\nCreate a pure virtual contract that uses modern C++ types to abstract the USB operations. This ensures the rest of the application is isolated from the `libusb` C-API.\n\n**Create `util/elan/usb_backend.h**`\n\n```cpp\n// Copyright 2026 The ChromiumOS Authors\n// Use of this source code is governed by a BSD-style license that can be\n// found in the LICENSE file.\n\n#ifndef UTIL_ELAN_USB_BACKEND_H_\n#define UTIL_ELAN_USB_BACKEND_H_\n\n#include \u003cchrono\u003e\n#include \u003ccstdint\u003e\n#include \u003cspan\u003e\n\nnamespace elan {\n\nclass UsbBackend {\n public:\n  virtual ~UsbBackend() \u003d default;\n\n  virtual int Initialize() \u003d 0;\n  virtual int OpenDevice(uint16_t vid, uint16_t pid) \u003d 0;\n  virtual int InterruptTransfer(uint8_t endpoint, std::span\u003cuint8_t\u003e data,\n                                std::chrono::milliseconds timeout) \u003d 0;\n  virtual void Release() \u003d 0;\n};\n\n}  // namespace elan\n\n#endif\n\n```\n\n---\n\n### Step 2: Implement the Production Backend\n\nCreate the concrete implementation that manages the physical hardware.\n\n**Create `util/elan/libusb_backend.h**`\n\n```cpp\n// Copyright 2026 The ChromiumOS Authors\n// Use of this source code is governed by a BSD-style license that can be\n// found in the LICENSE file.\n\n#ifndef UTIL_ELAN_LIBUSB_BACKEND_H_\n#define UTIL_ELAN_LIBUSB_BACKEND_H_\n\n#include \u003clibusb-1.0/libusb.h\u003e\n\n#include \u003cchrono\u003e\n#include \u003ccstdint\u003e\n#include \u003cspan\u003e\n#include \u003cvector\u003e\n\n#include \"usb_backend.h\"\n\nnamespace elan {\n\nclass LibusbBackend : public UsbBackend {\n public:\n  LibusbBackend();\n  ~LibusbBackend() override;\n\n  // Prevent copying/moving to safely manage raw handles\n  LibusbBackend(const LibusbBackend\u0026) \u003d delete;\n  LibusbBackend\u0026 operator\u003d(const LibusbBackend\u0026) \u003d delete;\n\n  int Initialize() override;\n  int OpenDevice(uint16_t vid, uint16_t pid) override;\n  int InterruptTransfer(uint8_t endpoint, std::span\u003cuint8_t\u003e data,\n                        std::chrono::milliseconds timeout) override;\n  void Release() override;\n\n private:\n  libusb_device_handle* dev_handle_ \u003d nullptr;\n  bool libusb_initialized_ \u003d false;\n  std::vector\u003cint\u003e claimed_interfaces_;\n  std::vector\u003cint\u003e detached_kernel_drivers_;\n};\n\n}  // namespace elan\n\n#endif\n\n```\n\n**Create `util/elan/libusb_backend.cc**`\n\n```cpp\n// Copyright 2026 The ChromiumOS Authors\n// Use of this source code is governed by a BSD-style license that can be\n// found in the LICENSE file.\n\n#include \"libusb_backend.h\"\n\n#include \u003cmemory\u003e\n\nnamespace elan {\n\nLibusbBackend::LibusbBackend() \u003d default;\n\nLibusbBackend::~LibusbBackend() {\n  Release();\n  if (libusb_initialized_) {\n    libusb_exit(nullptr);\n  }\n}\n\nint LibusbBackend::Initialize() {\n  if (!libusb_initialized_) {\n    int err \u003d libusb_init(nullptr);\n    if (err \u003d\u003d 0) {\n      libusb_initialized_ \u003d true;\n    }\n    return err;\n  }\n  return 0;\n}\n\nint LibusbBackend::OpenDevice(uint16_t vid, uint16_t pid) {\n  libusb_device** raw_list \u003d nullptr;\n  ssize_t usb_dev_count \u003d libusb_get_device_list(nullptr, \u0026raw_list);\n  if (usb_dev_count \u003c 0) return static_cast\u003cint\u003e(usb_dev_count);\n\n  std::unique_ptr\u003clibusb_device*, decltype(\u0026libusb_free_device_list)\u003e list(\n      raw_list, [](libusb_device** l) { libusb_free_device_list(l, 1); });\n\n  libusb_device* found_dev \u003d nullptr;\n  for (ssize_t i \u003d 0; i \u003c usb_dev_count; i++) {\n    struct libusb_device_descriptor desc \u003d {0};\n    if (libusb_get_device_descriptor(list.get()[i], \u0026desc) \u003d\u003d 0) {\n      if (desc.idVendor \u003d\u003d vid \u0026\u0026 desc.idProduct \u003d\u003d pid) {\n        found_dev \u003d list.get()[i];\n        break;\n      }\n    }\n  }\n\n  if (!found_dev) return LIBUSB_ERROR_NO_DEVICE;\n\n  libusb_config_descriptor* config \u003d nullptr;\n  int err \u003d libusb_get_config_descriptor(found_dev, 0, \u0026config);\n  if (err !\u003d 0) return err;\n\n  for (int i \u003d 0; i \u003c config-\u003ebNumInterfaces; i++) {\n    const struct libusb_interface* inter \u003d \u0026config-\u003einterface[i];\n    for (int j \u003d 0; j \u003c inter-\u003enum_altsetting; j++) {\n      if (inter-\u003ealtsetting[j].bInterfaceClass \u003d\u003d LIBUSB_CLASS_HID) {\n        claimed_interfaces_.push_back(inter-\u003ealtsetting[j].bInterfaceNumber);\n        break;\n      }\n    }\n  }\n  libusb_free_config_descriptor(config);\n\n  err \u003d libusb_open(found_dev, \u0026dev_handle_);\n  if (err !\u003d 0) return err;\n\n  for (int interface_num : claimed_interfaces_) {\n    if (libusb_kernel_driver_active(dev_handle_, interface_num) \u003d\u003d 1) {\n      libusb_detach_kernel_driver(dev_handle_, interface_num);\n      detached_kernel_drivers_.push_back(interface_num);\n    }\n    err \u003d libusb_claim_interface(dev_handle_, interface_num);\n    if (err !\u003d 0) {\n      Release();\n      return err;\n    }\n  }\n  return 0;\n}\n\nint LibusbBackend::InterruptTransfer(uint8_t endpoint, std::span\u003cuint8_t\u003e data,\n                                     std::chrono::milliseconds timeout) {\n  if (!dev_handle_) return LIBUSB_ERROR_NO_DEVICE;\n\n  int transferred \u003d 0;\n  unsigned int c_timeout \u003d static_cast\u003cunsigned int\u003e(timeout.count());\n\n  int err \u003d libusb_interrupt_transfer(\n      dev_handle_, endpoint, data.data(), static_cast\u003cint\u003e(data.size()),\n      \u0026transferred, c_timeout);\n\n  if (err !\u003d 0) return err;\n  if (transferred !\u003d static_cast\u003cint\u003e(data.size())) return LIBUSB_ERROR_IO;\n\n  return 0;\n}\n\nvoid LibusbBackend::Release() {\n  if (!dev_handle_) return;\n\n  for (int interface_num : claimed_interfaces_) {\n    libusb_release_interface(dev_handle_, interface_num);\n  }\n  claimed_interfaces_.clear();\n\n  for (int interface_num : detached_kernel_drivers_) {\n    libusb_attach_kernel_driver(dev_handle_, interface_num);\n  }\n  detached_kernel_drivers_.clear();\n\n  libusb_close(dev_handle_);\n  dev_handle_ \u003d nullptr;\n}\n\n}  // namespace elan\n\n```\n\n---\n\n### Step 3: Refactor the Business Logic\n\nModify `IapControl` to accept the backend dependency and remove all hardware-specific code.\n\n**Modify `util/elan/iap_control.h**`\n\n```cpp\n// Replace \u003clibusb-1.0/libusb.h\u003e with:\n#include \"usb_backend.h\"\n\n// Inside class IapControl:\n public:\n  explicit IapControl(std::unique_ptr\u003cUsbBackend\u003e usb_backend);\n  ~IapControl() \u003d default;\n\n private:\n  // Remove libusb_initialized_, dev_handle_ptr_, hid_interfaces_, hid_detach_interfaces_\n  // Remove OpenDevice and ReleaseResource signatures\n  \n  std::function\u003cvoid(size_t, size_t)\u003e progress_callback_;\n  std::unique_ptr\u003cUsbBackend\u003e usb_;\n\n```\n\n**Modify `util/elan/iap_control.cc**`\n\n```cpp\n// Add to includes:\n#include \u003cchrono\u003e\nusing namespace std::chrono_literals;\n\n// Update constructor:\nIapControl::IapControl(std::unique_ptr\u003cUsbBackend\u003e usb_backend) \n    : usb_(std::move(usb_backend)) {}\n\n// Update Initialize:\nstd::expected\u003cvoid, IapError\u003e IapControl::Initialize(uint16_t vid, uint16_t pid) {\n  if (int err \u003d usb_-\u003eInitialize(); err !\u003d 0) {\n    return std::unexpected(IapError::UsbInitFailed);\n  }\n  if (int err \u003d usb_-\u003eOpenDevice(vid, pid); err !\u003d 0) {\n    return std::unexpected(IapError::DeviceNotFound);\n  }\n  return {};\n}\n\n// Update DoUsbTransfer:\nstd::expected\u003cvoid, IapError\u003e IapControl::DoUsbTransfer(\n    uint8_t endpoint, std::span\u003cuint8_t\u003e buff,\n    const std::source_location location) {\n  if (buff.empty()) {\n    return std::unexpected(IapError::BufferEmpty);\n  }\n\n  if (int err \u003d usb_-\u003eInterruptTransfer(endpoint, buff, 1000ms); err !\u003d 0) {\n    LogErr(\"[IAP] {} - transfer fail, code: {}\\n\", location.function_name(), err);\n    return std::unexpected(IapError::TransferFailed);\n  }\n  return {};\n}\n\n// DELETE IapControl::~IapControl\n// DELETE IapControl::OpenDevice\n// DELETE IapControl::ReleaseResource\n\n```\n\n---\n\n### Step 4: Wire the CLI (Composition Root)\n\nInject the concrete backend implementation into the business logic.\n\n**Modify `util/elan/iap_tool.cc**`\n\n```cpp\n// Add include:\n#include \"libusb_backend.h\"\n\n// Inside main():\nint main(int argc, char *argv[]) {\n  // ... parse command line ...\n\n  // Instantiate the physical hardware backend\n  auto usb_backend \u003d std::make_unique\u003celan::LibusbBackend\u003e();\n\n  // Inject it into the control logic\n  elan::IapControl iap_ctrl(std::move(usb_backend));\n\n  if (auto res \u003d iap_ctrl.Initialize(cmd_line-\u003evid, cmd_line-\u003epid); !res) {\n    LogErr(\"[IAP] Device initialization failed: {}\\n\", elan::ToString(res.error()));\n    return EXIT_FAILURE;\n  }\n  \n  // ... rest of execution ...\n\n```\n\n---\n\n### Step 5: Create the Mock for Testing\n\nGenerate the Google Mock class for isolated testing.\n\n**Create `util/elan/mock_usb_backend.h**`\n\n```cpp\n// Copyright 2026 The ChromiumOS Authors\n// Use of this source code is governed by a BSD-style license that can be\n// found in the LICENSE file.\n\n#ifndef UTIL_ELAN_MOCK_USB_BACKEND_H_\n#define UTIL_ELAN_MOCK_USB_BACKEND_H_\n\n#include \u003cgmock/gmock.h\u003e\n\n#include \"usb_backend.h\"\n\nnamespace elan {\n\nclass MockUsbBackend : public UsbBackend {\n public:\n  MOCK_METHOD(int, Initialize, (), (override));\n  MOCK_METHOD(int, OpenDevice, (uint16_t vid, uint16_t pid), (override));\n  MOCK_METHOD(int, InterruptTransfer,\n              (uint8_t endpoint, std::span\u003cuint8_t\u003e data,\n               std::chrono::milliseconds timeout),\n              (override));\n  MOCK_METHOD(void, Release, (), (override));\n};\n\n}  // namespace elan\n\n#endif\n\n```\n\n---\n\n### Step 6: Create the Separate Test Files\n\nSplit the original `elaniap_test.cc` into distinct modules to test logic without hardware.\n\n**Create `util/elan/iap_control_test.cc**`\n\n```cpp\n#include \u003cgmock/gmock.h\u003e\n#include \u003cgtest/gtest.h\u003e\n\n#include \u003cmemory\u003e\n\n#include \"iap_control.h\"\n#include \"mock_usb_backend.h\"\n\nusing ::testing::_;\nusing ::testing::Return;\n\nnamespace elan {\nnamespace {\n\nclass IapControlTest : public ::testing::Test {\n protected:\n  void SetUp() override {\n    auto mock_backend \u003d std::make_unique\u003cMockUsbBackend\u003e();\n    mock_usb_ \u003d mock_backend.get();\n    ctrl_ \u003d std::make_unique\u003cIapControl\u003e(std::move(mock_backend));\n  }\n\n  MockUsbBackend* mock_usb_;\n  std::unique_ptr\u003cIapControl\u003e ctrl_;\n};\n\nTEST_F(IapControlTest, InitializeSucceeds) {\n  EXPECT_CALL(*mock_usb_, Initialize()).WillOnce(Return(0));\n  EXPECT_CALL(*mock_usb_, OpenDevice(kBootVid, kBootPid)).WillOnce(Return(0));\n\n  auto result \u003d ctrl_-\u003eInitialize(kBootVid, kBootPid);\n  EXPECT_TRUE(result.has_value());\n}\n\n}  // namespace\n}  // namespace elan\n\n```\n\n---\n\n### Step 7: Update the Build System\n\nConfigure the Makefile to compile the production tool and the single, unified test binary.\n\n**Modify `util/elan/build.mk**`\n\n```makefile\n# Copyright 2026 The ChromiumOS Authors\n# Use of this source code is governed by a BSD-style license that can be\n# found in the LICENSE file.\n\n_cur_dir :\u003d $(notdir $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST)))))\n\n# 1. Build the Main Production Tool\nhost-util-bin-cxx-y +\u003d elaniap_tool\nelaniap_tool-objs :\u003d $(addprefix $(_cur_dir)/, \\\n\tiap_tool.o \\\n\tiap_control.o \\\n\tfile_control.o \\\n\tlibusb_backend.o \\\n)\n\n_elaniap_tool_bin :\u003d $(out)/util/elaniap_tool\n$(_elaniap_tool_bin): HOST_CXXFLAGS+\u003d-Iutil/elan\n$(_elaniap_tool_bin): HOST_CXXFLAGS+\u003d$(shell $(HOST_PKG_CONFIG) --cflags libusb-1.0)\n$(_elaniap_tool_bin): HOST_LDFLAGS+\u003d$(shell $(HOST_PKG_CONFIG) --libs libusb-1.0)\n\n# 2. Build the Unified Test Binary (Excludes libusb_backend.o)\nhost-util-bin-cxx-y +\u003d elaniap_test_runner\nelaniap_test_runner-objs :\u003d $(addprefix $(_cur_dir)/, \\\n\tfile_control_test.o \\\n\tiap_control_test.o \\\n\tutility_test.o \\\n\tfile_control.o \\\n\tiap_control.o \\\n)\n\n_elaniap_test_bin :\u003d $(out)/util/elaniap_test_runner\n$(_elaniap_test_bin): HOST_CXXFLAGS+\u003d-Iutil/elan\n$(_elaniap_test_bin): HOST_CXXFLAGS+\u003d$(shell $(HOST_PKG_CONFIG) --cflags gtest gmock)\n$(_elaniap_test_bin): HOST_LDFLAGS+\u003d$(shell $(HOST_PKG_CONFIG) --libs gtest gtest_main gmock)\n\n```",
