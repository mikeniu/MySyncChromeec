      "message": "This is confusing. Let\u0027s use strings to make it clearer:\n\n```\nnone: Disable all write protection.\nboot: Protect only the bootloader.\nro:   Protect the bootloader and RO region.\nall:  Protect the entire flash (Bootloader, RO, and RW).\n```\n\nHere is code from Gemini. Make sure that it matches the actual protection levels:\n\n----\n\nHere are all the changes needed across the codebase to fully implement the intuitive, string-based `flash_get_protect` and `flash_set_protect` UX.\n\n### 1. `util/focaltech/updater.h`\n\nUpdate the `FlashWpArea` enum to make the names logically match the string names, and add the `ToString` helper right below it.\n\n```cpp\nenum class FlashWpArea : uint32_t {\n  kUnknown,\n  kNone,     // Was kAll (Disable all protection)\n  kBoot,     // Protect bootloader\n  kRo,       // Protect bootloader + RO\n  kAll,      // Was kRw (Protect everything)\n  kOutRange,\n};\n\nconstexpr std::string_view ToString(FlashWpArea area) {\n  switch (area) {\n    case FlashWpArea::kNone: return \"none\";\n    case FlashWpArea::kBoot: return \"boot\";\n    case FlashWpArea::kRo:   return \"ro\";\n    case FlashWpArea::kAll:  return \"all\";\n    default: return \"unknown\";\n  }\n}\n\n```\n\n### 2. `util/focaltech/cli.h`\n\nUpdate the `AppConfig` struct to hold the strongly-typed enum instead of a raw `uint32_t`.\n\n```cpp\n// Remove `uint32_t action_param \u003d 0;` and replace with:\nstruct AppConfig {\n  Command cmd \u003d Command::kUnknown;\n  std::string_view ec_bin;\n  FlashWpArea wp_area \u003d FlashWpArea::kUnknown;\n};\n\n```\n\n### 3. `util/focaltech/cli.cc`\n\nAdd the string-to-enum parser, update `ParseArguments` to use it, and fix the `ExecuteCommand` logging.\n\n**Add the parser (near the top, inside the anonymous namespace):**\n\n```cpp\nstd::expected\u003cFlashWpArea, Error\u003e ParseWpArea(std::string_view arg) {\n  if (arg \u003d\u003d \"none\") return FlashWpArea::kNone;\n  if (arg \u003d\u003d \"boot\") return FlashWpArea::kBoot;\n  if (arg \u003d\u003d \"ro\")   return FlashWpArea::kRo;\n  if (arg \u003d\u003d \"all\")  return FlashWpArea::kAll;\n  \n  return std::unexpected(Error::kParameterError);\n}\n\n```\n\n**Update `ParseArguments`:**\n\n```cpp\n  } else if (config.cmd \u003d\u003d Command::kSetFlashWp) {\n    if (args.size() \u003c 2) {\n      FT_LOGE(\"flash_set_protect requires an area parameter (none, boot, ro, all).\");\n      return std::unexpected(Error::kParameterError);\n    }\n    auto wp_res \u003d ParseWpArea(args[1]);\n    if (!wp_res) {\n      FT_LOGE(\"Invalid protection area: \u0027{}\u0027. Must be none, boot, ro, or all.\", args[1]);\n      return std::unexpected(Error::kParameterError);\n    }\n    config.wp_area \u003d *wp_res;\n  }\n  return config;\n\n```\n\n**Update `ExecuteCommand`:**\n\n```cpp\n    case Command::kSetFlashWp:\n      // Replaced config.action_param\n      return SetFlashProtection(usb_device, config.wp_area, current_mode);\n\n    case Command::kGetFlashWp: {\n      auto wp_res \u003d GetFlashProtection(usb_device, current_mode);\n      if (!wp_res) {\n        return std::unexpected(wp_res.error());\n      }\n      // Replaced std::to_underlying with ToString\n      FT_LOGI(\"Flash write protect area \u003d {}\", ToString(*wp_res));\n      return {};\n    }\n\n```\n\n### 4. `util/focaltech/updater.cc`\n\nUpdate the logging inside the implementation to use `ToString` instead of `std::to_underlying`.\n\n**In `GetFlashProtection`:**\n\n```cpp\n  auto wp_area \u003d static_cast\u003cFlashWpArea\u003e(data[0]);\n  FT_LOGI(\"Flash write-protect area \u003d {}\", ToString(wp_area)); \n  return wp_area;\n\n```\n\n**In `SetFlashProtection`:**\n\n```cpp\n  FT_LOGI(\"Setting flash write protect to area: {}\", ToString(wp_area));\n\n  // ... (USB transmission logic) ...\n\n  FT_LOGI(\"Flash write-protect successfully set to area {}\", ToString(wp_area));\n  return {};\n\n```\n\n### 5. `util/focaltech/ft_help.h`\n\nRewrite the documentation for the `flash_set_protect` command to reflect the new, intuitive arguments.\n\n```cpp\n  flash_set_protect \u003carea\u003e Set the flash write protection area.\n                           (Requires bootloader mode).\n                           Areas:\n                             none: Disable all write protection.\n                             boot: Protect only the bootloader.\n                             ro:   Protect the bootloader and RO region.\n                             all:  Protect the entire flash (Bootloader, RO, and RW).\n\n```\n\n### 6. `util/focaltech/cli_test.cc`\n\nUpdate your parsing tests to use strings and check against the `wp_area` field.\n\n```cpp\nTEST(CliTest, ParseArguments_SetFlashWp_Valid) {\n  std::vector\u003cstd::string_view\u003e args \u003d {\"flash_set_protect\", \"ro\"};\n  auto config \u003d ParseArguments(args);\n  ASSERT_TRUE(config.has_value());\n  EXPECT_EQ(config-\u003ecmd, Command::kSetFlashWp);\n  EXPECT_EQ(config-\u003ewp_area, FlashWpArea::kRo);\n}\n\nTEST(CliTest, ParseArguments_SetFlashWp_InvalidParam) {\n  std::vector\u003cstd::string_view\u003e args \u003d {\"flash_set_protect\", \"invalid_area\"};\n  auto config \u003d ParseArguments(args);\n  EXPECT_FALSE(config.has_value());\n  EXPECT_EQ(config.error(), Error::kParameterError);\n}\n\n```\n\n### 7. `util/focaltech/updater_test.cc`\n\nFinally, swap the old `kRw` enum for the new `kAll` enum in your USB mock tests.\n\n```cpp\n// In TEST(UpdaterTest, SetFlashProtection_Success)\n  EXPECT_CALL(*mock, Recv(_, _))\n      // ...\n      .WillOnce(Invoke(\n          [](std::span\u003cuint8_t\u003e data, auto) -\u003e std::expected\u003cint, Error\u003e {\n            std::fill(data.begin(), data.end(), 0);\n            data[0] \u003d static_cast\u003cuint8_t\u003e(FlashWpArea::kAll); // Was kRw\n            return kFlashWpBufferSize;\n          }))\n      // ...\n\n  UsbDevice device(std::move(mock));\n  auto res \u003d SetFlashProtection(device, FlashWpArea::kAll, De