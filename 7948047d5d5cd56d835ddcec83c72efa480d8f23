      "message": "Let\u0027s pull these out into a separate header file. Instructions from Gemini:\n\n----\n\n### Step 1: Create `util/egis/bootrom_protocol.h`\n\nCreate a new file to serve as the strict, dependency-free definition of the hardware\u0027s wire format.\n\n**Create `util/egis/bootrom_protocol.h` and insert:**\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#ifndef UTIL_EGIS_BOOTROM_PROTOCOL_H_\n#define UTIL_EGIS_BOOTROM_PROTOCOL_H_\n\n#include \u003carray\u003e\n#include \u003ccstddef\u003e\n#include \u003ccstdint\u003e\n\n#include \"crypto_util.h\"\n\nnamespace egis::EgisBootrom {\n\n// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n// Mutually Exclusive Options (Strongly Typed)\n// \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\nenum class CommandId : uint8_t {\n  kGetBootInfo \u003d 0x10,\n  kFlashInfo \u003d 0x11,\n  kSystemReset \u003d 0x12,\n  kMemRead \u003d 0x20,\n  kMemWrite \u003d 0x21,\n  kFlashErase \u003d 0x22,\n  kOtpRead \u003d 0x23,\n  kOtpWrite \u003d 0x24,\n  kSecureWrapped \u003d 0xF4,\n};\n\nenum class AccessSiz