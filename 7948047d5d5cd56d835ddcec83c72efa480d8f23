tatic_assert(sizeof(SecureCommandAesHeader) \u003d\u003d 34, \"Must be exactly 34 bytes\");\n\nstruct SecureResponseHeader {\n  uint16_t status;\n  uint32_t payload_len;\n} __attribute__((packed));\nstatic_assert(sizeof(SecureResponseHeader) \u003d\u003d 6, \"Must be exactly 6 bytes\");\n\n}  // namespace egis::EgisBootrom\n\n#endif  // UTIL_EGIS_BOOTROM_PROTOCOL_H_\n\n```\n\n---\n\n### Step 2: Refactor `bootrom.h`\n\nStrip out all the protocol definitions and include the new file. This shrinks the header from 335 lines to roughly 85 lines.\n\n**Modify `util/egis/bootrom.h`:**\n\n```cpp\n// 1. Add the protocol header include\n#include \"bootrom_protocol.h\"\n\n// 2. Delete the entire `namespace EgisBootrom { ... }` block from bootrom.h\n\n// 3. Delete the `SecureCommandShaHeader`, `SecureCommandAesHeader`, and `SecureResponseHeader` structs from inside the `BootromComm` class definition.\n\n// 4. Leave the remaining constants inside `BootromComm`:\nclass BootromComm {\n public:\n  static constexpr size_t kStatusHeaderSize \u003d 2;\n  static constexpr size_t kWrappedCommandSize \u003d 4;\n  static constexpr size_t kSha256DigestSize \u003d 32;\n  static constexpr size_t kScHeaderSizeSha \u003d\n      kStatusHeaderSize + kWrappedCommandSize + kSha256DigestSize;\n  static constexpr size_t kScHeaderSizeAes \u003d\n      kStatusHeaderSize + kWrappedCommandSize + crypto::kAesGcmIvSize +\n      crypto::kAesGcmTagSize;\n\n  static constexpr size_t kMaxPayloadSize \u003d 4 * 1024;\n  // ... rest of the class remains unchanged ...\n\n```\n\n---\n\n### Step 3: Refactor Implementations (Enum Conversions)\n\nNow that `CommandId`, `AccessSize`, and `SpiFlashOpcode` are strongly typed `enum class` types, you must cast them when reading raw command buffers or sending raw data to generic `uint32_t` registers.\n\n**1. Modify `util/egis/bootrom.cc`:**\n\n```cpp\n// Change 1: In SendBootromCommandSha()\n  EgisBootrom::SecureCommandShaHeader req_hdr{\n      .algo \u003d std::to_underlyi