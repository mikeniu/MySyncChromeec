      "writtenOn": "2026-04-07T10:01:28Z",
      "side": 1,
      "message": "Yes, In theory, it\u0027s true, but if we manually set th pin state, it may cause XIP fail. So, we don\u0027t use hardware #WP pin to protect the falsh.",
      "parentUuid": "256acd84_ac74d52a",
      "range": {
        "startLine": 17,
        "startChar": 0,
        "endLine": 17,
        "endChar": 76
