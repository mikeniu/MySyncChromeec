      "lineNbr": 17,
      "author": {
        "id": 1438457
      },
      "writtenOn": "2026-04-07T05:30:54Z",
      "side": 1,
      "message": "But is it possible to control it? E.g. change to normal SPI mode and manually set the pin state?",
      "parentUuid": "723deb0a_996efae6",
      "range": {
        "startLine": 17,
        "startChar": 0,
        "endLine": 17,
        "endChar": 76
      },
      "revId": "eff8e3c4208b1841b5b079fe5b52ab2f8b3de378",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
