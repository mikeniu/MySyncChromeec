        "id": 4219742
      },
      "writtenOn": "2026-04-07T01:49:10Z",
      "side": 1,
      "message": "Yes, it\u0027s ture, the #WP pin is used for QSPI.",
      "parentUuid": "86b425d3_0d51cf73",
      "range": {
        "startLine": 17,
        "startChar": 0,
        "endLine": 17,
        "endChar": 76
