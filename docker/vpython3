# Stand-in for vpython3, so that EC scripts such as twister, which start with
# "#!/usr/bin/env vpython3", run directly in the container. The real vpython3
# comes from depot_tools and would build its own environment from CIPD in
# every container. Plain python3 is enough, because the image installs the
# Zephyr requirements that cover twister's dependencies.
exec python3 "$@"
