    },
    {
      "unresolved": true,
      "key": {
        "uuid": "06effee5_c12fccfc",
        "filename": "util/elan/iap_control.cc",
        "patchSetId": 20
      },
      "lineNbr": 575,
      "author": {
        "id": 1314845
      },
      "writtenOn": "2026-05-20T19:53:12Z",
      "side": 1,
      "message": "We can solve this problem (and improve overall error handling) by using [`std::expected`](https://en.cppreference.com/cpp/utility/expected). Here\u0027s a Gemini-walkthrough (double-check that it\u0027s correct):\n\n----\n\n## Step 1: Define Your Error Vocabulary\n\nFirst, create a strongly typed enum to represent your failure states. Since both file handling and USB handling need this, place it in utility.h.\n\n**Update utility.h**:\n\n```c\n#include \u003cexpected\u003e\n#include \u003cstring_view\u003e\n\nnamespace elan {\n\nenum class IapError {\n  None,\n  FileOpenFailed,\n  FileReadFailed,\n  InvalidFileSize,\n  UsbInitFailed,\n  DeviceNotFound,\n  DeviceOpenFailed,\n  TransferFailed,\n  InvalidFirmware,\n  ChecksumMismatch,\n  BufferTooSmall,\n  CommandFailed\n};\n\nconstexpr std::string_view ToString(IapError err) {\n  switch (err) {\n    case IapError::FileOpenFailed: return \"Failed to open file\";\n    case IapError::FileReadFailed: return \"Failed to read file data\";\n    case IapError::InvalidFileSize: return \"File size is 0 or invalid\";\n    case IapError::UsbInitFailed: return \"libusb initialization failed\";\n    case IapError::DeviceNotFound: return \"Target USB device not found\";\n    case IapError::TransferFailed: return \"USB transfer failed or incomplete\";\n    case IapError::InvalidFirmware: return \"Firmware prefix does not match Google requirement\";\n    case IapError::ChecksumMismatch: return \"Checksum verification failed\";\n    case IapError::BufferTooSmall: return \"Buffer too small for operation\";\n    case IapError::CommandFailed: return \"Device rejected command\";\n    default: return \"Unknown Error\";\n  }\n}\n\n} // namespace elan\n\n```\n\n---\n\n## Step 2: Update File Control\n\nChange your return types from std::optional to std::expected\\\u003cT, elan::IapError\\\u003e.\n\n**Update file\\_control.h**:\n\n```c\n#include \u003cexpected\u003e\n#include \"utility.h\"\n\nstd::expected\u003csize_t, elan::IapError\u003e GetBinarySize(const std::string \u0026file_path);\nstd::expected\u003cstd::vector\u003cuint8_t\u003e, elan::IapError\u003e GetBinary(const std::string \u0026file_path);\n\n```\n\n**Update file\\_control.cc**: Replace return std::nullopt; with return std::unexpected(...). Remove the LogErr calls, as the caller will handle logging.\n\n```c\nstd::expected\u003csize_t, elan::IapError\u003e GetBinarySize(const std::string \u0026file_path) {\n  std::ifstream bin_file(file_path, std::ios::binary | std::ios::ate);\n  if (!bin_file) {\n    return std::unexpected(elan::IapError::FileOpenFailed);\n  }\n\n  std::streampos pos \u003d bin_file.tellg();\n  if (pos \u003d\u003d std::streampos(-1) || pos \u003d\u003d 0) {\n    return std::unexpected(elan::IapError::InvalidFileSize);\n  }\n  return static_cast\u003csize_t\u003e(pos);\n}\n\nstd::expected\u003cstd::vector\u003cuint8_t\u003e, elan::IapError\u003e GetBinary(const std::string \u0026file_path) {\n  auto size_res \u003d GetBinarySize(file_path);\n  if (!size_res) {\n    return std::unexpected(size_res.error()); // Bubble up the specific error\n  }\n\n  std::ifstream bin_file(file_path, std::ios::binary);\n  if (!bin_file) {\n    return std::unexpected(elan::IapError::FileOpenFailed);\n  }\n\n  std::vector\u003cuint8_t\u003e buffer(*size_res);\n  if (!bin_file.read(reinterpret_cast\u003cchar *\u003e(buffer.data()), *size_res)) {\n    return std::unexpected(elan::IapError::FileReadFailed);\n  }\n\n  return buffer; // Implicitly converts to expected\u003cT, E\u003e containing the value\n}\n\n```\n\n---\n\n## Step 3: Update IAP Control Definitions\n\nReplace all int returns with std::expected\\\u003cvoid, IapError\\\u003e. Note the use of void — this explicitly states the function succeeds without returning data.\n\n**Update iap\\_control.h**:\n\n```c\n#include \u003cexpected\u003e\n#include \"utility.h\"\n\n// ... existing code ...\n\n  [[nodiscard]] std::expected\u003cvoid, IapError\u003e Initialize(uint16_t vid, uint16_t pid);\n  std::expected\u003cvoid, IapError\u003e RunIapProcess(std::span\u003cconst uint8_t\u003e rom);\n\nprivate:\n  std::expected\u003cvoid, IapError\u003e RunIap(uint8_t iap_mode);\n  std::expected\u003cvoid, IapError\u003e FinishIap(uint32_t checksum);\n  std::expected\u003cFwVerInfo, IapError\u003e GetFwVersion();\n  // Update all other methods (WriteRom, SetRomAddress, OpenDevice, IapCommand, etc.) \n  // to return std::expected\u003cvoid, IapError\u003e instead of int.\n  \n  // Math utilities:\n  std::expected\u003cuint32_t, IapError\u003e Get32Le(std::span\u003cconst uint8_t\u003e buff);\n  std::expected\u003cuint32_t, IapError\u003e GetChecksum(std::span\u003cconst uint8_t\u003e buff);\n\n```\n\n---\n\n## Step 4: Refactor IAP Control Implementation\n\nThe imperative pattern for checking an expected is: if (auto res \\\u003d SomeFunc(); \\!res) return std::unexpected(res.error());\n\n**Example 1: A void-returning function (IapCommand)**\n\n```c\nstd::expected\u003cvoid, IapError\u003e IapControl::IapCommand(std::span\u003cconst uint8_t\u003e buff) {\n  uint8_t stat_recv[kEp2Length] \u003d {};\n\n  if (auto res \u003d IapSendCommand(buff); !res) {\n    return std::unexpected(res.error());\n  }\n\n  if (auto res \u003d IapRecvStatus(stat_recv); !res) {\n    return std::unexpected(res.error());\n  }\n\n  if (stat_recv[0] !\u003d buff[0] || stat_recv[1] !\u003d kErrStaSuccess) {\n    return std::unexpected(IapError::CommandFailed);\n  }\n\n  return {}; // Success for expected\u003cvoid, E\u003e\n}\n\n```\n\n**Example 2: A value-returning function (GetFwVersion)**\n\n```c\nstd::expected\u003cFwVerInfo, IapError\u003e IapControl::GetFwVersion() {\n  uint8_t data_send[kEp1Length] \u003d { kCmdGetFwVersion };\n  uint8_t stat_recv[kEp2Length] \u003d {};\n\n  if (auto res \u003d IapSendCommand(data_send); !res) {\n    return std::unexpected(res.error());\n  }\n\n  if (auto res \u003d IapRecvStatus(stat_recv); !res) {\n    return std::unexpected(res.error());\n  }\n\n  if (stat_recv[0] !\u003d data_send[0] || stat_recv[1] !\u003d kErrStaSuccess) {\n    return std::unexpected(IapError::CommandFailed);\n  }\n\n  auto fw_ver \u003d Get32Le(std::span\u003cconst uint8_t\u003e(stat_recv + 4, 4));\n  if (!fw_ver) {\n    return std::unexpected(fw_ver.error());\n  }\n\n  return FwVerInfo{.fw_ver \u003d *fw_ver, .boot_type \u003d stat_recv[2]};\n}\n\n```\n\n**Example 3: The main process loop (RunIapProcess)**\n\n```c\nstd::expected\u003cvoid, IapError\u003e IapControl::RunIapProcess(std::span\u003cconst uint8_t\u003e rom) {\n  if (auto res \u003d AbortProcess(); !res) return std::unexpected(res.error());\n\n  auto fw_ver_info \u003d GetFwVersion();\n  if (!fw_ver_info) return std::unexpected(fw_ver_info.error());\n\n  // Fixed right-shift bug here from earlier review!\n  uint8_t fw_ver_google \u003d fw_ver_info-\u003efw_ver \u003e\u003e 24; \n  if (fw_ver_google !\u003d kGoogleFwVerPrefix) {\n    return std::unexpected(IapError::InvalidFirmware);\n  }\n\n  if (auto res \u003d RunIap(0); !res) return std::unexpected(res.error());\n  if (auto res \u003d SetRomAddress(0x0000); !res) return std::unexpected(res.error());\n  if (auto res \u003d WriteRom(rom.size()); !res) return std::unexpected(res.error());\n  if (auto res \u003d WriteRomData(rom); !res) return std::unexpected(res.error());\n\n  auto checksum \u003d GetChecksum(rom);\n  if (!checksum) return std::unexpected(checksum.error());\n\n  if (auto res \u003d WriteRomFinish(*checksum); !res) return std::unexpected(res.error());\n\n  // ... (continue for read/verify steps) ...\n\n  return {};\n}\n\n```\n\n---\n\n## Step 5: Clean Up main (iap\\_tool.cc)\n\nBecause errors now bubble up neatly, main becomes the single source of truth for handling and logging fatal errors.\n\n```c\nint main(int argc, char *argv[]) {\n  elan::IapControl iap_ctrl;\n  CommandLineManager command_line_mgr(argc, argv);\n\n  auto cmd_line \u003d command_line_mgr.GetCommandLine();\n  if (!cmd_line) {\n    LogErr(\"[IAP] Failed to parse command line\\n\");\n    return EXIT_FAILURE;\n  }\n\n  if (auto res \u003d iap_ctrl.Initialize(cmd_line-\u003evid, cmd_line-\u003epid); !res) {\n    LogErr(\"[IAP] Device initialization failed: {}\\n\", elan::ToString(res.error()));\n    return EXIT_FAILURE;\n  }\n\n  auto binary \u003d GetBinary(cmd_line-\u003efile_path);\n  if (!binary) {\n    LogErr(\"[IAP] Failed to get binary: {}\\n\", elan::ToString(binary.error()));\n    return EXIT_FAILURE;\n  }\n\n  iap_ctrl.SetProgressCallback(SetProgressBar);\n\n  if (auto res \u003d iap_ctrl.RunIapProcess(*binary); !res) {\n    LogErr(\"[IAP] IAP process failed: {}\\n\", elan::ToString(res.error()));\n    return EXIT_FAILURE;\n  }\n\n  LogInfo(\"[IAP] Update completed successfully.\\n\");\n  return EXIT_SUCCESS;\n}\n\n```",
