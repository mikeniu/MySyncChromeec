      "message": "Here is a fix generated by Gemini. Review for correctness:\n\n----\n\nTo make the top-level functions cleanly handle the different lower-level errors (`BootromError`, `UsbError`, `ParseError`, `std::errc`), we first introduce a unified application-level error enum.\n\nHere is exactly how to wire it up in `et171_flash.cc`:\n\n### 1\\. Define the Top-Level Error Enum\n\nAt the top of `et171_flash.cc` (in the anonymous namespace or `egis` namespace), add an overarching `AppError`:\n\n```c\nenum class AppError {\n  kInvalidArgs,\n  kFileIoError,\n  kCryptoError,\n  kBootromError,\n  kUsbError,\n  kParseError,\n};\n\n```\n\n### 2\\. Refactor the Payload Functions\n\nUpdate `ProgramFlashPayload` (and similarly `ProgramRawCommandPayload`) to return `std::expected\u003cvoid, AppError\u003e` instead of `int`. Use explicit checks to map the lower-level errors up.\n\n```c\nstd::expected\u003cvoid, AppError\u003e ProgramFlashPayload(\n    BootromComm \u0026brom, uint32_t flash_offset, std::span\u003cconst uint8_t\u003e payload) {\n  \n  std::println(\"--- Erasing Flash ---\");\n  const uint32_t sector_mask \u003d EgisBootrom::kFlashSectorSize - 1;\n  uint32_t erase_size \u003d (payload.size() + sector_mask) \u0026 ~sector_mask;\n\n  if (auto res \u003d brom.EraseFlash(flash_offset, erase_size); !res) {\n    std::println(stderr, \"\\n[HALT] Flash Erase failed at offset 0x{:X}: {}\",\n                 flash_offset, ToString(res.error()));\n    return std::unexpected(AppError::kBootromError); // Explicit mapping\n  }\n\n  std::println(\"--- Writing Flash ---\");\n  const size_t chunk_size \u003d BootromComm::kMaxFlashWriteSize;\n  uint32_t current_addr \u003d flash_offset;\n  size_t done \u003d 0;\n\n  for (size_t i \u003d 0; i \u003c payload.size(); i +\u003d chunk_size) {\n    auto chunk \u003d payload.subspan(i, std::min(chunk_size, payload.size() - i));\n    if (auto res \u003d brom.WriteFlash(current_addr, chunk); !res) {\n      std::println(stderr, \"\\n[HALT] Flash Write failed at address 0x{:X}: {}\",\n                   current_addr, ToString(res.error()));\n      return std::unexpected(AppError::kBootromError);\n    }\n    // ... progress printing ...\n  }\n\n  std::println(\"\\n[OK] Flash Full Binary Write successful\");\n  return {}; // Success\n}\n\n```\n\n### 3\\. Refactor the Run Functions\n\nUpdate `RunFlashFw` and `RunFlashCmd` to return `std::expected\u003cvoid, AppError\u003e`. They act as the middle managers, catching `std::errc` from file I/O and passing up the payload errors.\n\n```c\nstd::expected\u003cvoid, AppError\u003e RunFlashFw(const AppConfig \u0026config, BootromComm \u0026brom) {\n  // ... logging ...\n\n  if (config.fw_path.empty()) {\n    std::println(stderr, \"[ERROR] Missing firmware path\");\n    return std::unexpected(AppError::kInvalidArgs);\n  }\n\n  auto firmware_res \u003d ReadBinaryFile(config.fw_path);\n  if (!firmware_res) {\n    std::println(stderr, \"[ERROR] Cannot open or read firmware file...\");\n    return std::unexpected(AppError::kFileIoError);\n  }\n  std::vector\u003cuint8_t\u003e \u0026firmware \u003d firmware_res.value();\n\n  // ... crypto \u0026 setup logic (return std::unexpected(AppError::kCryptoError) on fail) ...\n\n  auto fw_payload \u003d std::span\u003cconst uint8_t\u003e(firmware).subspan(\n      config.flash_offset, size_to_flash);\n\n  // Call the payload function and explicitly pass up its result\n  auto flash_res \u003d ProgramFlashPayload(brom, config.flash_offset, fw_payload);\n  if (!flash_res) {\n    return std::unexpected(flash_res.error());\n  }\n\n  return {};\n}\n\n```\n\n### 4\\. Catch it in `main()`\n\nFinally, `main()` becomes incredibly clean. It just holds an `expected` object, dispatches to the right function, and unwraps the status to return a standard exit code to the OS.\n\n```c\nint main(int argc, char *argv[]) {\n  // ... parse args and initialize USB context ...\n\n  std::expected\u003cvoid, egis::AppError\u003e status;\n\n  // 4. Dispatch to chosen mode\n  if (config.mode \u003d\u003d \"flashfw\") {\n    status \u003d egis::RunFlashFw(config, brom);\n  } else if (config.mode \u003d\u003d \"flashcmd\") {\n    status \u003d egis::RunFlashCmd(config, boot_comm);\n  } else {\n    std::println(stderr, \"[ERROR] Unknown or unhandled mode: {}\", config.mode);\n    status \u003d std::unexpected(egis::AppError::kInvalidArgs);\n  }\n\n  // 5. Final exit handling\n  if (status.has_value()) {\n    // Only attempt system reset if flashing actually succeeded\n    if (auto res \u003d brom.SystemReset(); !res) {\n      std::println(stderr, \"[WARN] System reset command failed: {}\",\n                   egis::ToString(res.error()));\n    }\n    return EXIT_SUCCESS; // 0\n  }\n\n  return EXIT_FAILURE; // 1\n}\n\n```",
