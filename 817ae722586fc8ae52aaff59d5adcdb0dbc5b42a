      "message": "Here\u0027s code that does this that was generated by Gemini. Make sure to review it for correctness.\n\n-----\n\n\nMoving the BoringSSL logic out of `bootrom.cc` and into a dedicated utility file serves three major architectural goals:\n\n1. **Containment of C-APIs:** BoringSSL uses C-style memory management (like `EVP_CIPHER_CTX_new` and raw pointers) and C-style error codes. Isolating this in a dedicated file prevents these lower-level paradigms from bleeding into your modern C++ business logic.  \n2. **Deterministic Testability:** AES-GCM encryption is a pure mathematical function—given the same key, IV, and plaintext, it will always produce the same ciphertext and tag. By decoupling it from the USB stack, you can easily write unit tests for the crypto boundary without needing to mock hardware or USB connections.  \n3. **Reusability and Namespace Isolation:** If the EC application layer eventually needs AES-GCM, it can include the crypto utility without accidentally pulling in Bootrom-specific state machines. Using `namespace egis::crypto` ensures these functions don\u0027t pollute the global or application namespace.\n\n---\n\n### 1\\. The Header: `crypto_util.h`\n\nThis file acts as the clean C++23 boundary. Notice that `\u003copenssl/evp.h\u003e` is deliberately **not** included here so callers are shielded from the library details.\n\n```c\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#ifndef UTIL_EGIS_CRYPTO_UTIL_H_\n#define UTIL_EGIS_CRYPTO_UTIL_H_\n\n#include \u003ccstdint\u003e\n#include \u003cexpected\u003e\n#include \u003cspan\u003e\n#include \u003cstring_view\u003e\n\nnamespace egis::crypto {\n\nenum class CryptoError {\n  kContextAllocationFailed,\n  kInitFailed,\n  kUpdateFailed,\n  kFinalizeFailed,\n  kTagMismatch,\n  kRngFailed,\n};\n\nconstexpr std::string_view ToString(CryptoError err) {\n  switch (err) {\n    case CryptoError::kContextAllocationFailed: return \"Failed to allocate EVP context\";\n    case CryptoError::kInitFailed:              return \"Cipher initialization failed\";\n    case CryptoError::kUpdateFailed:            return \"Cipher update failed\";\n    case CryptoError::kFinalizeFailed:          return \"Cipher finalization failed\";\n    case CryptoError::kTagMismatch:             return \"Authentication tag mismatch\";\n    case CryptoError::kRngFailed:               return \"Secure RNG failed\";\n    default:                                    return \"Unknown crypto error\";\n  }\n}\n\n// Generates a cryptographically secure random IV.\nstd::expected\u003cvoid, CryptoError\u003e GenerateGcmIv(std::span\u003cuint8_t\u003e iv_buf);\n\n// Authenticated AES-256-GCM Encryption.\nstd::expected\u003cvoid, CryptoError\u003e AesGcmEncrypt(\n    std::span\u003cconst uint8_t\u003e key, std::span\u003cconst uint8_t\u003e iv,\n    std::span\u003cconst uint8_t\u003e aad, std::span\u003cconst uint8_t\u003e plaintext,\n    std::span\u003cuint8_t\u003e ciphertext, std::span\u003cuint8_t\u003e tag);\n\n// Authenticated AES-256-GCM Decryption.\nstd::expected\u003cvoid, CryptoError\u003e AesGcmDecrypt(\n    std::span\u003cconst uint8_t\u003e key, std::span\u003cconst uint8_t\u003e iv,\n    std::span\u003cconst uint8_t\u003e aad, std::span\u003cconst uint8_t\u003e ciphertext,\n    std::span\u003cconst uint8_t\u003e tag, std::span\u003cuint8_t\u003e plaintext);\n\n}  // namespace egis::crypto\n\n#endif  // UTIL_EGIS_CRYPTO_UTIL_H_\n\n```\n\n---\n\n### 2\\. The Implementation: `crypto_util.cc`\n\nThis is the only file that interacts with the BoringSSL library directly.\n\n```c\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#include \"crypto_util.h\"\n\n#include \u003cmemory\u003e\n\n#include \u003copenssl/aes.h\u003e\n#include \u003copenssl/crypto.h\u003e\n#include \u003copenssl/evp.h\u003e\n#include \u003copenssl/rand.h\u003e\n\nnamespace egis::crypto {\n\nusing EvpCipherCtxPtr \u003d\n    std::unique_ptr\u003cEVP_CIPHER_CTX, decltype(\u0026::EVP_CIPHER_CTX_free)\u003e;\n\nstd::expected\u003cvoid, CryptoError\u003e GenerateGcmIv(std::span\u003cuint8_t\u003e iv_buf) {\n  if (RAND_bytes(iv_buf.data(), iv_buf.size()) !\u003d 1) {\n    return std::unexpected(CryptoError::kRngFailed);\n  }\n  return {};\n}\n\nstd::expected\u003cvoid, CryptoError\u003e AesGcmEncrypt(\n    std::span\u003cconst uint8_t\u003e key, std::span\u003cconst uint8_t\u003e iv,\n    std::span\u003cconst uint8_t\u003e aad, std::span\u003cconst uint8_t\u003e plaintext,\n    std::span\u003cuint8_t\u003e ciphertext, std::span\u003cuint8_t\u003e tag) {\n  \n  EvpCipherCtxPtr ctx(EVP_CIPHER_CTX_new(), \u0026::EVP_CIPHER_CTX_free);\n  if (!ctx) return std::unexpected(CryptoError::kContextAllocationFailed);\n\n  int len;\n\n  if (EVP_EncryptInit_ex(ctx.get(), EVP_aes_256_gcm(), NULL, NULL, NULL) !\u003d 1 ||\n      EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_SET_IVLEN, iv.size(), NULL) !\u003d 1 ||\n      EVP_EncryptInit_ex(ctx.get(), NULL, NULL, key.data(), iv.data()) !\u003d 1) {\n    return std::unexpected(CryptoError::kInitFailed);\n  }\n\n  if (!aad.empty()) {\n    if (EVP_EncryptUpdate(ctx.get(), NULL, \u0026len, aad.data(), aad.size()) !\u003d 1) {\n      return std::unexpected(CryptoError::kUpdateFailed);\n    }\n  }\n\n  if (EVP_EncryptUpdate(ctx.get(), ciphertext.data(), \u0026len, \n                        plaintext.data(), plaintext.size()) !\u003d 1) {\n    return std::unexpected(CryptoError::kUpdateFailed);\n  }\n\n  if (EVP_EncryptFinal_ex(ctx.get(), ciphertext.data() + len, \u0026len) !\u003d 1 ||\n      EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_GET_TAG, tag.size(), tag.data()) !\u003d 1) {\n    return std::unexpected(CryptoError::kFinalizeFailed);\n  }\n\n  return {};\n}\n\nstd::expected\u003cvoid, CryptoError\u003e AesGcmDecrypt(\n    std::span\u003cconst uint8_t\u003e key, std::span\u003cconst uint8_t\u003e iv,\n    std::span\u003cconst uint8_t\u003e aad, std::span\u003cconst uint8_t\u003e ciphertext,\n    std::span\u003cconst uint8_t\u003e tag, std::span\u003cuint8_t\u003e plaintext) {\n  \n  EvpCipherCtxPtr ctx(EVP_CIPHER_CTX_new(), \u0026::EVP_CIPHER_CTX_free);\n  if (!ctx) return std::unexpected(CryptoError::kContextAllocationFailed);\n\n  int len;\n\n  if (EVP_DecryptInit_ex(ctx.get(), EVP_aes_256_gcm(), NULL, NULL, NULL) !\u003d 1 ||\n      EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_SET_IVLEN, iv.size(), NULL) !\u003d 1 ||\n      EVP_DecryptInit_ex(ctx.get(), NULL, NULL, key.data(), iv.data()) !\u003d 1) {\n    return std::unexpected(CryptoError::kInitFailed);\n  }\n\n  if (!aad.empty()) {\n    if (EVP_DecryptUpdate(ctx.get(), NULL, \u0026len, aad.data(), aad.size()) !\u003d 1) {\n      return std::unexpected(CryptoError::kUpdateFailed);\n    }\n  }\n\n  // NOTE: OpenSSL safely supports in-place decryption where ciphertext and plaintext overlap.\n  if (EVP_DecryptUpdate(ctx.get(), plaintext.data(), \u0026len, \n                        ciphertext.data(), ciphertext.size()) !\u003d 1) {\n    return std::unexpected(CryptoError::kUpdateFailed);\n  }\n\n  if (EVP_CIPHER_CTX_ctrl(ctx.get(), EVP_CTRL_GCM_SET_TAG, tag.size(),\n                          const_cast\u003cuint8_t *\u003e(tag.data())) !\u003d 1) {\n    return std::unexpected(CryptoError::kFinalizeFailed);\n  }\n\n  if (EVP_DecryptFinal_ex(ctx.get(), plaintext.data() + len, \u0026len) \u003c\u003d 0) {\n    return std::unexpected(CryptoError::kTagMismatch);\n  }\n\n  return {};\n}\n\n}  // namespace egis::crypto\n\n```\n\n---\n\n### 3\\. The Caller: `bootrom.cc`\n\nRemove all OpenSSL includes from `bootrom.cc` and replace the old function calls with the namespace equivalents.\n\n```c\n#include \"crypto_util.h\"\n#include \u003cprint\u003e\n\n// ... inside SendBootromCommandAes ...\n\nif (auto res \u003d crypto::GenerateGcmIv(header.iv); !res) {\n  std::println(stderr, \"[ERROR] IV Generation Failed: {}\", crypto::ToString(res.error()));\n  return std::unexpected(BootromError::kGcmIvGenerationFailed);\n}\n\nif (auto res \u003d crypto::AesGcmEncrypt(aes_key_, header.iv, aad_vec, data, \n                                     ciphertext, header.tag); !res) {\n  std::println(stderr, \"[ERROR] Encryption Failed: {}\", crypto::ToString(res.error()));\n  return std::unexpected(BootromError::kGcmEncryptionFailed);\n}\n\n// ... later during decryption ...\n\nif (auto res \u003d crypto::AesGcmDecrypt(aes_key_, rsp_iv, aad_vec, rsp_payload, \n                                     rsp_tag, rsp_payload); !res) {\n  std::println(stderr, \"[ERROR] Decryption Failed: {}\", crypto::ToString(res.error()));\n  return std::unexpected(BootromError::kGcmAuthenticationFailed);\n}\n\n```\n\n---\n\n### 4\\. The Build System: `build.mk`\n\nAdd the new translation unit to your build configuration so it links properly.\n\n```\nhost-util-bin-cxx-y +\u003d et171_flash\net171_flash-objs :\u003d $(addprefix $(_cur_dir)/, \\\n    et171_flash.o \\\n    bootrom.o \\\n    usb_comm.o \\\n    ec_comm.o \\\n    crypto_util.o \\\n)\n\n```",
