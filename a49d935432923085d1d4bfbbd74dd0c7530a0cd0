      },
      "writtenOn": "2026-04-01T10:22:00Z",
      "side": 1,
      "message": "If a 45W adapter supports both 20V/2.25A and 15V/3A, Jaina should prioritize selecting the 20V/2.25A profile over 15V/3A",
      "parentUuid": "f0f35fd4_eb1d7ff2",
