      "writtenOn": "2026-05-29T17:14:14Z",
      "side": 1,
      "message": "Should this be done unconditionally here or should this wait until PWRMON_START?\n\nSeems like this could disrupt an ongoing measurement from the GSC.",
      "range": {
        "startLine": 95,
        "startChar": 0,
        "endLine": 95,
        "endChar": 47
      },
      "revId": "a405444314a2cc5767a76de98a34fe33ca6c27ea",
