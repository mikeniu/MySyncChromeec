      "message": "Now that we have the tests working, we need to create a separate test file for each source file and add unit tests for each source file so that we have sufficient test coverage.\n\nHere is Gemini generated code to do this. Verify that it\u0027s correct and that all the tests compile and pass.\n\n----\n\n### Step 1: Dependency Injection Setup\n\nFirst, we create an interface to abstract the USB layer, allowing us to inject mocks during testing.\n\n**1. Create `util/egis/usb_interface.h**`\n\n```cpp\n/* Copyright 2026 The ChromiumOS Authors\n * Use of this source code is governed by a BSD-style license that can be\n * found in the LICENSE file.\n */\n#ifndef UTIL_EGIS_USB_INTERFACE_H_\n#define UTIL_EGIS_USB_INTERFACE_H_\n\n#include \u003cchrono\u003e\n#include \u003ccstdint\u003e\n#include \u003cexpected\u003e\n#include \u003cspan\u003e\n\n#include \"usb_comm.h\"\n\nnamespace egis {\n\nclass UsbInterface {\n public:\n  virtual ~UsbInterface() \u003d default;\n\n  virtual std::expected\u003cvoid, UsbError\u003e Connect() \u003d 0;\n\n  virtual std::expected\u003cvoid, UsbError\u003e Send(\n      std::span\u003cconst uint8_t\u003e data,\n      std::chrono::milliseconds timeout \u003d kTransferTimeout) \u003d 0;\n\n  virtual std::expected\u003cint, UsbError\u003e Receive(\n      std::span\u003cuint8_t\u003e data,\n      std::chrono::milliseconds timeout \u003d kTransferTimeout) \u003d 0;\n};\n\n}  // namespace egis\n\n#endif  // UTIL_EGIS_USB_INTERFACE_H_\n\n```\n\n**2. Update `util/egis/usb_comm.h` and `usb_comm.cc**`\nMake `UsbComm` inherit from the new interface.\n\n```cpp\n// In util/egis/usb_comm.h:\n#include \"usb_interface.h\"\n\nnamespace egis {\n// ...\nclass UsbComm : public UsbInterface {\n public: \n  UsbComm(libusb_context *ctx, uint16_t vid, uint16_t pid, uint8_t ep_out,\n          uint8_t ep_in);\n  ~UsbComm() override;\n  \n  std::expected\u003cvoid, UsbError\u003e Connect() override;\n  std::expected\u003cvoid, UsbError\u003e Send(\n      std::span\u003cconst uint8_t\u003e data,\n      std::chrono::milliseconds timeout \u003d kTransferTimeout) override;\n  std::expected\u003cint, UsbError\u003e Receive(\n      std::span\u003cuint8_t\u003e data,\n      std::chrono::milliseconds timeout \u003d kTransferTimeout) override;\n// ...\n\n```\n\n**3. Inject `UsbInterface` into Protocol Classes**\nUpdate the constructors in your header files to depend on the interface rather than the concrete implementation.\n\n```cpp\n// In util/egis/bootrom.h:\n#include \"usb_interface.h\"\n// ...\n  explicit BootromComm(UsbInterface \u0026usb) : usb_(usb) {}\n// ...\n private:\n  UsbInterface \u0026usb_;\n\n\n// In util/egis/ec_comm.h:\n#include \"usb_interface.h\"\n// ...\n  explicit EcComm(UsbInterface \u0026usb);\n// ...\n private:\n  UsbInterface \u0026usb_;\n\n```\n\n*(Remember to also update the constructor definition in `ec_comm.cc` to match `EcComm::EcComm(UsbInterface \u0026usb)`).*\n\n---\n\n### Step 2: Build System Adjustments\n\n**Update `util/egis/build.mk**`\nReplace the entire `et171_flash_test-objs` section. We will add `gtest_main` to the package list and define the new isolated test objects.\n\n```makefile\n# Register the test binary as a host C++ utility\nhost-util-bin-cxx-y +\u003d et171_flash_test\n\n# Define the objects required for the test binary\net171_flash_test-objs :\u003d $(addprefix $(_cur_dir)/, \\\n    bootrom.o bootrom_test.o \\\n    usb_comm.o usb_comm_test.o \\\n    ec_comm.o ec_comm_test.o \\\n    crypto_util.o crypto_util_test.o \\\n    cli_options.o cli_options_test.o \\\n    file_util.o file_util_test.o \\\n    flasher_logic.o flasher_logic_test.o \\\n)\n\n_egis_test_bin :\u003d $(out)/util/et171_flash_test\n\n# Add gtest_main for the automatic test entry point\n_EGIS_TEST_PKGS :\u003d libusb-1.0 boringssl gtest gmock gtest_main\n\n# Configure flags to pull in dependencies via pkg-config\n$(_egis_test_bin): HOST_CXXFLAGS+\u003d-fvisibility\u003dhidden -Iutil/egis\n$(_egis_test_bin): HOST_CXXFLAGS+\u003d$(shell $(HOST_PKG_CONFIG) --cflags \\\n\t$(_EGIS_TEST_PKGS))\n$(_egis_test_bin): HOST_LDFLAGS+\u003d$(shell $(HOST_PKG_CONFIG) --libs \\\n\t$(_EGIS_TEST_PKGS))\n\n```\n\n---\n\n### Step 3: Delete the Monolith and Create Isolated Tests\n\nFirst, **delete `util/egis/et171_flash_test.cc**`. Then, create the following 9 files:\n\n**1. `util/egis/mock_usb_comm.h**`\n\n```cpp\n#ifndef UTIL_EGIS_MOCK_USB_COMM_H_\n#define UTIL_EGIS_MOCK_USB_COMM_H_\n\n#include \u003cgmock/gmock.h\u003e\n#include \"usb_interface.h\"\n\nnamespace egis {\nclass MockUsbComm : public UsbInterface {\n public:\n  MOCK_METHOD((std::expected\u003cvoid, UsbError\u003e), Connect, (), (override));\n  MOCK_METHOD((std::expected\u003cvoid, UsbError\u003e), Send,\n              (std::span\u003cconst uint8_t\u003e data, std::chrono::milliseconds timeout),\n              (override));\n  MOCK_METHOD((std::expected\u003cint, UsbError\u003e), Receive,\n              (std::span\u003cuint8_t\u003e data, std::chrono::milliseconds timeout),\n              (override));\n};\n}  // namespace egis\n#endif  // UTIL_EGIS_MOCK_USB_COMM_H_\n\n```\n\n**2. `util/egis/crypto_util_test.cc**`\n\n```cpp\n#include \"crypto_util.h\"\n#include \u003cgtest/gtest.h\u003e\n#include \u003carray\u003e\n\nnamespace egis {\nnamespace {\nTEST(CryptoUtilTest, Sha256KnownValue) {\n  const uint8_t data[] \u003d {\u0027a\u0027, \u0027b\u0027, \u0027c\u0027};\n  std::array\u003cuint8_t, 32\u003e hash{};\n  crypto::Sha256(data, hash);\n  EXPECT_EQ(hash[0], 0xba);\n  EXPECT_EQ(hash[1], 0x78);\n  EXPECT_EQ(hash[2], 0x16);\n  EXPECT_EQ(hash[3], 0xbf);\n}\n}  // namespace\n}  // namespace egis\n\n```\n\n**3. `util/egis/cli_options_test.cc**`\n\n```cpp\n#include \"cli_options.h\"\n#include \u003cgtest/gtest.h\u003e\n\nnamespace egis {\nnamespace {\nTEST(CliOptionsTest, ParseHelpReturnsNullopt) {\n  char cmd[] \u003d \"et171_flash\";\n  char flag[] \u003d \"--help\";\n  char* argv[] \u003d {cmd, flag};\n  EXPECT_FALSE(ParseArgs(2, argv).has_value());\n}\n\nTEST(CliOptionsTest, ParseValidFlashFw) {\n  char cmd[] \u003d \"et171_flash\";\n  char flag[] \u003d \"--flashfw\";\n  char arg[] \u003d \"image.bin\";\n  char* argv[] \u003d {cmd, flag, arg};\n  auto config \u003d ParseArgs(3, argv);\n  ASSERT_TRUE(config.has_value());\n  EXPECT_EQ(config-\u003emode, AppMode::kFlashFw);\n  EXPECT_EQ(config-\u003efw_path, \"image.bin\");\n  EXPECT_EQ(config-\u003ealgo_type, EgisCryptoType::kSha256);\n}\n}  // namespace\n}  // namespace egis\n\n```\n\n**4. `util/egis/egis_util_test.cc**`\n\n```cpp\n#include \"egis_util.h\"\n#include \u003cgtest/gtest.h\u003e\n#include \u003carray\u003e\n\nnamespace egis {\nnamespace {\nstruct SampleStruct {\n  uint16_t a;\n  uint32_t b;\n} __attribute__((packed));\n\nTEST(EgisUtilTest, EndianSwap) {\n  uint32_t val \u003d 0x12345678;\n  EXPECT_EQ(ToLittleEndian(val), val);\n}\n\nTEST(EgisUtilTest, ReadWriteStruct) {\n  std::array\u003cuint8_t, 6\u003e buffer{};\n  SampleStruct in{.a \u003d 0xAAAA, .b \u003d 0xBBBBCCCC};\n  ASSERT_TRUE(WriteStruct\u003cSampleStruct\u003e(buffer, in).has_value());\n  auto read_res \u003d ReadStruct\u003cSampleStruct\u003e(buffer);\n  ASSERT_TRUE(read_res.has_value());\n  EXPECT_EQ(read_res-\u003ea, 0xAAAA);\n  EXPECT_EQ(read_res-\u003eb, 0xBBBBCCCC);\n}\n}  // namespace\n}  // namespace egis\n\n```\n\n**5. `util/egis/file_util_test.cc**`\n\n```cpp\n#include \"file_util.h\"\n#include \u003cgtest/gtest.h\u003e\n#include \u003cfilesystem\u003e\n#include \u003cfstream\u003e\n\nnamespace egis {\nnamespace {\nTEST(FileUtilTest, ReadBinaryFileSuccess) {\n  auto temp_path \u003d std::filesystem::temp_directory_path() / \"file_util_test.bin\";\n  std::ofstream(temp_path, std::ios::binary).write(\"DATA\", 4);\n  auto res \u003d ReadBinaryFile(temp_path.string());\n  ASSERT_TRUE(res.has_value());\n  EXPECT_EQ(res-\u003esize(), 4);\n  EXPECT_EQ(res.value()[0], \u0027D\u0027);\n  std::filesystem::remove(temp_path);\n}\n\nTEST(FileUtilTest, ReadBinaryFileNotFound) {\n  EXPECT_FALSE(ReadBinaryFile(\"/invalid/path/that/does/not/exist.bin\").has_value());\n}\n}  // namespace\n}  // namespace egis\n\n```\n\n**6. `util/egis/usb_comm_test.cc**`\n\n```cpp\n#include \"usb_comm.h\"\n#include \u003cgtest/gtest.h\u003e\n#include \u003cvector\u003e\n\nnamespace egis {\nnamespace {\nTEST(UsbCommTest, FailsWhenNotConnected) {\n  UsbComm comm(nullptr, 0x1234, 0x5678, 0x01, 0x81);\n  std::vector\u003cuint8_t\u003e dummy_data(4);\n  EXPECT_EQ(comm.Send(dummy_data).error(), UsbError::kNotConnected);\n  EXPECT_EQ(comm.Receive(dummy_data).error(), UsbError::kNotConnected);\n}\n\nTEST(UsbCommTest, ConnectFailsWithNullContext) {\n  UsbComm comm(nullptr, 0x1234, 0x5678, 0x01, 0x81);\n  EXPECT_EQ(comm.Connect().error(), UsbError::kInvalidParam);\n}\n}  // namespace\n}  // namespace egis\n\n```\n\n**7. `util/egis/ec_comm_test.cc**`\n\n```cpp\n#include \"ec_comm.h\"\n#include \u003cgmock/gmock.h\u003e\n#include \u003cgtest/gtest.h\u003e\n#include \u003calgorithm\u003e\n#include \"mock_usb_comm.h\"\n\nnamespace egis {\nnamespace {\nusing ::testing::_;\nusing ::testing::Return;\n\nTEST(EcCommTest, SendCommandSuccess) {\n  MockUsbComm mock_usb;\n  EcComm ec_comm(mock_usb);\n\n  EcHostCommandResponse mock_resp{\n      .protocol_version \u003d 3,\n      .checksum \u003d static_cast\u003cuint8_t\u003e(-3),\n      .result \u003d ToLittleEndian(static_cast\u003cuint16_t\u003e(0)),\n      .data_length \u003d ToLittleEndian(static_cast\u003cuint16_t\u003e(0))\n  };\n\n  EXPECT_CALL(mock_usb, Send(_, _)).WillOnce(Return(std::expected\u003cvoid, UsbError\u003e{}));\n  EXPECT_CALL(mock_usb, Receive(_, _))\n      .WillOnce([\u0026mock_resp](std::span\u003cuint8_t\u003e out_buffer, auto) {\n        auto bytes \u003d AsBytes(mock_resp);\n        std::ranges::copy(bytes, out_buffer.begin());\n        return static_cast\u003cint\u003e(bytes.size());\n      });\n\n  auto result \u003d ec_comm.SendCommand(0x0002, 1);\n  ASSERT_TRUE(result.has_value());\n  EXPECT_TRUE(result-\u003eempty());\n}\n\nTEST(EcCommTest, SendCommandInvalidChecksum) {\n  MockUsbComm mock_usb;\n  EcComm ec_comm(mock_usb);\n\n  EcHostCommandResponse mock_resp{\n      .protocol_version \u003d 3,\n      .checksum \u003d 0,\n      .result \u003d 0,\n      .data_length \u003d 0\n  };\n\n  EXPECT_CALL(mock_usb, Send(_, _)).WillOnce(Return(std::expected\u003cvoid, UsbError\u003e{}));\n  EXPECT_CALL(mock_usb, Receive(_, _))\n      .WillOnce([\u0026mock_resp](std::span\u003cuint8_t\u003e out_buffer, auto) {\n        auto bytes \u003d AsBytes(mock_resp);\n        std::ranges::copy(bytes, out_buffer.begin());\n        return static_cast\u003cint\u003e(bytes.size());\n      });\n\n  auto result \u003d ec_comm.SendCommand(0x0002, 1);\n  ASSERT_FALSE(result.has_value());\n  EXPECT_EQ(result.error(), EcError::kInvalidChecksum);\n}\n}  // namespace\n}  // namespace egis\n\n```\n\n**8. `util/egis/bootrom_test.cc**`\n\n```cpp\n#include \"bootrom.h\"\n#include \u003cgmock/gmock.h\u003e\n#include \u003cgtest/gtest.h\u003e\n#include \u003calgorithm\u003e\n#include \"mock_usb_comm.h\"\n\nnamespace egis {\nnamespace {\nusing ::testing::_;\nusing ::testing::Return;\n\nstd::vector\u003cuint8_t\u003e MakeMockAesResponse(\n    std::span\u003cconst uint8_t, crypto::kAes256KeySize\u003e key,\n    std::span\u003cconst uint8_t\u003e plaintext, \n    bool corrupt_tag \u003d false) {\n  std::array\u003cuint8_t, crypto::kAesGcmIvSize\u003e iv{};\n  std::array\u003cuint8_t, crypto::kAesGcmTagSize\u003e tag{};\n  std::vector\u003cuint8_t\u003e ciphertext(plaintext.size());\n  uint32_t aad \u003d ToLittleEndian(EgisBootrom::kChipIdAad);\n\n  EXPECT_TRUE(crypto::GenerateGcmIv(iv).has_value());\n  EXPECT_TRUE(crypto::AesGcmEncrypt(key, iv, AsBytes(aad), plaintext, \n                                    ciphertext, tag).has_value());\n\n  if (corrupt_tag) tag[0] ^\u003d 0xFF;\n\n  BootromComm::SecureResponseHeader hdr{\n      .status \u003d 0,\n      .payload_len \u003d ToLittleEndian(static_cast\u003cuint32_t\u003e(ciphertext.size()))\n  };\n\n  auto resp_packet \u003d PackMessage(hdr, iv);\n  resp_packet.insert(resp_packet.end(), tag.begin(), tag.end());\n  resp_packet.insert(resp_packet.end(), ciphertext.begin(), ciphertext.end());\n  return resp_packet;\n}\n\nTEST(BootromCommTest, GetBootromInfoSuccess) {\n  MockUsbComm mock_usb;\n  BootromComm brom(mock_usb);\n\n  EXPECT_CALL(mock_usb, Send(_, _)).WillOnce(Return(std::expected\u003cvoid, UsbError\u003e{}));\n  EXPECT_CALL(mock_usb, Receive(_, _))\n      .WillOnce([](std::span\u003cuint8_t\u003e out_buffer, auto) {\n        uint16_t status \u003d 0;\n        EgisBootrom::BootromInfoResponse info{\n            .version \u003d ToLittleEndian(uint32_t{0x01020304}),\n            .max_cmd_size \u003d ToLittleEndian(uint32_t{1024}),\n            .max_fw_upgrade_size \u003d ToLittleEndian(uint32_t{2048})\n        };\n        auto payload \u003d PackMessage(status, AsBytes(info));\n        std::ranges::copy(payload, out_buffer.begin());\n        return static_cast\u003cint\u003e(payload.size());\n      });\n\n  auto res \u003d brom.GetBootromInfo();\n  ASSERT_TRUE(res.has_value());\n  EXPECT_EQ(res-\u003eversion, 0x01020304);\n}\n\nTEST(BootromCommTest, SecureCommandAesSuccess) {\n  MockUsbComm mock_usb;\n  BootromComm brom(mock_usb);\n  \n  brom.SetWrappedAlgo(EgisCryptoType::kAesGcm);\n  std::array\u003cuint8_t, crypto::kAes256KeySize\u003e key{};\n  key.fill(0x77); \n  brom.SetAesKey(key);\n\n  EgisBootrom::MemReadCommand read_cmd{\n      .address \u003d ToLittleEndian(uint32_t{0x80000000}),\n      .access_size \u003d EgisBootrom::kAccessSizeUint8,\n      .count \u003d ToLittleEndian(uint32_t{4})\n  };\n\n  EXPECT_CALL(mock_usb, Send(_, _)).WillOnce(Return(std::expected\u003cvoid, UsbError\u003e{}));\n  EXPECT_CALL(mock_usb, Receive(_, _))\n      .WillOnce([\u0026key](std::span\u003cuint8_t\u003e out_buffer, auto) {\n        std::array\u003cuint8_t, 4\u003e plaintext \u003d {0x11, 0x22, 0x33, 0x44};\n        auto resp_packet \u003d MakeMockAesResponse(key, plaintext, false);\n        std::ranges::copy(resp_packet, out_buffer.begin());\n        return static_cast\u003cint\u003e(resp_packet.size());\n      });\n\n  auto res \u003d brom.SendStruct(read_cmd);\n  ASSERT_TRUE(res.has_value());\n  EXPECT_EQ(res-\u003esize(), 4);\n  EXPECT_EQ(res.value()[0], 0x11);\n}\n\nTEST(BootromCommTest, SecureCommandAesAuthenticationFailure) {\n  MockUsbComm mock_usb;\n  BootromComm brom(mock_usb);\n  \n  brom.SetWrappedAlgo(EgisCryptoType::kAesGcm);\n  std::array\u003cuint8_t, crypto::kAes256KeySize\u003e key{};\n  key.fill(0x77); \n  brom.SetAesKey(key);\n\n  EgisBootrom::MemReadCommand read_cmd{\n      .address \u003d ToLittleEndian(uint32_t{0x80000000}),\n      .access_size \u003d EgisBootrom::kAccessSizeUint8,\n      .count \u003d ToLittleEndian(uint32_t{4})\n  };\n\n  EXPECT_CALL(mock_usb, Send(_, _)).WillOnce(Return(std::expected\u003cvoid, UsbError\u003e{}));\n  EXPECT_CALL(mock_usb, Receive(_, _))\n      .WillOnce([\u0026key](std::span\u003cuint8_t\u003e out_buffer, auto) {\n        std::array\u003cuint8_t, 4\u003e plaintext \u003d {0x11, 0x22, 0x33, 0x44};\n        auto resp_packet \u003d MakeMockAesResponse(key, plaintext, true);\n        std::ranges::copy(resp_packet, out_buffer.begin());\n        return static_cast\u003cint\u003e(resp_packet.size());\n      });\n\n  auto res \u003d brom.SendStruct(read_cmd);\n  ASSERT_FALSE(res.has_value());\n  EXPECT_EQ(res.error(), BootromError::kGcmAuthenticationFailed);\n}\n}  // namespace\n}  // namespace egis\n\n```\n\n**9. `util/egis/flasher_logic_test.cc**`\n\n```cpp\n#include \"flasher_logic.h\"\n#include \u003cgmock/gmock.h\u003e\n#include \u003cgtest/gtest.h\u003e\n#include \u003cfilesystem\u003e\n#include \u003cfstream\u003e\n#include \u003cstring\u003e\n#include \"bootrom.h\"\n#include \"mock_usb_comm.h\"\n\nnamespace egis {\nnamespace {\nusing ::testing::_;\nusing ::testing::NiceMock;\nusing ::testing::Return;\n\nclass FlasherLogicTest : public ::testing::Test {\n protected:\n  void SetUp() override {\n    fw_path_ \u003d std::filesystem::temp_directory_path() / \"test_fw.bin\";\n    std::ofstream(fw_path_, std::ios::binary).write(\"DUMMY_FW\", 8);\n  }\n  void TearDown() override {\n    std::filesystem::remove(fw_path_);\n  }\n  std::filesystem::path fw_path_;\n};\n\nTEST_F(FlasherLogicTest, RunFlashFwInvalidArgs) {\n  NiceMock\u003cMockUsbComm\u003e mock_usb;\n  BootromComm brom(mock_usb);\n  AppConfig config;\n\n  EXPECT_EQ(RunFlashFw(config, brom).error(), AppError::kInvalidArgs);\n\n  config.fw_path \u003d fw_path_.string();\n  config.algo_type \u003d EgisCryptoType::kAesGcm;\n  EXPECT_EQ(RunFlashFw(config, brom).error(), AppError::kInvalidArgs);\n}\n\nTEST_F(FlasherLogicTest, RunFlashFwSuccessFlow) {\n  NiceMock\u003cMockUsbComm\u003e mock_usb;\n  BootromComm brom(mock_usb);\n\n  AppConfig config{\n      .fw_path \u003d fw_path_.string(),\n      .algo_type \u003d EgisCryptoType::kSha256,\n      .flash_offset \u003d 0x0000,\n  };\n\n  ON_CALL(mock_usb, Send(_, _)).WillByDefault(Return(std::expected\u003cvoid, UsbError\u003e{}));\n  ON_CALL(mock_usb, Receive(_, _))\n      .WillByDefault([](std::span\u003cuint8_t\u003e out_buffer, auto) {\n        if (out_buffer.size() \u003e\u003d 2) {\n          out_buffer[0] \u003d 0;\n          out_buffer[1] \u003d 0;\n          return 2;\n        }\n        return 0;\n      });\n\n  EXPECT_TRUE(RunFlashFw(config, brom).has_value());\n}\n\nTEST_F(FlasherLogicTest, RunFlashCmdTruncatedPacket) {\n  NiceMock\u003cMockUsbComm\u003e mock_usb;\n  \n  const uint8_t bad_cmd[] \u003d {EgisBootrom::kCmdSecureWrapped, 0x00}; \n  std::ofstream(fw_path_, std::ios::binary).write(reinterpret_cast\u003cconst char*\u003e(bad_cmd), 2);\n\n  AppConfig config{\n      .mode \u003d AppMode::kFlashCmd,\n      .fw_path \u003d fw_path_.string()\n  };\n  \n  EXPECT_EQ(RunFlashCmd(config, mock_usb).error(), AppError::kParseError);\n}\n}  // namespace\n}  // namespace egis\n\n```",
