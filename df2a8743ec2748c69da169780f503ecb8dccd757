      "message": "We can simplify this file a lot by using a \"fake\" implementation instead of a mock for some cases. Here is code generated by Gemini. Review for correctness:\n\n----\n\n### Change 1: Expose Protocol Constants (`iap_control.h` \u0026 `iap_control.cc`)\n\n**Rationale:** The `FakeUsbBackend` needs to know the exact endpoints and command codes to simulate the hardware correctly. By moving these from the anonymous namespace in `iap_control.cc` to `public static constexpr` members in `iap_control.h`, both your production code and test suite share a single source of truth.\n\n**1a. Add to `util/elan/iap_control.h` (inside the `IapControl` class):**\n\n```cpp\n public:\n  // --- USB Endpoints \u0026 Lengths ---\n  static constexpr uint8_t kEpCmdOut \u003d 0x01;\n  static constexpr uint8_t kEpStatusIn \u003d 0x82;\n  static constexpr uint8_t kEpDataOut \u003d 0x03;\n  static constexpr uint8_t kEpDataIn \u003d 0x84;\n  static constexpr size_t kEpDataLength \u003d 64;\n\n  // --- Command Codes ---\n  static constexpr uint8_t kCmdRunIap \u003d 0x20;\n  static constexpr uint8_t kCmdFinishedIap \u003d 0x21;\n  static constexpr uint8_t kCmdSoftwareReset \u003d 0x22;\n  static constexpr uint8_t kCmdGetFwVersion \u003d 0x41;\n  static constexpr uint8_t kCmdAbortProcess \u003d 0x48;\n  static constexpr uint8_t kCmdWriteRom \u003d 0xA0;\n  static constexpr uint8_t kCmdWriteRomFinish \u003d 0xA1;\n  static constexpr uint8_t kCmdSetRomAddress \u003d 0xA4;\n  static constexpr uint8_t kCmdReadRom \u003d 0xE0;\n  static constexpr uint8_t kCmdReadRomFinish \u003d 0xE1;\n\n  // --- Status \u0026 Magic Values ---\n  static constexpr uint8_t kErrStaReady \u003d 0x00;\n  static constexpr uint8_t kErrStaSuccess \u003d 0x01;\n  static constexpr uint8_t kGoogleFwVerPrefix \u003d 0x10;\n  static constexpr uint32_t kBaseRomAddress \u003d 0x0000;\n\n```\n\n**1b. Remove from `util/elan/iap_control.cc`:**\nDelete the entire anonymous namespace at the top of the file containing `IapStatus`, `kGoogleFwVerPrefix`, and all the `kEp...` and `kCmd...` variables. You will need to update the endpoint references in your transfer functions to match the new names (e.g., `DoUsbTransfer(kEpCmdOut, buff)` instead of `kEp1Addr`).\n\n---\n\n### Change 2: Implement the Fake (`fake_usb_backend.h`)\n\n**Rationale:** This replaces the complex, state-tracking lambda functions inside your `gmock` expectations. It acts as a lightweight software simulation of the EM32F967 bootloader, utilizing your packed `IapStatusPacket` struct for memory-safe data transmission.\n\n**Create `util/elan/fake_usb_backend.h`:**\n\n```cpp\n// Copyright 2026 The ChromiumOS Authors\n// Use of this source code is governed by a BSD-style license that can be\n// found in the LICENSE file.\n\n#ifndef UTIL_ELAN_FAKE_USB_BACKEND_H_\n#define UTIL_ELAN_FAKE_USB_BACKEND_H_\n\n#include \u003calgorithm\u003e\n#include \u003ccstring\u003e\n#include \u003cvector\u003e\n\n#include \"iap_control.h\"\n#include \"usb_backend.h\"\n#include \"utility.h\"\n\nnamespace elan {\n\nclass FakeUsbBackend : public UsbBackend {\n public:\n  int Initialize() override { return 0; }\n  int OpenDevice(uint16_t vid, uint16_t pid) override { return 0; }\n  void Release() override {}\n\n  int InterruptTransfer(uint8_t endpoint, std::span\u003cuint8_t\u003e data,\n                        std::chrono::milliseconds timeout) override {\n    switch (endpoint) {\n      case IapControl::kEpCmdOut:\n        if (!data.empty()) last_cmd_ \u003d data[0];\n        return 0;\n\n      case IapControl::kEpStatusIn: {\n        IapStatusPacket status \u003d {};\n        status.cmd_echo \u003d last_cmd_;\n        status.status_code \u003d IapControl::kErrStaSuccess;\n\n        if (last_cmd_ \u003d\u003d IapControl::kCmdGetFwVersion) {\n          uint32_t fw_ver \u003d (IapControl::kGoogleFwVerPrefix \u003c\u003c 8);\n          status.return_value \u003d elan::ToLittleEndian(fw_ver); \n        }\n\n        std::ranges::copy(status.AsByteSpan(), data.begin());\n        return 0;\n      }\n\n      case IapControl::kEpDataOut:\n        device_flash_.insert(device_flash_.end(), data.begin(), data.end());\n        return 0;\n\n      case IapControl::kEpDataIn:\n        if (read_offset_ \u003c device_flash_.size()) {\n          size_t chunk \u003d std::min(data.size(), device_flash_.size() - read_offset_);\n          std::ranges::copy_n(device_flash_.begin() + read_offset_, chunk,\n                              data.begin());\n          read_offset_ +\u003d chunk;\n        }\n        return 0;\n    }\n    return -1; // LIBUSB_ERROR_IO\n  }\n\n  const std::vector\u003cuint8_t\u003e\u0026 GetFlashedData() const { return device_flash_; }\n\n private:\n  uint8_t last_cmd_ \u003d 0;\n  size_t read_offset_ \u003d 0;\n  std::vector\u003cuint8_t\u003e device_flash_;\n};\n\n}  // namespace elan\n#endif\n\n```\n\n---\n\n### Change 3: Refactor the Tests (`iap_control_test.cc`)\n\n**Rationale:** Mocks should be reserved for testing hardware failures (like `libusb_init` failing). The Fake is used for testing application logic. This strips out ~50 lines of brittle `testing::Invoke` expectations and allows us to easily test edge cases like unaligned files and partial USB chunks.\n\n**Update `util/elan/iap_control_test.cc`:**\n\n```cpp\n#include \"iap_control.h\"\n\n#include \u003cgmock/gmock.h\u003e\n#include \u003cgtest/gtest.h\u003e\n#include \u003cmemory\u003e\n#include \u003cvector\u003e\n\n#include \"fake_usb_backend.h\"\n#include \"mock_usb_backend.h\"\n\nusing ::testing::_;\nusing ::testing::Return;\n\nnamespace elan {\nnamespace {\n\nclass IapControlTest : public ::testing::Test {\n protected:\n  // Helper to quickly setup a controller with a Fake backend\n  std::pair\u003cFakeUsbBackend*, std::unique_ptr\u003cIapControl\u003e\u003e CreateFakeController() {\n    auto fake \u003d std::make_unique\u003cFakeUsbBackend\u003e();\n    auto* ptr \u003d fake.get();\n    auto ctrl \u003d std::make_unique\u003cIapControl\u003e(std::move(fake));\n    return {ptr, std::move(ctrl)};\n  }\n};\n\n// ---------------------------------------------------------\n// Hardware Failure Tests (Using MockUsbBackend)\n// ---------------------------------------------------------\n\nTEST_F(IapControlTest, InitializeFailsWhenLibusbInitFails) {\n  auto mock \u003d std::make_unique\u003cMockUsbBackend\u003e();\n  EXPECT_CALL(*mock, Initialize()).WillOnce(Return(-99));\n  \n  IapControl ctrl(std::move(mock));\n  EXPECT_EQ(ctrl.Initialize(kBootVid, kBootPid).error(), IapError::UsbInitFailed);\n}\n\n// ---------------------------------------------------------\n// Application Logic Tests (Using FakeUsbBackend)\n// ---------------------------------------------------------\n\nTEST_F(IapControlTest, RunIapProcessHappyPathCompletesSuccessfully) {\n  auto [fake_ptr, ctrl] \u003d CreateFakeController();\n  ASSERT_TRUE(ctrl-\u003eInitialize(kBootVid, kBootPid).has_value());\n\n  std::vector\u003cuint8_t\u003e my_rom(64, 0xAA);\n  auto result \u003d ctrl-\u003eRunIapProcess(my_rom);\n\n  EXPECT_TRUE(result.has_value());\n  EXPECT_EQ(fake_ptr-\u003eGetFlashedData(), my_rom); \n}\n\nTEST_F(IapControlTest, RejectsUnalignedRomData) {\n  auto [_, ctrl] \u003d CreateFakeController();\n  ASSERT_TRUE(ctrl-\u003eInitialize(kBootVid, kBootPid).has_value());\n\n  std::vector\u003cuint8_t\u003e unaligned_rom(61, 0xBB); // Fails alignment check\n  auto result \u003d ctrl-\u003eRunIapProcess(unaligned_rom);\n\n  ASSERT_FALSE(result.has_value());\n  EXPECT_EQ(result.error(), IapError::BufferTooSmall);\n}\n\nTEST_F(IapControlTest, HandlesOddSizedPayloadChunking) {\n  auto [fake_ptr, ctrl] \u003d CreateFakeController();\n  ASSERT_TRUE(ctrl-\u003eInitialize(kBootVid, kBootPid).has_value());\n\n  // 100 bytes forces the loop to handle a 64-byte chunk and a 36-byte chunk\n  std::vector\u003cuint8_t\u003e odd_rom(100);\n  for (size_t i \u003d 0; i \u003c odd_rom.size(); ++i) odd_rom[i] \u003d static_cast\u003cuint8_t\u003e(i);\n\n  auto result \u003d ctrl-\u003eRunIapProcess(odd_rom);\n\n  ASSERT_TRUE(result.has_value());\n  EXPECT_EQ(fake_ptr-\u003eGetFlashedData(), odd_rom);\n}\n\nTEST_F(IapControlTest, ProgressCallbackFiresCorrectly) {\n  auto [_, ctrl] \u003d CreateFakeController();\n  ASSERT_TRUE(ctrl-\u003eInitialize(kBootVid, kBootPid).has_value());\n\n  int trigger_count \u003d 0;\n  ASSERT_TRUE(ctrl-\u003eSetProgressCallback([\u0026](size_t progress, size_t total) {\n    trigger_count++;\n    EXPECT_EQ(total, 100);\n  }).has_value());\n\n  ASSERT_TRUE(ctrl-\u003eRunIapProcess(std::vector\u003cuint8_t\u003e(100, 0xCC)).has_value());\n\n  // Write (64 + 36) + Read (64 + 36) \u003d 4 loop iterations\n  EXPECT_EQ(trigger_count, 4); \n}\n\n}  // namespace\n}  // namespace elan\n\n```",
