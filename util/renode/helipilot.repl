using "platforms/cpus/nuvoton_npcx9.repl"

itim32_1:
    apb2Frequency: 16000000

itim32_2:
    apb2Frequency: 16000000

itim32_3:
    apb2Frequency: 16000000

itim32_4:
    apb2Frequency: 16000000

itim32_5:
    apb2Frequency: 16000000

itim32_6:
    apb2Frequency: 16000000

GPIO_WP: Miscellaneous.Button @ gpioa 4
    invert: true
    -> gpioa@4
    init:
        ReleaseOnReset false

// Connect gpio9 pin 3 (div_highside) to gpio4 pin 3 (transport_sel) to model
// the board's resistor divider strap so get_fp_transport_type() detects SPI
// when div_highside is driven high.
gpio9:
    3 -> gpio4@3

fpsensor: Sensors.GenericSPISensor @ spip

// Upstream nuvoton_npcx9.repl maps battery_backed_ram at 0x400AF000 with size
// > 0x100, covering the Write-1-To-Clear BKUP_STS register at 0x400AF100 with
// ordinary RAM. When bbram_npcx_init() writes 0x80 (IBBR) to 0x400AF100 to
// clear the status bit, RAM retains 0x80 and causes subsequent boots across
// resets to treat BBRAM as corrupted. Unregister battery_backed_ram and replace
// it with a 0x100-byte memory so 0x400AF100 is not backed by RAM.
// TODO(b/567997307): Remove once battery_backed_ram size is fixed in upstream nuvoton_npcx9.repl.
battery_backed_ram: @ none
bbram: Memory.ArrayMemory @ sysbus 0x400AF000
    size: 0x100
