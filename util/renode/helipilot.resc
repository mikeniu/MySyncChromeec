using sysbus
$name?="helipilot"
mach create $name

machine LoadPlatformDescription $ORIGIN/helipilot.repl

$bin?=$ORIGIN/helipilot/ec.bin
$elf_ro?=$ORIGIN/helipilot/ec.RO.elf
$elf_rw?=$ORIGIN/helipilot/ec.RW.elf

showAnalyzer cr_uart1

# Uncomment the lines below for additional logging
#cpu LogFunctionNames true true
#sysbus LogAllPeripheralsAccess true

# Load firmware to internal flash. It will be moved to Code RAM by the bootloader
# TODO(b/567997351): Keep outside macro reset so flash writes persist across resets.
sysbus LoadBinary $bin 0x64000000

# TODO(b/567996957): Remove once NPCX_TWD supports Too Early Service reset and WDCP readback in Renode.
twd AddAfterWriteWordHook 0xA "if value == 0x5c and (self.ReadWord(0x6) & 0x20) == 0: self.WriteWord(0xa, 0x00)"
twd AddAfterReadWordHook 0x10 "value = 5"

# Report 4 comparators (NUMCOMP=4 in bits [31:28]) from DWT->CTRL (0xE0001000) so
# z_arm_debug_enable_null_pointer_detection() does not hit an assertion failure
# when CONFIG_ASSERT=y is enabled.
dwt AddAfterReadDoubleWordHook 0x0 "value |= 0x40000000"

macro reset
"""
    sysbus LoadSymbolsFrom $elf_ro
    # sysbus LoadSymbolsFrom $elf_rw
    cpu FpuEnabled true
    cpu PC 0x0
    # TODO(b/567998100): Remove once NVIC SystemReset resets BASEPRI in Renode.
    cpu BasePri 0
    # Set the image type of currently loaded image to RO by default. Software will
    # update the flag while jumping between image types.
    image_type WriteByte 0x0 0x40
"""

runMacro $reset
