using sysbus
$name?="bloonchipper"
mach create $name

machine LoadPlatformDescription $ORIGIN/bloonchipper.repl


$bin?=$ORIGIN/bloonchipper/ec.bin
$elf_ro?=$ORIGIN/bloonchipper/ec.RO.elf
$elf_rw?=$ORIGIN/bloonchipper/ec.RW.elf


showAnalyzer usart2


# Uncomment the lines below for additional logging
#cpu LogFunctionNames true true
#sysbus LogAllPeripheralsAccess true


macro reset
"""
    sysbus LoadBinary $bin 0x08000000
    sysbus LoadSymbolsFrom $elf_ro
    sysbus LoadSymbolsFrom $elf_rw
    cpu VectorTableOffset 0x8000000

    # Sensors.GenericSPISensor is a byte-FIFO SPI peripheral that pops one queued
    # byte per full-duplex SPI clock byte (1 dummy byte during the command byte
    # write followed by the response bytes). Queue the FPC1025 hardware ID
    # (0x021a, 3 bytes per read) and interrupt status clear reads (0x00, 2 bytes
    # per read) for the initial driver probe, frame size cache population, and
    # fpsensor_hw test check (covering both Zephyr and legacy EC).
    spi2.fpsensor FeedSample 0x00
    spi2.fpsensor FeedSample 0x02
    spi2.fpsensor FeedSample 0x1a
    spi2.fpsensor FeedSample 0x00
    spi2.fpsensor FeedSample 0x00
    spi2.fpsensor FeedSample 0x02
    spi2.fpsensor FeedSample 0x1a
    spi2.fpsensor FeedSample 0x00
    spi2.fpsensor FeedSample 0x02
    spi2.fpsensor FeedSample 0x1a
    spi2.fpsensor FeedSample 0x00
    spi2.fpsensor FeedSample 0x00
    spi2.fpsensor FeedSample 0x02
    spi2.fpsensor FeedSample 0x1a
"""

runMacro $reset
