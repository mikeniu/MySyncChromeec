    ],
    "rule_id": "SLEEP_IN_SYSWORKQ"
  },
  {
    "category": "Sysworkq Context Violation",
    "contexts": [
      "SYSWORKQ"
    ],
    "description": "Calling @sleep functions with a @no_wait path (k_mutex_lock, k_sem_take, k_event_wait, k_msgq_*, k_queue_get) on k_sys_work_q can block when contested unless invoked with K_NO_WAIT.",
    "exemption_props": [
      "isr_ok"
    ],
    "path_matchers": [],
    "prohibited_props": [
      "sleep",
