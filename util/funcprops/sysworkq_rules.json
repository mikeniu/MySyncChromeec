      "i2c_transfer",
      "i2c_transceive",
      "i2c_lock",
      "spi_transaction",
      "spi_transceive",
      "spi_read",
      "spi_write",
      "crec_flash_physical_write",
      "crec_flash_physical_erase"
    ],
    "prohibited_props": [],
    "required_absent_props": [],
    "rule_id": "IO_IN_SYSWORKQ"
  },
  {
    "category": "Sysworkq Context Violation",
    "contexts": [
      "SYSWORKQ"
    ],
