# Dispatcher for flash_ec that routes to the new Python implementation
# but allows falling back to the legacy bash implementation.

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
PYTHON_MODULE="flash.flash_ec"
LEGACY_SCRIPT="${SCRIPT_DIR}/flash_ec_legacy"

# Check for explicit legacy opt-out
USE_LEGACY=0
ARGS=()
for arg in "$@"; do
	if [[ "${arg}" == "--legacy" ]]; then
		USE_LEGACY=1
	else
		ARGS+=("${arg}")
	fi
done

if [[ -f "${HOME}/.disable_flash_ec_python" ]] || [[ ${USE_LEGACY} -eq 1 ]]; then
	echo "WARNING: Routing to legacy bash flash_ec (opt-out detected)." >&2
	exec "${LEGACY_SCRIPT}" "${ARGS[@]}"
fi

echo "INFO: Running new Python flash_ec. (Pass --legacy to fallback to the old bash script)." >&2
PYTHONPATH="${SCRIPT_DIR}" python3 -m "${PYTHON_MODULE}" "$@"
PYTHON_EXIT=$?

if [[ ${PYTHON_EXIT} -ne 0 ]]; then
	echo -e "\n\e[1;31m======================================================================\e[0m" >&2
	echo -e "\e[1;31mERROR: Python flash_ec failed (exit code ${PYTHON_EXIT}).\e[0m" >&2
	echo -e "If this is a bug in the new Python version, you can fallback to" >&2
	echo -e "the legacy bash script by adding \e[1m--legacy\e[0m to your command," >&2
	echo -e "or opt-out globally: \e[1mtouch ~/.disable_flash_ec_python\e[0m" >&2
	echo -e "\e[1;31m======================================================================\e[0m\n" >&2
	exit ${PYTHON_EXIT}
fi
