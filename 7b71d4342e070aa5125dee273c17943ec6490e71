      },
      "writtenOn": "2026-04-08T02:12:13Z",
      "side": 1,
      "message": "It is used for indexing the USB-C port. Because the child nodes use `reg`, the parent node must define #address-cells and #size-cells. Setting them to const: 1 and const: 0 enforces the correct format.",
      "parentUuid": "9be0c2ee_5c33fcd9",
      "range": {
        "startLine": 10,
        "startChar": 0,
        "endLine": 14,
        "endChar": 12
