      "side": 1,
      "message": "The capitalized MIN/MAX evaluate the arguments twice, leading to hard to debug issues if one of the arguments is a function call with side effects.\n\nUpstream still has lowercase min/max, but the definition got moved to \"\u003czephyr/sys/minmax.h\u003e\".\n\nYou just need to add the new include.",
      "range": {
        "startLine": 7,
        "startChar": 21,
        "endLine": 7,
        "endChar": 24
      },
      "revId": "b299005f43ff50cd4cd503dc808c552b1dba8ecb",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
