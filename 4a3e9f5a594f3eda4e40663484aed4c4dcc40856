      "message": "[Gerrit AI Review] **Extract DFU Functional Descriptor Parsing into a Testable Helper \u0026 Guard Against `wTransferSize \u003d\u003d 0`:**\n\n1. **Validate non-zero `wTransferSize`:** If a malformed descriptor reports `wTransferSize \u003d\u003d 0`, setting `transfer_size_ \u003d 0` will cause the chunking loop in `dfu_download()` to stall with 0-byte blocks. Fall back to `kDfuDefaultTransferSize` when the parsed size is `0`.\n2. **Extract and unit-test descriptor parsing:** Parsing the TLV descriptor stream in `alt-\u003eextra` is pure byte-buffer logic that does not require USB hardware. Extracting it into a helper function (declared in a header alongside the other testable helpers) enables automated `gtest` coverage for boundary and malformed inputs:\n\n```cpp\nuint16_t parse_dfu_transfer_size(const uint8_t *extra, int extra_length)\n{\n\tif (!extra || extra_length \u003c\u003d 0)\n\t\treturn kDfuDefaultTransferSize;\n\n\tint off \u003d 0;\n\twhile (off + kDfuDescTypeOff \u003c extra_length) {\n\t\tuint8_t desc_len \u003d extra[off];\n\t\tif (desc_len \u003d\u003d 0 || off + desc_len \u003e extra_length)\n\t\t\tbreak;\n\n\t\tconst uint8_t *desc \u003d \u0026extra[off];\n\t\tif (desc[kDfuDescTypeOff] \u003d\u003d kDfuDescriptorType \u0026\u0026\n\t\t    desc_len \u003e\u003d kDfuDescMinLen) {\n\t\t\tconst uint8_t *sz \u003d desc + kDfuDescXferSizeOff;\n\t\t\tuint16_t parsed_size \u003d\n\t\t\t\tstatic_cast\u003cuint16_t\u003e(sz[0] | (sz[1] \u003c\u003c 8));\n\t\t\tif (parsed_size \u003d\u003d 0)\n\t\t\t\treturn kDfuDefaultTransferSize;\n\t\t\tprintf(\"DFU transfer size: %u bytes\\n\", parsed_size);\n\t\t\treturn parsed_size;\n\t\t}\n\t\toff +\u003d desc_len;\n\t}\n\n\treturn kDfuDefaultTransferSize;\n}\n```\n\nAnd add corresponding unit tests in `rts5817_flash_test`:\n```cpp\nTEST(ParseDfuTransferSizeTest, ValidExactMinLengthDescriptor)\n{\n\tconst uint8_t extra[] \u003d {\n\t\tkDfuDescMinLen, kDfuDescriptorType, 0x0B, 0xFF, 0x00,\n\t\t0x00,           0x08,               0x10, 0x01,\n\t};\n\tEXPECT_EQ(parse_dfu_transfer_size(extra, sizeof(extra)), 2048);\n}\n\nTEST(ParseDfuTransferSizeTest, DescriptorShorterThanMinLengthUsesDefault)\n{\n\tconst uint8_t short_desc[] \u003d {\n\t\tkDfuDescMinLen - 1, kDfuDescriptorType, 0x0B, 0xFF,\n\t\t0x00,               0x00,               0x08, 0x10,\n\t};\n\tEXPECT_EQ(parse_dfu_transfer_size(short_desc, sizeof(short_desc)),\n\t\t  kDfuDefaultTransferSize);\n}\n\nTEST(ParseDfuTransferSizeTest, TruncatedAndZeroLengthDescriptorsUseDefault)\n{\n\tconst uint8_t zero_len[] \u003d { 0x00, kDfuDescriptorType, 0x00 };\n\tEXPECT_EQ(parse_dfu_transfer_size(zero_len, sizeof(zero_len)),\n\t\t  kDfuDefaultTransferSize);\n\n\tconst uint8_t truncated[] \u003d {\n\t\tkDfuDescMinLen, kDfuDescriptorType, 0x0B, 0xFF,\n\t\t0x00,           0x00,               0x08, 0x10,\n\t};\n\tEXPECT_EQ(parse_dfu_transfer_size(truncated, sizeof(truncated)),\n\t\t  kDfuDefaultTransferSize);\n\n\tEXPECT_EQ(parse_dfu_transfer_size(nullptr, 0), kDfuDefaultTransferSize);\n}\n\nTEST(ParseDfuTransferSizeTest, SkipsNonDfuDescriptorAndZeroTransferSize)\n{\n\tconst uint8_t multi_tlv[] \u003d {\n\t\t0x04, 0x99,               0xAA, 0xBB,\n\t\tkDfuDescMinLen, kDfuDescriptorType, 0x0B, 0xFF, 0x00,\n\t\t0x00, 0x02,               0x10, 0x01,\n\t};\n\tEXPECT_EQ(parse_dfu_transfer_size(multi_tlv, sizeof(multi_tlv)), 512);\n\n\tconst uint8_t zero_xfer[] \u003d {\n\t\tkDfuDescMinLen, kDfuDescriptorType, 0x0B, 0xFF, 0x00,\n\t\t0x00,           0x00,               0x10, 0x01,\n\t};\n\tEXPECT_EQ(parse_dfu_transfer_size(zero_xfer, sizeof(zero_xfer)),\n\t\t  kDfuDefaultTransferSize);\n}\n```\n\n[🔗](http://go/tj/46b34316-d342-48c7-a7f3-1c5d7cf82dbc)",
