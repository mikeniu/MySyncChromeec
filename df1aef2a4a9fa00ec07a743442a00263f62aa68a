        "id": 1527433
      },
      "writtenOn": "2026-07-07T23:26:02Z",
      "side": 1,
      "message": "We have not seen any USB4 devices fail to advertise USB4 support at 7.5W or fail to link train at 7.5W.\n\nWe have seen a pre-production USB4 SSD fail to train at 20 Gb/s when the initial contract is 7.5W. I think it\u0027s an open question whether this justifies resetting bus powered USB4 devices.",
      "parentUuid": "b13fb64b_7058f297",
      "range": {
        "startLine": 77,
        "startChar": 3,
        "endLine": 77,
        "endChar": 32
      },
      "revId": "df1aef2a4a9fa00ec07a743442a00263f62aa68a",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
