      "message": "We have definitions for `opcode` and `subcmd` in the `updater.h` file. Let\u0027s use an `enum class` to make these strongly typed. Here is Gemini feedback on how to do this:\n\n-----\n\nYou should absolutely group the `kCmd` and `kSubcmd` constants into strongly-typed `enum class`es.\n\nRight now, your `BuildFtCmd` function takes `(uint8_t opcode, uint8_t subcmd)`. Because they are the same type, the compiler won\u0027t stop you from accidentally swapping them (e.g., `BuildFtCmd(kSubcmdErasePage, kCmdAction)`).\n\nBy making them `enum class`es, you gain compile-time type safety and self-documenting code.\n\nSince we specified `: uint8_t` as the underlying type for both `enum class`es, the C++ standard guarantees they will occupy exactly one byte in memory.\n\nThis means we can use them directly inside the `__attribute__((packed))` struct. It completely eliminates the need for `std::to_underlying`, keeping the code extremely clean and strictly type-safe from top to bottom.\n\nAlso, because these enums define the structural format of the SCSI commands, they actually belong in **`ft_scsi.h`** (alongside `CmdFormat`) rather than in `updater.h`.\n\nHere are the exact changes to implement this:\n\n### 1. Define Enums and Update Struct (`util/focaltech/ft_scsi.h`)\n\nMove the constants from `updater.h`, convert them to enums, and plug them directly into `CmdFormat` and `BuildFtCmd`.\n\n```diff\n--- a/util/focaltech/ft_scsi.h\n+++ b/util/focaltech/ft_scsi.h\n@@ -16,6 +16,22 @@\n \n constexpr size_t kScsiCmdSize \u003d 16;\n \n+enum class Opcode : uint8_t {\n+  kReadInfo \u003d 0xDB,\n+  kAction \u003d 0xDC,\n+};\n+\n+enum class Subcmd : uint8_t {\n+  kReadData \u003d 0x01,\n+  kWriteBin \u003d 0x03,\n+  kCodeBin \u003d 0x04,\n+  kErasePage \u003d 0x08,\n+  kVerify \u003d 0xBB,\n+  kSoftReset \u003d 0xDD,\n+  kFlashWpSet \u003d 0xF7,\n+  kFlashWpGet \u003d 0xF8,\n+};\n+\n struct BulkCbWrap {\n   uint32_t signature;\n   uint32_t tag;\n@@ -38,11 +54,11 @@\n static_assert(sizeof(BulkCsWrap) \u003d\u003d 13, \"USB CSW must be exactly 13 bytes\");\n \n struct CmdFormat {\n-  uint8_t opcode;\n+  Opcode opcode;\n   uint32_t address;\n   uint32_t length;\n   uint32_t aux_address;\n-  uint8_t subcmd;\n+  Subcmd subcmd;\n   uint8_t flags;\n   uint8_t reserved;\n } __attribute__((packed));\n@@ -51,7 +67,7 @@\n \n enum class TransferDirection { kIn, kOut, kSendOnly };\n \n-std::array\u003cuint8_t, kScsiCmdSize\u003e BuildFtCmd(uint8_t opcode, uint8_t subcmd,\n+std::array\u003cuint8_t, kScsiCmdSize\u003e BuildFtCmd(Opcode opcode, Subcmd subcmd,\n                                              uint32_t address \u003d 0,\n                                              uint32_t length \u003d 0,\n                                              uint32_t aux_address \u003d 0,\n\n```\n\n### 2. Simplify Implementation (`util/focaltech/ft_scsi.cc`)\n\nUpdate the function signature. Notice how we assign the enums directly to the struct—no casting required!\n\n```diff\n--- a/util/focaltech/ft_scsi.cc\n+++ b/util/focaltech/ft_scsi.cc\n@@ -82,7 +82,7 @@\n \n }  // namespace\n \n-std::array\u003cuint8_t, kScsiCmdSize\u003e BuildFtCmd(uint8_t opcode, uint8_t subcmd,\n+std::array\u003cuint8_t, kScsiCmdSize\u003e BuildFtCmd(Opcode opcode, Subcmd subcmd,\n                                              uint32_t address, uint32_t length,\n                                              uint32_t aux_address,\n                                              uint8_t flags) {\n\n```\n\n### 3. Clean up `updater.h` (`util/focaltech/updater.h`)\n\nRemove the old flat constants completely.\n\n```diff\n--- a/util/focaltech/updater.h\n+++ b/util/focaltech/updater.h\n@@ -41,18 +41,6 @@\n \n constexpr size_t kFlashWpBufferSize \u003d 512;\n-constexpr uint8_t kCmdReadInfo \u003d 0xDB;\n-constexpr uint8_t kCmdAction \u003d 0xDC;\n-\n-constexpr uint8_t kSubcmdReadData \u003d 0x01;\n-constexpr uint8_t kSubcmdWriteBin \u003d 0x03;\n-constexpr uint8_t kSubcmdCodeBin \u003d 0x04;\n-constexpr uint8_t kSubcmdErasePage \u003d 0x08;\n-constexpr uint8_t kSubcmdVerify \u003d 0xBB;\n-constexpr uint8_t kSubcmdSoftReset \u003d 0xDD;\n-constexpr uint8_t kSubcmdFlashWpSet \u003d 0xF7;\n-constexpr uint8_t kSubcmdFlashWpGet \u003d 0xF8;\n \n constexpr size_t kBootVersionMax \u003d 36;\n\n```\n\n### 4. Update Call Sites in `updater.cc`\n\nReplace the old constants with the new scoped enums.\n\n```diff\n--- a/util/focaltech/updater.cc\n+++ b/util/focaltech/updater.cc\n@@ -69,24 +69,24 @@\n std::expected\u003cvoid, Error\u003e SendActionOut(\n     const UsbDevice\u0026 device, uint8_t subcmd, uint32_t address, // ...\n {\n-  auto cmd \u003d BuildFtCmd(kCmdAction, subcmd, address, length, aux_address, flags);\n+  auto cmd \u003d BuildFtCmd(Opcode::kAction, subcmd, address, length, aux_address, flags);\n   return SendBulkDataOut(device, cmd, data, dir, timeout);\n }\n \n std::expected\u003cvoid, Error\u003e ReceiveActionIn(\n     const UsbDevice\u0026 device, uint8_t subcmd, uint32_t address, // ...\n {\n-  auto cmd \u003d BuildFtCmd(kCmdAction, subcmd, address, length, aux_address, flags);\n+  auto cmd \u003d BuildFtCmd(Opcode::kAction, subcmd, address, length, aux_address, flags);\n   return ReceiveBulkDataIn(device, cmd, data, timeout);\n }\n \n std::expected\u003cvoid, Error\u003e ErasePage(...) {\n   uint32_t pages \u003d DivRoundUp(length, kFocalConfigSize);\n-  return SendActionOut(device, kSubcmdErasePage, addr, {},\n+  return SendActionOut(device, Subcmd::kErasePage, addr, {},\n                        TransferDirection::kOut, kErasePageTimeout, pages);\n }\n \n std::expected\u003cvoid, Error\u003e DownloadPage(...) {\n-  auto res \u003d SendActionOut(device, kSubcmdWriteBin, kWriteSramAddr,\n+  auto res \u003d SendActionOut(device, Subcmd::kWriteBin, kWriteSramAddr,\n                            data.subspan(0, per_len), TransferDirection::kOut,\n                            kDownloadPageTimeout, per_len);\n   if (!res) {\n     FT_LOGE(\"Write bin error\");\n     return res;\n   }\n \n-  res \u003d SendActionOut(device, kSubcmdCodeBin, downaddr, {},\n+  res \u003d SendActionOut(device, Subcmd::kCodeBin, downaddr, {},\n                       TransferDirection::kOut, kDownloadPageTimeout, per_len,\n                       kWriteSramAddr);\n\n```\n\n*(You\u0027ll also apply this to `kSubcmdVerify`, `kSubcmdSoftReset`, `kSubcmdFlashWpGet`, and `kSubcmdFlashWpSet` in their respective functions, and `kCmdReadInfo`/`kSubcmdReadData` in `GetBootVersion`).*\n\n### 5. Update Tests (`ft_scsi_test.cc` \u0026 `updater_test.cc`)\n\nThe struct parsing in your test mocks now elegantly reads the enum directly!\n\n**In `util/focaltech/updater_test.cc`:**\n\n```diff\n--- a/util/focaltech/updater_test.cc\n+++ b/util/focaltech/updater_test.cc\n@@ -78,10 +78,10 @@\n       BulkCbWrap cbw;\n       std::memcpy(\u0026cbw, data.data(), sizeof(cbw));\n \n-      if (cbw.cmd[0] \u003d\u003d kCmdAction) {\n+      if (cbw.cmd[0] \u003d\u003d std::to_underlying(Opcode::kAction)) {\n         auto ft_cmd \u003d std::bit_cast\u003cCmdFormat\u003e(cbw.cmd);\n \n-        if (ft_cmd.subcmd \u003d\u003d kSubcmdErasePage) {\n+        if (ft_cmd.subcmd \u003d\u003d Subcmd::kErasePage) {\n           erased_addresses_.push_back(FromLittleEndian(ft_cmd.address));\n         }\n       }\n\n```\n\n**In `util/focaltech/ft_scsi_test.cc`:**\n\n```diff\n--- a/util/focaltech/ft_scsi_test.cc\n+++ b/util/focaltech/ft_scsi_test.cc\n@@ -37,18 +37,18 @@\n }  // namespace\n \n TEST(FtScsiTest, BuildFtCmd_VerifyFields) {\n-  auto cmd \u003d BuildFtCmd(kCmdAction, kSubcmdErasePage, 0x12345678, 0x1000,\n-                        0x2000, 0x01);\n+  auto cmd \u003d BuildFtCmd(Opcode::kAction, Subcmd::kErasePage, 0x12345678,\n+                        0x1000, 0x2000, 0x01);\n \n-  EXPECT_THAT(cmd, ElementsAre(kCmdAction, 0x78, 0x56, 0x34, 0x12, 0x00, 0x10,\n+  EXPECT_THAT(cmd, ElementsAre(0xDC, 0x78, 0x56, 0x34, 0x12, 0x00, 0x10,\n                                0x00, 0x00, 0x00, 0x20, 0x00, 0x00,\n-                               kSubcmdErasePage, 0x01, 0x00));\n+                               0x08, 0x01, 0x00));\n }\n \n TEST(FtScsiTest, BuildFtCmd_ZeroDefaults) {\n-  auto cmd \u003d BuildFtCmd(kCmdReadInfo, kSubcmdReadData);\n+  auto cmd \u003d BuildFtCmd(Opcode::kReadInfo, Subcmd::kReadData);\n \n-  EXPECT_THAT(cmd, ElementsAre(kCmdReadInfo, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,\n+  EXPECT_THAT(cmd, ElementsAre(0xDB, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,\n                                0x00, 0x00, 0x00, 0x00, 0x00, 0x00,\n-                               kSubcmdReadData, 0x00, 0x00));\n+                               0x01, 0x00, 0x00));\n }\n\n```\n\n*(And simply replace `kCmdAction` with `Opcode::kAction` and `kSubcmdWriteBin` with `Subcmd::kWriteBin` etc. in the rest of the SCSI tests).*",
