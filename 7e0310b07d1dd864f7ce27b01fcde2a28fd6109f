      },
      "writtenOn": "2026-04-24T18:46:50Z",
      "side": 1,
      "message": "This should be moved to zephyr flash driver.",
      "range": {
        "startLine": 262,
        "startChar": 0,
        "endLine": 273,
        "endChar": 2
      },
      "revId": "7e0310b07d1dd864f7ce27b01fcde2a28fd6109f",
