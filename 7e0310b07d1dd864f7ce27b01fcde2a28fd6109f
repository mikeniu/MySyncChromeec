      "writtenOn": "2026-04-24T18:46:50Z",
      "side": 1,
      "message": "Any non-zero value returned here will be recognized as \"protected\" (it\u0027s not even checked in `get_prot_reg()` below). I think we can only return 0 here and leave appropriate comment.",
      "range": {
        "startLine": 79,
        "startChar": 2,
        "endLine": 79,
        "endChar": 32
      },
      "revId": "7e0310b07d1dd864f7ce27b01fcde2a28fd6109f",
