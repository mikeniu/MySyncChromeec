    {
      "unresolved": true,
      "key": {
        "uuid": "33441e10_2c8c4153",
        "filename": "zephyr/drivers/cros_flash/cros_flash_em32f967_wp.h",
        "patchSetId": 15
      },
      "lineNbr": 26,
      "author": {
        "id": 1177449
      },
      "writtenOn": "2026-04-29T08:12:21Z",
      "side": 1,
      "message": "The protection mechanism is strictly range‑based.\n\nOn EM32F967, flash protection is configured only via contiguous protection\nranges using Protect Area registers. There is no sector‑ or bank‑level\nprotection configuration in hardware.\n\nThe `flash_em32_check_bank_protected()` helper does not introduce or emulate\na separate sector‑based protection mechanism. It simply answers whether a\ngiven bank falls within the currently configured protection range, as EC\nflash APIs are bank‑oriented for state reporting and policy decisions.\n\nSo the driver uses a single range‑based protection model, with bank‑based\nqueries only as a representation layer, not as a separate protection type.",
      "parentUuid": "6b529adc_78df77b0",
      "range": {
        "startLine": 26,
        "startChar": 0,
        "endLine": 26,
        "endChar": 53
      },
      "revId": "7e0310b07d1dd864f7ce27b01fcde2a28fd6109f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
