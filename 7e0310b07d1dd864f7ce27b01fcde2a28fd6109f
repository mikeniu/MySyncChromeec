      "key": {
        "uuid": "1698b9ee_fdbdefd0",
        "filename": "zephyr/drivers/cros_flash/cros_flash_em32f967.c",
        "patchSetId": 15
      },
      "lineNbr": 216,
      "author": {
        "id": 1441652
      },
      "writtenOn": "2026-04-24T18:46:50Z",
      "side": 1,
      "message": "What would happen, if we skipped checking if the sector is protected, and proceed with writing?",
      "range": {
        "startLine": 207,
        "startChar": 0,
        "endLine": 216,
        "endChar": 2
      },
      "revId": "7e0310b07d1dd864f7ce27b01fcde2a28fd6109f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "6a4d683b_1b20cf72",
        "filename": "zephyr/drivers/cros_flash/cros_flash_em32f967.c",
        "patchSetId": 15
      },
      "lineNbr": 216,
      "author": {
        "id": 1177449
      },
      "writtenOn": "2026-04-29T08:12:21Z",
      "side": 1,
      "message": "The result would be non‑deterministic and hardware‑dependent.  \nWrites to protected regions may be silently ignored, partially applied,\nor fail inconsistently, which breaks EC API expectations.  \nWe therefore enforce protection checks in the driver to keep behavior\ndeterministic and policy‑controlled.",
      "parentUuid": "1698b9ee_fdbdefd0",
      "range": {
        "startLine": 207,
        "startChar": 0,
        "endLine": 216,
        "endChar": 2
      },
      "revId": "7e0310b07d1dd864f7ce27b01fcde2a28fd6109f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
    },
