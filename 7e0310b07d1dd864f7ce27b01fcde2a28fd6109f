    {
      "unresolved": true,
      "key": {
        "uuid": "02c440e0_a17ab704",
        "filename": "zephyr/drivers/cros_flash/cros_flash_em32f967.c",
        "patchSetId": 15
      },
      "lineNbr": 79,
