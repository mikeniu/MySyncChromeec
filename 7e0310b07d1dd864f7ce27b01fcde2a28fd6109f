      "writtenOn": "2026-04-24T18:46:50Z",
      "side": 1,
      "message": "Is the protection range-based or sector-based? I guess your flash protection is range-based.\n\nI would not emulate the other type of protection mechanism. Mixing both in one driver causes confusion.",
      "range": {
        "startLine": 26,
        "startChar": 0,
        "endLine": 26,
        "endChar": 53
      },
      "revId": "7e0310b07d1dd864f7ce27b01fcde2a28fd6109f",
      "serverId": "3ce6091f-6c88-37e8-8c75-72f92ae8dfba"
