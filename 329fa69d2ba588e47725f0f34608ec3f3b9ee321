      "message": "Gemini generated fix. Check for correctness:\n\n----\n\n### 1. `util/focaltech/ft_scsi.h`\n\nReplace the single `SendBulkCommand` declaration with two explicit, strictly typed functions.\n\n```cpp\n#ifndef UTIL_FOCALTECH_FT_SCSI_H_\n#define UTIL_FOCALTECH_FT_SCSI_H_\n\n#include \u003carray\u003e\n#include \u003cchrono\u003e\n#include \u003ccstdint\u003e\n#include \u003ccstring\u003e\n#include \u003cexpected\u003e\n#include \u003cspan\u003e\n\n#include \"usb_context.h\"\n\nstd::array\u003cuint8_t, 16\u003e BuildFtCmd(uint8_t opcode, uint8_t subcmd,\n                                   uint32_t address \u003d 0, uint32_t length \u003d 0,\n                                   uint32_t aux_address \u003d 0, uint8_t flags \u003d 0);\n\n// For sending data TO the device (Data buffer is const)\nstd::expected\u003cvoid, FtError\u003e SendBulkDataOut(\n    const UsbDevice\u0026 device, std::span\u003cconst uint8_t\u003e scsi_cmd,\n    std::span\u003cconst uint8_t\u003e data_buffer, TransferDirection dir,\n    std::chrono::milliseconds timeout_ms);\n\n// For receiving data FROM the device (Data buffer is mutable)\nstd::expected\u003cvoid, FtError\u003e ReceiveBulkDataIn(\n    const UsbDevice\u0026 device, std::span\u003cconst uint8_t\u003e scsi_cmd,\n    std::span\u003cuint8_t\u003e data_buffer, std::chrono::milliseconds timeout_ms);\n\n#endif  // UTIL_FOCALTECH_FT_SCSI_H_\n\n```\n\n---\n\n### 2. `util/focaltech/ft_scsi.cc`\n\nReplace everything below your includes with this modernized block. It uses designated initializers, `std::bit_cast`, and the private helpers to route the new public functions safely.\n\n```cpp\n#include \u003cbit\u003e // Required for std::bit_cast\n\nnamespace {\n\nconstexpr uint32_t kUsbMsCbwSignature \u003d 0x43425355;\nconstexpr uint32_t kUsbMsCswSignature \u003d 0x53425355;\n\nstruct BulkCbWrap {\n  uint32_t signature;\n  uint32_t tag;\n  uint32_t data_transfer_length;\n  uint8_t flags;\n  uint8_t lun;\n  uint8_t cmd_len;\n  uint8_t cmd[16];\n} __attribute__((packed));\n\nstruct BulkCsWrap {\n  uint32_t signature;\n  uint32_t tag;\n  uint32_t data_residue;\n  uint8_t status;\n} __attribute__((packed));\n\nstruct FtCmdFormat {\n  uint8_t opcode;\n  uint32_t address;\n  uint32_t length;\n  uint32_t aux_address;\n  uint8_t subcmd;\n  uint8_t flags;\n  uint8_t reserved;\n} __attribute__((packed));\n\nstd::expected\u003cBulkCbWrap, FtError\u003e SendCbw(\n    const UsbDevice\u0026 device, std::span\u003cconst uint8_t\u003e scsi_cmd,\n    size_t data_length, TransferDirection dir,\n    std::chrono::milliseconds timeout_ms) {\n  BulkCbWrap cbw{\n      .signature \u003d htole32(kUsbMsCbwSignature),\n      .tag \u003d htole32(device.GetNextCdbTag()), // Using atomic thread-safe tag\n      .data_transfer_length \u003d htole32(data_length),\n      .flags \u003d static_cast\u003cuint8_t\u003e((dir \u003d\u003d TransferDirection::kIn) ? 0x80 : 0x00),\n      .lun \u003d 0,\n      .cmd_len \u003d static_cast\u003cuint8_t\u003e(scsi_cmd.size()),\n  };\n  std::memcpy(cbw.cmd, scsi_cmd.data(), scsi_cmd.size());\n\n  auto cbw_span \u003d std::span\u003cconst uint8_t\u003e(\n      reinterpret_cast\u003cconst uint8_t*\u003e(\u0026cbw), sizeof(cbw));\n  auto send_res \u003d device.Send(cbw_span, timeout_ms.count());\n\n  if (!send_res || *send_res !\u003d sizeof(cbw)) {\n    LOGE(\"CBW transfer failed.\");\n    return std::unexpected(FtError::kResultFail);\n  }\n  return cbw;\n}\n\nstd::expected\u003cvoid, FtError\u003e ReceiveAndValidateCsw(\n    const UsbDevice\u0026 device, const BulkCbWrap\u0026 cbw,\n    std::chrono::milliseconds timeout_ms) {\n  BulkCsWrap csw{};\n  auto csw_span \u003d\n      std::span\u003cuint8_t\u003e(reinterpret_cast\u003cuint8_t*\u003e(\u0026csw), sizeof(csw));\n  auto recv_res \u003d device.Recv(csw_span, timeout_ms.count());\n\n  if (!recv_res || *recv_res !\u003d sizeof(csw)) {\n    LOGE(\"CSW transfer failed.\");\n    return std::unexpected(FtError::kResultFail);\n  }\n\n  if (le32toh(csw.signature) !\u003d kUsbMsCswSignature ||\n      le32toh(csw.tag) !\u003d le32toh(cbw.tag)) {\n    LOGE(\"CSW signature/tag mismatch.\");\n    return std::unexpected(FtError::kResultFail);\n  }\n\n  if (csw.status !\u003d 0x00) {\n    LOGW(\"Command failed with CSW status: {:02x}\", csw.status);\n    return std::unexpected(FtError::kResultFail);\n  }\n  return {};\n}\n\n}  // namespace\n\nstd::array\u003cuint8_t, 16\u003e BuildFtCmd(uint8_t opcode, uint8_t subcmd,\n                                   uint32_t address, uint32_t length,\n                                   uint32_t aux_address, uint8_t flags) {\n  FtCmdFormat cmd{\n      .opcode \u003d opcode,\n      .address \u003d address,\n      .length \u003d length,\n      .aux_address \u003d aux_address,\n      .subcmd \u003d subcmd,\n      .flags \u003d flags,\n      .reserved \u003d 0,\n  };\n  return std::bit_cast\u003cstd::array\u003cuint8_t, 16\u003e\u003e(cmd);\n}\n\nstd::expected\u003cvoid, FtError\u003e SendBulkDataOut(\n    const UsbDevice\u0026 device, std::span\u003cconst uint8_t\u003e scsi_cmd,\n    std::span\u003cconst uint8_t\u003e data_buffer, TransferDirection dir,\n    std::chrono::milliseconds timeout_ms) {\n  auto cbw_res \u003d SendCbw(device, scsi_cmd, data_buffer.size(), dir, timeout_ms);\n  if (!cbw_res) return std::unexpected(cbw_res.error());\n\n  if (dir \u003d\u003d TransferDirection::kSendOnly) {\n    if (device.ResetComplete(3)) return std::unexpected(FtError::kResultFail);\n    return {};\n  }\n\n  if (!data_buffer.empty()) {\n    auto send_res \u003d device.Send(data_buffer, timeout_ms.count());\n    if (!send_res || *send_res !\u003d static_cast\u003cint\u003e(data_buffer.size())) {\n      LOGE(\"Data OUT transfer failed.\");\n      return std::unexpected(FtError::kResultFail);\n    }\n  }\n\n  return ReceiveAndValidateCsw(device, *cbw_res, timeout_ms);\n}\n\nstd::expected\u003cvoid, FtError\u003e ReceiveBulkDataIn(\n    const UsbDevice\u0026 device, std::span\u003cconst uint8_t\u003e scsi_cmd,\n    std::span\u003cuint8_t\u003e data_buffer, std::chrono::milliseconds timeout_ms) {\n  auto cbw_res \u003d SendCbw(device, scsi_cmd, data_buffer.size(),\n                         TransferDirection::kIn, timeout_ms);\n  if (!cbw_res) return std::unexpected(cbw_res.error());\n\n  if (!data_buffer.empty()) {\n    auto recv_res \u003d device.Recv(data_buffer, timeout_ms.count());\n    if (!recv_res) {\n      LOGE(\"Data IN transfer failed.\");\n      return std::unexpected(recv_res.error());\n    }\n  }\n\n  return ReceiveAndValidateCsw(device, *cbw_res, timeout_ms);\n}\n\n```\n\n---\n\n### 3. `util/focaltech/updater.cc`\n\nFirst, replace your single `SendAction` function with the two split versions:\n\n```cpp\n// For sending data to the MCU\nstd::expected\u003cvoid, FtError\u003e SendActionOut(\n    const UsbDevice\u0026 device, uint8_t subcmd, uint32_t address,\n    std::span\u003cconst uint8_t\u003e data, TransferDirection dir,\n    std::chrono::milliseconds timeout, uint32_t length \u003d 0,\n    uint32_t aux_address \u003d 0, uint8_t flags \u003d 0) {\n  auto cmd \u003d\n      BuildFtCmd(kFtCmdAction, subcmd, address, length, aux_address, flags);\n  return SendBulkDataOut(device, cmd, data, dir, timeout);\n}\n\n// For reading data from the MCU\nstd::expected\u003cvoid, FtError\u003e ReceiveActionIn(\n    const UsbDevice\u0026 device, uint8_t subcmd, uint32_t address,\n    std::span\u003cuint8_t\u003e data, std::chrono::milliseconds timeout,\n    uint32_t length \u003d 0, uint32_t aux_address \u003d 0, uint8_t flags \u003d 0) {\n  auto cmd \u003d\n      BuildFtCmd(kFtCmdAction, subcmd, address, length, aux_address, flags);\n  return ReceiveBulkDataIn(device, cmd, data, timeout);\n}\n\n```\n\nThen, update the actual function calls throughout the rest of `updater.cc`:\n\n**In `FtErasePage`:**\n\n```cpp\n  return SendActionOut(device, kFtSubcmdErasePage, addr, {},\n                       TransferDirection::kOut, kErasePageTimeout, pages);\n\n```\n\n**In `FtDownloadPage` (The critical `const_cast` removal):**\n\n```cpp\n  // Write data to SRAM\n  auto res \u003d SendActionOut(\n      device, kFtSubcmdWriteBin, kFtWriteSramAddr,\n      data.subspan(0, per_len), // Clean and type-safe! No const_cast.\n      TransferDirection::kOut, kDownloadPageTimeout, per_len);\n  if (!res) {\n    LOGE(\"Write bin error\");\n    return res;\n  }\n\n  // Execute code\n  res \u003d SendActionOut(device, kFtSubcmdCodeBin, downaddr, {},\n                      TransferDirection::kOut, kDownloadPageTimeout, per_len,\n                      kFtWriteSramAddr);\n\n```\n\n**In `FtVerifyData`:**\n\n```cpp\n  auto io_res \u003d ReceiveActionIn(\n      device, kFtSubcmdVerify, target_addr, device_hash,\n      kVerifyHashTimeout, firmware_data.size(), 0, hash_mode);\n\n```\n\n**In `FtMcuReset`:**\n\n```cpp\n  return SendActionOut(device, kFtSubcmdSoftReset, 0, {},\n                       TransferDirection::kSendOnly, kMcuResetTimeout, 0, 0,\n                       kSoftPor);\n\n```\n\n**In `FtGetFlashProtect`:**\n\n```cpp\n  auto res \u003d ReceiveActionIn(device, kFtSubcmdFlashWpGet, 0, data,\n                             kGenericInfoTimeout);\n\n```\n\n**In `FtSetFlashProtect`:**\n\n```cpp\n  auto res \u003d ReceiveActionIn(\n      device, kFtSubcmdFlashWpSet, static_cast\u003cuint32_t\u003e(wp_area), dummy,\n      kGenericInfoTimeout, ~static_cast\u003cuint32_t\u003e(wp_area));\n\n```",
